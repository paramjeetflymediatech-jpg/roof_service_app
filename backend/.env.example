PORT=5000
NODE_ENV=development

# MySQL Database Configuration (Required for production)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=roof_service
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here

# MongoDB Configuration (Legacy - for reference only)
