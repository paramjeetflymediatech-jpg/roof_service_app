<%- include('../../partials/header') %>
<body <% if (error && error.length > 0) { %>data-flash-error="<%= error %>"<% } %> <% if (success && success.length > 0) { %>data-flash-success="<%= success %>"<% } %>>
    <div id="toast-container"></div>
    <div class="admin-wrapper text-black">
        <%- include('../../partials/sidebar') %>
        <main class="main-content">
            <%- include('../../partials/top-header') %>
            <div class="content">
                <div class="page-header">
                    <div class="header-content">
                        <h1>Add Service Location</h1>
                        <p>Map a service to a specific location with override content</p>
                    </div>
                </div>
                <div class="form-card bg-white rounded-lg shadow p-6">
                    <form action="/admin/location-services" method="POST" class="space-y-6">
                        <!-- Dropdowns in grid -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="form-group flex flex-col">
                                <label for="locationId" class="form-label font-semibold text-gray-700 mb-2">Location <span class="text-red-500">*</span></label>
                                <select id="locationId" name="locationId" required class="form-input p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 bg-white">
                                    <option value="">Select Location</option>
                                    <% locations.forEach(location => { %>
                                        <option value="<%= location.id %>"><%= location.name %></option>
                                    <% }); %>
                                </select>
                            </div>

                            <div class="form-group flex flex-col">
                                <label for="serviceId" class="form-label font-semibold text-gray-700 mb-2">Service <span class="text-red-500">*</span></label>
                                <select id="serviceId" name="serviceId" required class="form-input p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 bg-white">
                                    <option value="">Select Service</option>
                                    <% services.forEach(service => { %>
                                        <option value="<%= service.id %>"><%= service.name %></option>
                                    <% }); %>
                                </select>
                            </div>
                        </div>

                        <!-- Basic Content Overrides -->
                        <div class="border-t border-gray-100 pt-6">
                            <h3 class="text-lg font-bold text-gray-800 mb-4">Content Overrides</h3>
                            
                            <div class="form-group flex flex-col mb-4">
                                <label for="name" class="form-label font-semibold text-gray-700 mb-2">Override Name (e.g. "Roof Repair in Surrey")</label>
                                <input type="text" id="name" name="name" class="form-input p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="Leave blank to use default service name">
                            </div>

                            <div class="form-group flex flex-col mb-4">
                                <label for="shortDescription" class="form-label font-semibold text-gray-700 mb-2">Short Description Override</label>
                                <textarea id="shortDescription" name="shortDescription" rows="2" class="form-input p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="Brief summary of service for this location..."></textarea>
                            </div>

                            <div class="form-group flex flex-col mb-4">
                                 <label for="longDescription" class="form-label font-semibold text-gray-700 mb-2">Service Content Override</label>
                                 <textarea id="longDescription" name="longDescription" rows="8" class="form-input p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="Enter custom service content here..."></textarea>
                            </div>

                            <div class="form-group flex flex-col mb-4">
                                <label for="whyChooseUs" class="form-label font-semibold text-gray-700 mb-2">Why Choose Us / FAQ Override (One item per line)</label>
                                <textarea id="whyChooseUs" name="whyChooseUs" rows="4" class="form-input p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="Expert Local Roofing Specialists&#10;Emergency Callouts 24/7&#10;Fully Insured & Certified"></textarea>
                            </div>
                        </div>

                        <!-- SEO and Meta Settings Override -->
                        <div class="border-t border-gray-100 pt-6">
                            <h3 class="text-lg font-bold text-gray-800 mb-4">SEO & Metadata Overrides</h3>
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-4">
                                <div class="form-group flex flex-col">
                                    <label for="pageTitle" class="form-label font-semibold text-gray-700 mb-2">Page Title</label>
                                    <input type="text" id="pageTitle" name="pageTitle" class="form-input p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="e.g. Roof Repair Surrey | Mainstreet Roofing">
                                </div>

                                <div class="form-group flex flex-col">
                                    <label for="canonicalUrl" class="form-label font-semibold text-gray-700 mb-2">Canonical URL</label>
                                    <input type="text" id="canonicalUrl" name="canonicalUrl" class="form-input p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="e.g. https://mainstreetroofing.ca/services/roof-repairs-in-surrey">
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-4">
                                <div class="form-group flex flex-col">
                                    <label for="keywords" class="form-label font-semibold text-gray-700 mb-2">Keywords (Comma separated)</label>
                                    <input type="text" id="keywords" name="keywords" class="form-input p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="e.g. roof repair, surrey roofing, local roofers">
                                </div>

                                <div class="form-group flex flex-col">
                                    <label for="metaRobots" class="form-label font-semibold text-gray-700 mb-2">Meta Robots</label>
                                    <input type="text" id="metaRobots" name="metaRobots" value="index, follow" class="form-input p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                            </div>

                            <div class="form-group flex flex-col mb-4">
                                <label for="metaDescription" class="form-label font-semibold text-gray-700 mb-2">Meta Description</label>
                                <textarea id="metaDescription" name="metaDescription" rows="2" class="form-input p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="Brief metadata description for search engine results..."></textarea>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-4">
                                <div class="form-group flex flex-col">
                                    <label for="ogTitle" class="form-label font-semibold text-gray-700 mb-2">OpenGraph Title</label>
                                    <input type="text" id="ogTitle" name="ogTitle" class="form-input p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>

                                <div class="form-group flex flex-col">
                                    <label for="ogDescription" class="form-label font-semibold text-gray-700 mb-2">OpenGraph Description</label>
                                    <input type="text" id="ogDescription" name="ogDescription" class="form-input p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                            </div>

                            <div class="form-group flex flex-col mb-4">
                                <label for="schemaMarkup" class="form-label font-semibold text-gray-700 mb-2">Schema Markup (Structured JSON-LD)</label>
                                <textarea id="schemaMarkup" name="schemaMarkup" rows="4" class="form-input json-input p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 font-mono text-sm" placeholder="Paste schema markup JSON here..."></textarea>
                                <p id="schemaMarkup-error" class="text-xs text-red-500 mt-1 hidden">Invalid JSON format</p>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-4">
                                <div class="form-group flex flex-col">
                                    <label for="googleAnalyticsId" class="form-label font-semibold text-gray-700 mb-2">Google Analytics ID</label>
                                    <input type="text" id="googleAnalyticsId" name="googleAnalyticsId" class="form-input p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="UA-XXXXX-Y or G-XXXXXXX">
                                </div>

                                <div class="form-group flex flex-col">
                                    <label for="googleTagManagerId" class="form-label font-semibold text-gray-700 mb-2">Google Tag Manager ID</label>
                                    <input type="text" id="googleTagManagerId" name="googleTagManagerId" class="form-input p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="GTM-XXXXXXX">
                                </div>
                            </div>
                        </div>

                        <!-- Form submission buttons -->
                        <div class="form-buttons flex gap-4 border-t border-gray-100 pt-6">
                            <button type="submit" class="px-5 py-2.5 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition">Create Service Location</button>
                            <a href="/admin/location-services" class="px-5 py-2.5 bg-gray-200 text-gray-700 font-semibold rounded-lg hover:bg-gray-300 transition">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
    <style>
        .ck-editor__editable_inline {
            min-height: 300px;
            border-bottom-left-radius: 0.5rem !important;
            border-bottom-right-radius: 0.5rem !important;
        }
        .ck-editor__top {
            border-top-left-radius: 0.5rem !important;
            border-top-right-radius: 0.5rem !important;
        }
        .ck.ck-editor {
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            border-radius: 0.5rem;
            margin-top: 0.5rem;
        }
        .ck.ck-editor__editable:not(.ck-editor__nested-editable).ck-focused {
            border-color: #6366f1 !important;
            box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2) !important;
        }
    </style>
    <script src="/js/toast.js"></script>
    <script>
        let editorInstance = null;

        window.addEventListener('DOMContentLoaded', () => {
            ClassicEditor.create(document.getElementById('longDescription'), {
                toolbar: [
                    'heading', '|', 'bold', 'italic', 'link', 'bulletedList', 'numberedList', 
                    'blockQuote', 'insertTable', 'undo', 'redo'
                ]
            }).then(editor => {
                editorInstance = editor;
            }).catch(error => {
                console.error("CKEditor initialization failed:", error);
            });
        });

        const mainForm = document.querySelector('form');
        if (mainForm) {
            mainForm.addEventListener('submit', () => {
                if (editorInstance) {
                    document.getElementById('longDescription').value = editorInstance.getData();
                }
            });
        }

        function validateJson(el, errorEl) {
            const val = el.value.trim();
            if (val.startsWith('[') || val.startsWith('{')) {
                try {
                    JSON.parse(val);
                    errorEl.classList.add('hidden');
                    el.classList.remove('border-red-500');
                } catch (e) {
                    errorEl.classList.remove('hidden');
                    el.classList.add('border-red-500');
                }
            } else {
                errorEl.classList.add('hidden');
                el.classList.remove('border-red-500');
            }
        }

        document.querySelectorAll('.json-input').forEach(el => {
            const errorEl = document.getElementById(el.id + '-error');
            el.addEventListener('input', () => validateJson(el, errorEl));
        });
    </script>
</body>
</html>
