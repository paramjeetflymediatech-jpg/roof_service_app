<% if (locationServices && locationServices.length > 0) { %>
    <% locationServices.forEach(mapping => { %>
        <tr>
            <td>
                <% if (mapping.location) { %>
                    <strong><%= mapping.location.name %></strong>
                    <br><code class="text-xs text-gray-500"><%= mapping.location.slug %></code>
                <% } else { %>
                    <span class="text-red-500 font-semibold">Unknown Location (<%= mapping.locationId %>)</span>
                <% } %>
            </td>
            <td>
                <% if (mapping.service) { %>
                    <strong><%= mapping.service.name %></strong>
                    <br><code class="text-xs text-gray-500"><%= mapping.service.slug %></code>
                <% } else { %>
                    <span class="text-red-500 font-semibold">Unknown Service (<%= mapping.serviceId %>)</span>
                <% } %>
            </td>
            <td>
                <span class="font-medium text-gray-900"><%= mapping.name || '-' %></span>
            </td>
            <td>
                <%= mapping.shortDescription ? mapping.shortDescription.substring(0, 50) + (mapping.shortDescription.length > 50 ? '...' : '') : '-' %>
            </td>
            <td>
                <div class="flex gap-2">
                    <a href="/admin/location-services/<%= mapping.locationId %>/<%= mapping.serviceId %>/edit" class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-lg transition" title="Edit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                        </svg>
                    </a>
                    <button type="button" onclick="confirmDelete('<%= mapping.locationId %>', '<%= mapping.serviceId %>')" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition" title="Delete">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                    </button>
                </div>
            </td>
        </tr>
    <% }) %>
<% } else { %>
    <tr><td colspan="5" class="text-center text-gray-500 py-4">No service locations found</td></tr>
<% } %>
