<%- include('../../partials/header') %>
<body <% if (error && error.length > 0) { %>data-flash-error="<%= error %>"<% } %> <% if (success && success.length > 0) { %>data-flash-success="<%= success %>"<% } %>>
    <div id="toast-container"></div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="modal">
        <div class="bg-white rounded-lg p-6 max-w-md w-full mx-4">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Confirm Delete Mapping</h3>
            <p class="text-gray-600 mb-6">Are you sure you want to delete this service location mapping? This action cannot be undone.</p>
            <div class="flex gap-4 justify-end">
                <button onclick="closeDeleteModal()" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition">Cancel</button>
                <form id="deleteForm" method="POST" class="inline">
                    <button type="submit" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition">Delete</button>
                </form>
            </div>
        </div>
    </div>

    <div class="admin-wrapper">
        <%- include('../../partials/sidebar') %>
        <main class="main-content">
            <%- include('../../partials/top-header') %>

            <div class="content">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
                    <div class="flex flex-col md:flex-row gap-3">
                        <a href="/admin/location-services/create" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                            Add Service Location
                        </a>
                    </div>

                    <div class="flex flex-col md:flex-row gap-3">
                        <!-- Search Form -->
                        <form id="searchForm" action="/admin/location-services" method="GET" class="flex flex-col md:flex-row gap-3">
                            <div class="relative flex-1 md:w-64">
                                <input type="text" name="search" id="searchInput" 
                                    value="<%= typeof query !== 'undefined' ? query.search || '' : '' %>"
                                    placeholder="Search service locations..." 
                                    class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 outline-none transition shadow-sm bg-white text-black">
                                <div class="absolute left-3 top-2.5 text-gray-400">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                </div>
                            </div>
                            <a href="/admin/location-services" class="clear-btn px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition text-sm font-medium flex items-center justify-center">Clear</a>
                        </form>
                    </div>
                </div>

                <!-- Desktop Table View -->
                <div class="table-container text-black">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Location</th>
                                <th>Service</th>
                                <th>Override Name</th>
                                <th>Short Description</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="listTableBody">
                            <%- include('./_table_rows') %>
                        </tbody>
                    </table>
                </div>
                <div id="paginationContainer">
                    <%- include('./_pagination') %>
                </div>

                <!-- Total Count -->
                <div class="mt-4 text-sm text-gray-600">
                    Showing <%= locationServices.length %> of <%= totalItems %> service locations
                </div>

                <!-- Hidden Card Container for AJAX script compatibility -->
                <div id="listCardContainer" class="hidden"></div>
            </div>
        </main>
    </div>

    <script src="/js/toast.js"></script>
    <script src="/js/list-ajax.js"></script>
    <script>
        function confirmDelete(locationId, serviceId) {
            const modal = document.getElementById('deleteModal');
            const form = document.getElementById('deleteForm');
            form.action = `/admin/location-services/${locationId}/${serviceId}/delete`;
            modal.classList.add('show');
        }
        function closeDeleteModal() { document.getElementById('deleteModal').classList.remove('show'); }
        document.getElementById('deleteModal').addEventListener('click', function(e) { if (e.target === this) closeDeleteModal(); });
    </script>
</body>
</html>
