<% if (jobs.length === 0) { %>
    <tr>
        <td colspan="6" class="px-6 py-12 text-center text-gray-500">
            <div class="flex flex-col items-center">
                <svg class="w-12 h-12 text-gray-200 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                </svg>
                <p>No jobs found.</p>
            </div>
        </td>
    </tr>
<% } else { %>
    <% jobs.forEach(job => { %>
        <tr class="hover:bg-gray-50/50 transition-colors">
            <td class="px-6 py-4">
                <span class="font-medium text-gray-900">#<%= job.id %></span>
            </td>
            <td class="px-6 py-4">
                <div class="flex flex-col">
                    <span class="font-bold text-gray-800"><%= job.lead ? job.lead.name : 'N/A' %></span>
                    <span class="text-xs text-gray-500"><%= job.lead ? job.lead.phone : 'N/A' %></span>
                </div>
            </td>
            <td class="px-6 py-4">
                <% if (job.employee) { %>
                    <div class="flex items-center">
                        <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-xs mr-3">
                            <%= job.employee.name.split(' ').map(n => n[0]).join('').toUpperCase() %>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-sm font-medium text-gray-800"><%= job.employee.name %></span>
                            <span class="text-xs text-gray-500">Employee</span>
                        </div>
                    </div>
                <% } else { %>
                    <span class="text-sm text-gray-400">Unassigned</span>
                <% } %>
            </td>
            <td class="px-6 py-4">
                <% 
                    let statusClass = "bg-gray-100 text-gray-600";
                    if (job.status === 'completed') statusClass = "bg-green-100 text-green-600";
                    if (job.status === 'in_progress') statusClass = "bg-blue-100 text-blue-600";
                    if (job.status === 'pending') statusClass = "bg-yellow-100 text-yellow-600";
                    if (job.status === 'cancelled') statusClass = "bg-red-100 text-red-600";
                %>
                <span class="px-3 py-1 rounded-full text-xs font-bold <%= statusClass %>">
                    <%= job.status.toUpperCase().replace('_', ' ') %>
                </span>
            </td>
            <td class="px-6 py-4">
                <span class="text-sm text-gray-600">
                    <%= job.scheduledDate ? new Date(job.scheduledDate).toLocaleDateString("en-GB") : 'Not set' %>
                </span>
            </td>
            <td class="px-6 py-4 text-right">
                <div class="flex justify-end gap-2">
                    <a href="/admin/jobs/<%= job.id %>" class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg transition" title="View Details">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                    </a>
                    <form action="/admin/jobs/<%= job.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this job? This action cannot be undone.');">
                        <button type="submit" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition" title="Delete Job">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
                        </button>
                    </form>
                </div>
            </td>
        </tr>
    <% }); %>
<% } %>
