<%- include('../../partials/header') %>

<body <% if (typeof error !=='undefined' && error && error.length> 0) { %>data-flash-error="<%= error %>"<% } %>
    <% if (typeof success !=='undefined' && success && success.length> 0) { %>data-flash-success="<%= success %>"<% } %>>

    <!-- Toast Container -->
    <div id="toast-container"></div>

    <div class="admin-wrapper">
        <%- include('../../partials/sidebar') %>

        <main class="main-content">
            <%- include('../../partials/top-header') %>

            <div class="content">
                <div class="max-w-5xl mx-auto">
                    <!-- Back Button -->
                    <div class="mb-6 flex justify-between items-center">
                        <a href="/admin/jobs" class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium transition gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="19" y1="12" x2="5" y2="12"></line>
                                <polyline points="12 19 5 12 12 5"></polyline>
                            </svg>
                            Back to Job List
                        </a>

                        <form action="/admin/jobs/<%= job.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this job?');">
                            <button type="submit" class="px-4 py-2 border border-red-200 text-red-600 rounded-lg hover:bg-red-50 transition flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                </svg>
                                Delete Job
                            </button>
                        </form>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                        <!-- Main Content -->
                        <div class="lg:col-span-2 space-y-8">
                            <!-- Basic Info Card -->
                            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                                <div class="px-8 py-6 border-b border-gray-50 bg-gray-50/50 flex justify-between items-center">
                                    <div>
                                        <h2 class="text-xl font-bold text-gray-900 text-uppercase tracking-wide">Job #<%= job.id %></h2>
                                        <p class="text-sm text-gray-500">Created on <%= new Date(job.createdAt).toLocaleDateString() %></p>
                                    </div>
                                    <% 
                                        let statusClass = "bg-gray-100 text-gray-600";
                                        if (job.status === 'completed') statusClass = "bg-green-100 text-green-600";
                                        if (job.status === 'in_progress') statusClass = "bg-blue-100 text-blue-600";
                                        if (job.status === 'pending') statusClass = "bg-yellow-100 text-yellow-600";
                                        if (job.status === 'cancelled') statusClass = "bg-red-100 text-red-600";
                                    %>
                                    <span class="px-4 py-1.5 rounded-full text-xs font-bold <%= statusClass %>">
                                        <%= job.status.toUpperCase().replace('_', ' ') %>
                                    </span>
                                </div>
                                <div class="p-8">
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
                                        <div>
                                            <label class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2 block">Scheduled Date</label>
                                            <p class="text-gray-900 font-medium">
                                                <%= job.scheduledDate ? new Date(job.scheduledDate).toLocaleDateString() : 'Not scheduled' %>
                                            </p>
                                        </div>
                                        <div>
                                            <label class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2 block">Time Slot</label>
                                            <p class="text-gray-900 font-medium capitalize">
                                                <%= job.timeSlot || 'Any' %>
                                            </p>
                                        </div>
                                        <div class="sm:col-span-2">
                                            <label class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2 block">Notes</label>
                                            <p class="text-gray-700 whitespace-pre-wrap"><%= job.notes || 'No notes provided.' %></p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Lead & Client Card -->
                            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
                                <h3 class="text-lg font-bold text-gray-900 mb-6 flex items-center gap-2">
                                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                    </svg>
                                    Lead & Client Information
                                </h3>
                                <% if (job.lead) { %>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                                        <div>
                                            <p class="text-xs text-gray-400 uppercase font-bold mb-1">Name</p>
                                            <p class="font-bold text-gray-900"><%= job.lead.name %></p>
                                        </div>
                                        <div>
                                            <p class="text-xs text-gray-400 uppercase font-bold mb-1">Phone</p>
                                            <p class="text-gray-900"><%= job.lead.phone %></p>
                                        </div>
                                        <div>
                                            <p class="text-xs text-gray-400 uppercase font-bold mb-1">Service</p>
                                            <p class="text-gray-900 font-medium"><%= job.lead.service ? job.lead.service.name : job.lead.serviceType %></p>
                                        </div>
                                        <div class="sm:col-span-2">
                                            <p class="text-xs text-gray-400 uppercase font-bold mb-1">Address</p>
                                            <p class="text-gray-900"><%= job.lead.address %></p>
                                        </div>
                                    </div>
                                <% } else { %>
                                    <p class="text-gray-500 italic">Lead information missing.</p>
                                <% } %>
                            </div>

                            <!-- Images Section -->
                            <div class="space-y-6">
                                <% if (job.beforeImages || job.afterImages) { %>
                                    <h3 class="text-lg font-bold text-gray-900 px-2">Job Photos</h3>
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                        <!-- Before Images -->
                                        <% if (job.beforeImages) { %>
                                            <% 
                                                let before = [];
                                                try { before = Array.isArray(job.beforeImages) ? job.beforeImages : JSON.parse(job.beforeImages); } catch(e) {}
                                            %>
                                            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                                                <h4 class="text-sm font-bold text-gray-500 uppercase tracking-widest mb-4">Before Photos</h4>
                                                <div class="grid grid-cols-2 gap-3">
                                                    <% before.forEach(img => { %>
                                                        <a href="<%= img.url %>" target="_blank" class="block aspect-square rounded-xl overflow-hidden border border-gray-100 hover:shadow-md transition">
                                                            <img src="<%= img.url %>" class="w-full h-full object-cover">
                                                        </a>
                                                    <% }); %>
                                                </div>
                                            </div>
                                        <% } %>

                                        <!-- After Images -->
                                        <% if (job.afterImages) { %>
                                            <% 
                                                let after = [];
                                                try { after = Array.isArray(job.afterImages) ? job.afterImages : JSON.parse(job.afterImages); } catch(e) {}
                                            %>
                                            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                                                <h4 class="text-sm font-bold text-gray-500 uppercase tracking-widest mb-4">After Photos</h4>
                                                <div class="grid grid-cols-2 gap-3">
                                                    <% after.forEach(img => { %>
                                                        <a href="<%= img.url %>" target="_blank" class="block aspect-square rounded-xl overflow-hidden border border-gray-100 hover:shadow-md transition">
                                                            <img src="<%= img.url %>" class="w-full h-full object-cover">
                                                        </a>
                                                    <% }); %>
                                                </div>
                                            </div>
                                        <% } %>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Sidebar Info -->
                        <div class="space-y-8">
                            <!-- Employee Card -->
                            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                                <h3 class="text-md font-bold text-gray-900 mb-4">Assigned Personnel</h3>
                                <% if (job.employee) { %>
                                    <div class="flex items-center gap-4 mb-6">
                                        <div class="w-12 h-12 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-lg">
                                            <%= job.employee.name.split(' ').map(n => n[0]).join('').toUpperCase() %>
                                        </div>
                                        <div>
                                            <p class="font-bold text-gray-900 leading-tight"><%= job.employee.name %></p>
                                            <p class="text-xs text-gray-500">Service Professional</p>
                                        </div>
                                    </div>
                                    <div class="space-y-4 pt-4 border-t border-gray-50">
                                        <div class="flex items-center gap-3 text-sm">
                                            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                                            </svg>
                                            <span class="truncate text-gray-600"><%= job.employee.email %></span>
                                        </div>
                                        <div class="flex items-center gap-3 text-sm">
                                            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                                            </svg>
                                            <span class="text-gray-600"><%= job.employee.phone %></span>
                                        </div>
                                    </div>
                                <% } else { %>
                                    <p class="text-gray-400 italic">No employee assigned yet.</p>
                                <% } %>
                            </div>

                            <!-- Financials Card -->
                            <div class="bg-gray-900 rounded-2xl p-6 text-white shadow-xl shadow-gray-200">
                                <h3 class="text-md font-bold mb-6 text-gray-400 uppercase tracking-widest text-xs">Job Financials</h3>
                                <div class="space-y-4">
                                    <div class="flex justify-between items-center pb-3 border-b border-gray-800">
                                        <span class="text-gray-400 text-sm">Labor Cost</span>
                                        <span class="font-medium">$<%= job.laborCost || '0.00' %></span>
                                    </div>
                                    <div class="flex justify-between items-center pb-4 border-b border-gray-800">
                                        <span class="text-gray-400 text-sm">Materials</span>
                                        <span class="font-medium">$<%= job.materialCost || '0.00' %></span>
                                    </div>
                                    <div class="flex justify-between items-center pt-2">
                                        <span class="text-lg font-bold">Total Cost</span>
                                        <span class="text-2xl font-bold text-blue-400">$<%= job.totalCost || '0.00' %></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Status Timeline / History -->
                            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                                <h3 class="text-md font-bold text-gray-900 mb-6">Activity Log</h3>
                                <div class="relative space-y-6">
                                    <div class="absolute left-3 top-2 bottom-2 w-px bg-gray-100"></div>
                                    <% if (job.logs && job.logs.length > 0) { %>
                                        <% job.logs.forEach(log => { %>
                                            <div class="relative pl-10">
                                                <div class="absolute left-0 top-1 w-6 h-6 rounded-full bg-blue-50 border-2 border-white flex items-center justify-center">
                                                    <div class="w-1.5 h-1.5 rounded-full bg-blue-500"></div>
                                                </div>
                                                <div>
                                                    <p class="text-sm font-bold text-gray-800"><%= log.action.replace('_', ' ').toUpperCase() %></p>
                                                    <p class="text-xs text-gray-500 mt-0.5"><%= log.notes %></p>
                                                    <div class="flex items-center gap-2 mt-2">
                                                        <span class="text-[10px] text-gray-400 font-medium"><%= new Date(log.createdAt).toLocaleString() %></span>
                                                        <span class="text-[10px] text-gray-400">•</span>
                                                        <span class="text-[10px] text-blue-600 font-bold uppercase"><%= log.user ? log.user.name : 'System' %></span>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }); %>
                                    <% } else { %>
                                        <p class="text-gray-400 text-sm italic pl-4">No activities logged.</p>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <script src="/js/toast.js"></script>
</body>
</html>
