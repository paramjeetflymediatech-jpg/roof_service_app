  <%- include('../../partials/header') %>

<body <% if (error && error.length> 0) { %>data-flash-error="<%= error %>"<% } %>
            <% if (success && success.length> 0) { %>data-flash-success="<%= success %>"<% } %>>

                        <!-- Toast Container -->
                        <div id="toast-container"></div>

                        <div class="admin-wrapper">
                            <%- include('../../partials/sidebar') %>

                                <main class="main-content">
<%- include('../../partials/top-header') %>

                                    <div class="content">
                                        <div class="max-w-4xl">
                                            <!-- Back Button -->
                                            <div class="mb-6">
                                                <a href="/admin/seo"
                                                    class="text-indigo-600 hover:text-indigo-900 flex items-center gap-2">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                        stroke-width="2">
                                                        <line x1="19" y1="12" x2="5" y2="12"></line>
                                                        <polyline points="12 19 5 12 12 5"></polyline>
                                                    </svg>
                                                    Back to SEO List
                                                </a>
                                            </div>

                                            <!-- Edit Form -->
                                            <div class="bg-white rounded-lg shadow-md p-8">
                                                <div class="mb-6">
                                                    <h2 class="text-2xl font-semibold text-gray-800">Edit SEO Meta Tags</h2>
                                                </div>

                                                <form action="/admin/seo/<%= seoPage.id %>" method="POST" class="space-y-6">
                                                    <!-- Page Name Dropdown -->
                                                    <div>
                                                        <label for="pageName" class="block text-sm font-medium text-gray-700 mb-2">
                                                            Select Page <span class="text-red-500">*</span>
                                                        </label>
                                                        <select name="pageName" id="pageName" required
                                                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                                                            <option value="" disabled>Select a page...</option>
                                                            
                                                            <!-- Main Pages -->
                                                            <optgroup label="Main Pages">
                                                                <% const mainPages = ['home', 'about', 'services', 'gallery', 'projects', 'products', 'company','data-deletion','privacy_policy', 'blogs', 'contact','thank-you']; %>
                                                                <% mainPages.forEach(page => { %>
                                                                    <option value="<%= page %>" <%= seoPage.pageName === page ? 'selected' : '' %>><%= page.charAt(0).toUpperCase() + page.slice(1) %></option>
                                                                <% }) %>
                                                            </optgroup>

                                                         

                                                            <!-- Service Pages -->
                                                            <optgroup label="Services">
                                                                <% services.forEach(service => { %>
                                                                    <% const val = "services/" + service.slug; %>
                                                                    <option value="<%= val %>" <%= seoPage.pageName === val ? 'selected' : '' %>><%= service.name %></option>
                                                                <% }) %>
                                                            </optgroup>
                                                        </select>
                                                        <p class="text-xs text-gray-500 mt-1">Select the page you want this SEO record to apply to.</p>
                                                    </div>
                                                    <!-- Page Title -->
                                                    <div>
                                                        <label for="pageTitle"
                                                            class="block text-sm font-medium text-gray-700 mb-2">
                                                            Page Title <span class="text-red-500">*</span>
                                                        </label>
                                                        <input type="text" id="pageTitle" name="pageTitle"
                                                            value="<%= seoPage.pageTitle %>" required maxlength="100"
                                                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                                            oninput="updateCharCount('pageTitle', 'pageTitleCount', 60)">
                                                        <div class="flex justify-between items-center mt-1">
                                                            <p class="text-xs text-gray-500">Recommended: 50-60
                                                                characters</p>
                                                            <span id="pageTitleCount" class="char-count">0 / 100</span>
                                                        </div>
                                                    </div>

                                                    <!-- Meta Description -->
                                                    <div>
                                                        <label for="metaDescription"
                                                            class="block text-sm font-medium text-gray-700 mb-2">
                                                            Meta Description <span class="text-red-500">*</span>
                                                        </label>
                                                        <textarea id="metaDescription" name="metaDescription" required
                                                            rows="3" maxlength="200"
                                                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                                            oninput="updateCharCount('metaDescription', 'metaDescCount', 160)"><%= seoPage.metaDescription %></textarea>
                                                        <div class="flex justify-between items-center mt-1">
                                                            <p class="text-xs text-gray-500">Recommended: 150-160
                                                                characters</p>
                                                            <span id="metaDescCount" class="char-count">0 / 200</span>
                                                        </div>
                                                    </div>

                                                    <!-- Meta Robots -->
                                                    <div>
                                                        <label for="metaRobots"
                                                            class="block text-sm font-medium text-gray-700 mb-2">
                                                            Meta Robots
                                                        </label>
                                                        <select id="metaRobots" name="metaRobots"
                                                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                                                            <option value="index, follow"
                                                                <%=seoPage.metaRobots==='index, follow' ? 'selected'
                                                                : '' %>>Index, Follow</option>
                                                            <option value="noindex, follow"
                                                                <%=seoPage.metaRobots==='noindex, follow' ? 'selected'
                                                                : '' %>>No Index, Follow</option>
                                                            <option value="index, nofollow"
                                                                <%=seoPage.metaRobots==='index, nofollow' ? 'selected'
                                                                : '' %>>Index, No Follow</option>
                                                            <option value="noindex, nofollow"
                                                                <%=seoPage.metaRobots==='noindex, nofollow' ? 'selected'
                                                                : '' %>>No Index, No Follow</option>
                                                        </select>
                                                        <p class="text-xs text-gray-500 mt-1">Controls how search
                                                            engines index this page</p>
                                                    </div>

                                                    <!-- OG Title -->
                                                    <div>
                                                        <label for="ogTitle"
                                                            class="block text-sm font-medium text-gray-700 mb-2">
                                                            Open Graph Title
                                                        </label>
                                                        <input type="text" id="ogTitle" name="ogTitle"
                                                            value="<%= seoPage.ogTitle || '' %>" maxlength="100"
                                                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                                            placeholder="Leave empty to use Page Title">
                                                        <p class="text-xs text-gray-500 mt-1">Title shown when shared on
                                                            social media</p>
                                                    </div>

                                                    <!-- OG Description -->
                                                    <div>
                                                        <label for="ogDescription"
                                                            class="block text-sm font-medium text-gray-700 mb-2">
                                                            Open Graph Description
                                                        </label>
                                                        <textarea id="ogDescription" name="ogDescription" rows="2"
                                                            maxlength="200"
                                                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                                            placeholder="Leave empty to use Meta Description"><%= seoPage.ogDescription || '' %></textarea>
                                                        <p class="text-xs text-gray-500 mt-1">Description shown when
                                                            shared on social media</p>
                                                    </div>

                                                    <!-- OG Image -->
                                                    <div>
                                                        <label for="ogImage"
                                                            class="block text-sm font-medium text-gray-700 mb-2">
                                                            Open Graph Image URL
                                                        </label>
                                                        <input type="url" id="ogImage" name="ogImage"
                                                            value="<%= seoPage.ogImage || '' %>"
                                                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                                            placeholder="https://example.com/image.jpg">
                                                        <p class="text-xs text-gray-500 mt-1">Image shown when shared on
                                                            social media (recommended: 1200x630px)</p>
                                                    </div>

                                                    <!-- Canonical URL -->
                                                    <div>
                                                        <label for="canonicalUrl"
                                                            class="block text-sm font-medium text-gray-700 mb-2">
                                                            Canonical URL
                                                        </label>
                                                        <input type="url" id="canonicalUrl" name="canonicalUrl"
                                                            value="<%= seoPage.canonicalUrl || '' %>"
                                                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                                            placeholder="https://yourdomain.com/page">
                                                        <p class="text-xs text-gray-500 mt-1">Preferred URL for this
                                                            page (helps prevent duplicate content)</p>
                                                    </div>

                                                    <!-- Schema Markup -->
                                                    <div>
                                                        <label for="schemaMarkup"
                                                            class="block text-sm font-medium text-gray-700 mb-2">
                                                            Schema Markup (JSON-LD)
                                                        </label>
                                                        <textarea id="schemaMarkup" name="schemaMarkup" rows="5"
                                                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent font-mono text-sm"
                                                            placeholder='{ "@context": "https://schema.org", ... }'><%= seoPage.schemaMarkup || '' %></textarea>
                                                        <p class="text-xs text-gray-500 mt-1">Valid JSON-LD only</p>
                                                    </div>

                                                    <!-- Google Tracking -->
                                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                                        <div>
                                                            <label for="googleAnalyticsId"
                                                                class="block text-sm font-medium text-gray-700 mb-2">
                                                                Google Analytics ID
                                                            </label>
                                                            <input type="text" id="googleAnalyticsId"
                                                                name="googleAnalyticsId"
                                                                value="<%= seoPage.googleAnalyticsId || '' %>"
                                                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                                                placeholder="G-XXXXXXXXXX">
                                                        </div>
                                                        <div>
                                                            <label for="googleTagManagerId"
                                                                class="block text-sm font-medium text-gray-700 mb-2">
                                                                Google Tag Manager ID
                                                            </label>
                                                            <input type="text" id="googleTagManagerId"
                                                                name="googleTagManagerId"
                                                                value="<%= seoPage.googleTagManagerId || '' %>"
                                                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                                                placeholder="GTM-XXXXXXX">
                                                        </div>
                                                    </div>

                                                    <!-- Submit Button -->
                                                    <div class="flex gap-4 pt-4">
                                                        <button type="submit"
                                                            class="px-6 py-3 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition">
                                                            Save Changes
                                                        </button>
                                                        <a href="/admin/seo"
                                                            class="px-6 py-3 bg-gray-200 text-gray-700 font-medium rounded-lg hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 transition">
                                                            Cancel
                                                        </a>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </main>
                        </div>

                        <script src="/js/toast.js"></script>
                        <script>
                            function updateCharCount(inputId, countId, recommendedLength) {
                                const input = document.getElementById(inputId);
                                const counter = document.getElementById(countId);
                                const length = input.value.length;
                                const maxLength = input.getAttribute('maxlength');

                                counter.textContent = `${length} / ${maxLength}`;

                                // Update color based on length
                                counter.classList.remove('warning', 'danger');
                                if (length > recommendedLength && length < maxLength) {
                                    counter.classList.add('warning');
                                } else if (length >= maxLength) {
                                    counter.classList.add('danger');
                                }
                            }

                            // Initialize character counts on page load
                            document.addEventListener('DOMContentLoaded', function () {
                                updateCharCount('pageTitle', 'pageTitleCount', 60);
                                updateCharCount('metaDescription', 'metaDescCount', 160);
                            });
                        </script>
</body>

</html>