<% if (seoPages && seoPages.length > 0) { %>
    <% seoPages.forEach(page => { %>
        <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap overflow-hidden text-ellipsis">
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
                    <%= page.pageName %>
                </span>
            </td>
            <td class="px-6 py-4 hidden md:table-cell overflow-hidden">
                <div class="text-sm font-medium text-gray-900 truncate" title="<%= page.pageTitle %>">
                    <%= page.pageTitle %>
                </div>
            </td>
            <td class="px-6 py-4 hidden lg:table-cell overflow-hidden">
                <div class="text-sm text-gray-500 truncate" title="<%= page.metaDescription %>">
                    <%= page.metaDescription %>
                </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 hidden sm:table-cell">
                <%= new Date(page.updatedAt).toLocaleDateString("en-GB") %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                <div class="flex gap-2">
                    <a href="/admin/seo/<%= page.id %>/edit" class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-lg transition" title="Edit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                        </svg>
                    </a>
                    <form action="/admin/seo/<%= page.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this SEO page?');" class="inline">
                        <button type="submit" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition" title="Delete">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                        </button>
                    </form>
                </div>
            </td>
        </tr>
    <% }); %>
<% } else { %>
    <tr>
        <td colspan="5" class="px-6 py-10 text-center text-gray-500">
            <div class="flex flex-col items-center">
                <svg class="w-12 h-12 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <p class="text-lg font-medium">No SEO pages found</p>
                <p class="text-sm text-gray-400 mt-1">Try adjusting your search or add a new page.</p>
            </div>
        </td>
    </tr>
<% } %>
