<% if (totalPages > 1) { %>
    <% 
        // Create a copy of the query safely
        let cleanedQuery = {};
        if (typeof query !== 'undefined' && query) {
            cleanedQuery = JSON.parse(JSON.stringify(query));
            delete cleanedQuery.page;
            delete cleanedQuery.ajax;
        }
        const queryString = new URLSearchParams(cleanedQuery).toString();
        const separator = queryString ? '&' : '';
    %>
    <div class="flex flex-col sm:flex-row items-center justify-between border-t border-gray-200 bg-white px-4 py-4 sm:px-6 rounded-b-xl mt-[-1rem] shadow-sm gap-4">
        <div class="flex-1 flex justify-between sm:hidden w-full">
            <% if (currentPage > 1) { %>
                <a href="/admin/seo?page=<%= currentPage - 1 %><%= separator %><%= queryString %>" 
                   class="relative inline-flex items-center px-4 py-2 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 border border-gray-300">Previous</a>
            <% } %>
            <% if (currentPage < totalPages) { %>
                <a href="/admin/seo?page=<%= currentPage + 1 %><%= separator %><%= queryString %>" 
                   class="relative inline-flex items-center px-4 py-2 ml-3 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 border border-gray-300">Next</a>
            <% } %>
        </div>
        <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between w-full">
            <div>
                <p class="text-sm text-gray-700">
                    Showing <span class="font-medium"><%= (currentPage - 1) * limit + 1 %></span> to <span class="font-medium"><%= Math.min(currentPage * limit, totalItems) %></span> of <span class="font-medium"><%= totalItems %></span> results
                    <span class="mx-2 text-gray-300">|</span>
                    <span class="text-indigo-600 font-semibold text-xs uppercase tracking-wider">Page <%= currentPage %> of <%= totalPages %></span>
                </p>
            </div>
            <div>
                <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                    <% if (currentPage > 1) { %>
                        <a href="/admin/seo?page=<%= currentPage - 1 %><%= separator %><%= queryString %>" 
                           class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                            <span class="sr-only">Previous</span>
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" /></svg>
                        </a>
                    <% } %>
                    
                    <% 
                    let startPage = Math.max(1, currentPage - 2);
                    let endPage = Math.min(totalPages, startPage + 4);
                    if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);
                    %>

                    <% if (startPage > 1) { %>
                        <a href="/admin/seo?page=1<%= separator %><%= queryString %>" 
                           class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50">1</a>
                        <% if (startPage > 2) { %>
                            <span class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300">...</span>
                        <% } %>
                    <% } %>

                    <% for(let i = startPage; i <= endPage; i++) { %>
                        <a href="/admin/seo?page=<%= i %><%= separator %><%= queryString %>" 
                           class="relative inline-flex items-center px-4 py-2 text-sm font-semibold <%= currentPage === i ? 'bg-indigo-600 text-white focus:visible:outline focus:visible:outline-2 focus:visible:outline-offset-2 focus:visible:outline-indigo-600' : 'text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:outline-offset-0' %>"><%= i %></a>
                    <% } %>

                    <% if (endPage < totalPages) { %>
                        <% if (endPage < totalPages - 1) { %>
                            <span class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300">...</span>
                        <% } %>
                        <a href="/admin/seo?page=<%= totalPages %><%= separator %><%= queryString %>" 
                           class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50"><%= totalPages %></a>
                    <% } %>

                    <% if (currentPage < totalPages) { %>
                        <a href="/admin/seo?page=<%= currentPage + 1 %><%= separator %><%= queryString %>" 
                           class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                            <span class="sr-only">Next</span>
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
                        </a>
                    <% } %>
                </nav>
            </div>
        </div>
    </div>
<% } %>
