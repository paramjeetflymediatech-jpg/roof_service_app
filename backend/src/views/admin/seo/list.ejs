  <%- include('../../partials/header') %>

<body <% if (error && error.length> 0) { %>data-flash-error="<%= error %>"<% } %>
            <% if (success && success.length> 0) { %>data-flash-success="<%= success %>"<% } %>>

                        <!-- Toast Container -->
                        <div id="toast-container"></div>

                        <div class="admin-wrapper">
                            <%- include('../../partials/sidebar') %>

                                <main class="main-content">
<%- include('../../partials/top-header') %>

                                    <div class="content">
                                        <!-- Page Header -->
                                        <div class="page-header mb-8">
                                            <div class="header-content">
                                                <h1>SEO Pages</h1>
                                                <p>Manage meta tags and Open Graph settings for all pages</p>
                                            </div>
                                            <div class="header-actions">
                                                <a href="/admin/seo/create"
                                                    class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition flex items-center gap-1">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                                    </svg>
                                                    Add New Page
                                                </a>
                                            </div>
                                        </div>

                                        <!-- Stats Quick View -->
                                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                                            <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-indigo-500">
                                                <p class="text-sm font-medium text-gray-500 uppercase">Total Pages</p>
                                                <p class="text-2xl font-bold text-gray-900">
                                                    <%= seoPages.length %>
                                                </p>
                                            </div>
                                            <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-green-500">
                                                <p class="text-sm font-medium text-gray-500 uppercase">Indexable</p>
                                                <p class="text-2xl font-bold text-gray-900">
                                                    <%= seoPages.filter(p=> !p.metaRobots.includes('noindex')).length %>
                                                </p>
                                            </div>
                                            <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-yellow-500">
                                                <p class="text-sm font-medium text-gray-500 uppercase">No Index</p>
                                                <p class="text-2xl font-bold text-gray-900">
                                                    <%= seoPages.filter(p=> p.metaRobots.includes('noindex')).length %>
                                                </p>
                                            </div>
                                        </div>

                                        <!-- Mobile View (Cards) -->
                                        <div class="block md:hidden space-y-4">
                                            <% if (seoPages && seoPages.length> 0) { %>
                                                <% seoPages.forEach(page=> { %>
                                                    <div class="bg-white rounded-lg shadow border border-gray-200 p-4">
                                                        <div class="flex justify-between items-start mb-3">
                                                            <div>
                                                                <span
                                                                    class="inline-flex px-2 py-1 text-xs font-semibold leading-5 rounded-full bg-blue-100 text-blue-800 mb-2">
                                                                    <%= page.pageName %>
                                                                </span>
                                                                <h3 class="font-semibold text-gray-900 truncate pr-2"
                                                                    title="<%= page.pageTitle %>">
                                                                    <%= page.pageTitle %>
                                                                </h3>
                                                            </div>
                                                        </div>

                                                        <div class="text-sm text-gray-500 mb-3 truncate line-clamp-2"
                                                            title="<%= page.metaDescription %>">
                                                            <%= page.metaDescription %>
                                                        </div>

                                                        <div
                                                            class="flex items-center justify-between text-xs text-gray-400 mb-4 bg-gray-50 p-2 rounded">
                                                            <span>Last Updated:</span>
                                                            <span class="font-medium text-gray-600">
                                                                <%= new Date(page.updatedAt).toLocaleDateString() %>
                                                            </span>
                                                        </div>

                                                        <div class="flex gap-2 pt-2 border-t border-gray-100">
                                                            <a href="/admin/seo/<%= page.id %>/edit"
                                                                class="flex-1 text-center py-2 bg-indigo-50 text-indigo-700 rounded hover:bg-indigo-100 transition text-sm font-medium flex items-center justify-center gap-1">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16"
                                                                    height="16" viewBox="0 0 24 24" fill="none"
                                                                    stroke="currentColor" stroke-width="2"
                                                                    stroke-linecap="round" stroke-linejoin="round">
                                                                    <path
                                                                        d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7">
                                                                    </path>
                                                                    <path
                                                                        d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z">
                                                                    </path>
                                                                </svg>
                                                                Edit
                                                            </a>
                                                            <form action="/admin/seo/<%= page.id %>/delete"
                                                                method="POST"
                                                                onsubmit="return confirm('Are you sure you want to delete this SEO page?');"
                                                                class="flex-1">
                                                                <button type="submit"
                                                                    class="w-full py-2 bg-red-50 text-red-700 rounded hover:bg-red-100 transition text-sm font-medium flex items-center justify-center gap-1">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16"
                                                                        height="16" viewBox="0 0 24 24" fill="none"
                                                                        stroke="currentColor" stroke-width="2"
                                                                        stroke-linecap="round" stroke-linejoin="round">
                                                                        <polyline points="3 6 5 6 21 6"></polyline>
                                                                        <path
                                                                            d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                                        </path>
                                                                    </svg>
                                                                    Delete
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                    <% }); %>
                                                        <% } else { %>
                                                            <div
                                                                class="text-center py-8 bg-white rounded-lg border border-gray-200 text-gray-500">
                                                                <div class="flex flex-col items-center">
                                                                    <svg class="w-12 h-12 text-gray-300 mb-4"
                                                                        fill="none" stroke="currentColor"
                                                                        viewBox="0 0 24 24">
                                                                        <circle cx="11" cy="11" r="8"></circle>
                                                                        <line x1="21" y1="21" x2="16.65" y2="16.65">
                                                                        </line>
                                                                    </svg>
                                                                    <p class="text-lg font-medium">No SEO pages found
                                                                    </p>
                                                                    <p class="text-sm text-gray-400 mt-1">Add a new page
                                                                        to get started</p>
                                                                </div>
                                                            </div>
                                                            <% } %>
                                        </div>

                                        <!-- Desktop View (Table) -->
                                        <div
                                            class="hidden md:block table-container shadow-lg rounded-xl overflow-hidden bg-white">
                                            <div class="overflow-x-hidden">
                                                <table class="data-table w-full table-fixed">
                                                    <thead class="bg-gray-50">
                                                        <tr>
                                                            <th
                                                                class="w-1/6 px-6 py-4 text-left text-xs font-medium text-white uppercase tracking-wider">
                                                                Page Name
                                                            </th>
                                                            <th
                                                                class="w-1/4 px-6 py-4 text-left text-xs font-medium text-white uppercase tracking-wider hidden md:table-cell">
                                                                Page Title
                                                            </th>
                                                            <th
                                                                class="w-1/3 px-6 py-4 text-left text-xs font-medium text-white uppercase tracking-wider hidden lg:table-cell">
                                                                Meta Description
                                                            </th>
                                                            <th
                                                                class="w-1/6 px-6 py-4 text-left text-xs font-medium text-white uppercase tracking-wider hidden sm:table-cell">
                                                                Last Updated
                                                            </th>
                                                            <th
                                                                class="w-16 px-6 py-4 text-left text-xs font-medium text-white uppercase tracking-wider">
                                                                Actions
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                    <tbody class="divide-y divide-gray-200">
                                                        <% if (seoPages && seoPages.length> 0) { %>
                                                            <% seoPages.forEach(page=> { %>
                                                                <tr class="hover:bg-gray-50 transition-colors ">
                                                                    <td
                                                                        class="px-6 py-4 whitespace-nowrap overflow-hidden text-ellipsis">
                                                                        <span
                                                                            class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
                                                                            <%= page.pageName %>
                                                                        </span>
                                                                    </td>
                                                                    <td
                                                                        class="px-6 py-4 hidden md:table-cell overflow-hidden">
                                                                        <div class="text-sm font-medium text-gray-900 truncate"
                                                                            title="<%= page.pageTitle %>">
                                                                            <%= page.pageTitle %>
                                                                        </div>
                                                                    </td>
                                                                    <td
                                                                        class="px-6 py-4 hidden lg:table-cell overflow-hidden">
                                                                        <div class="text-sm text-gray-500 truncate"
                                                                            title="<%= page.metaDescription %>">
                                                                            <%= page.metaDescription %>
                                                                        </div>
                                                                    </td>
                                                                    <td
                                                                        class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 hidden sm:table-cell">
                                                                        <%= new
                                                                            Date(page.updatedAt).toLocaleDateString() %>
                                                                    </td>
                                                                    <td
                                                                        class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                                                        <div class="flex gap-2">
                                                                            <a href="/admin/seo/<%= page.id %>/edit"
                                                                                class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-lg transition"
                                                                                title="Edit">
                                                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                                                    width="20" height="20"
                                                                                    viewBox="0 0 24 24" fill="none"
                                                                                    stroke="currentColor"
                                                                                    stroke-width="2"
                                                                                    stroke-linecap="round"
                                                                                    stroke-linejoin="round">
                                                                                    <path
                                                                                        d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7">
                                                                                    </path>
                                                                                    <path
                                                                                        d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z">
                                                                                    </path>
                                                                                </svg>
                                                                            </a>
                                                                            <form
                                                                                action="/admin/seo/<%= page.id %>/delete"
                                                                                method="POST"
                                                                                onsubmit="return confirm('Are you sure you want to delete this SEO page?');"
                                                                                class="inline">
                                                                                <button type="submit"
                                                                                    class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition"
                                                                                    title="Delete">
                                                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                                                        width="20" height="20"
                                                                                        viewBox="0 0 24 24" fill="none"
                                                                                        stroke="currentColor"
                                                                                        stroke-width="2"
                                                                                        stroke-linecap="round"
                                                                                        stroke-linejoin="round">
                                                                                        <polyline points="3 6 5 6 21 6">
                                                                                        </polyline>
                                                                                        <path
                                                                                            d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                                                        </path>
                                                                                    </svg>
                                                                                </button>
                                                                            </form>
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                                <% }); %>
                                                                    <% } else { %>
                                                                        <tr>
                                                                            <td colspan="5"
                                                                                class="px-6 py-10 text-center text-gray-500">
                                                                                <div class="flex flex-col items-center">
                                                                                    <svg class="w-12 h-12 text-gray-300 mb-4"
                                                                                        fill="none"
                                                                                        stroke="currentColor"
                                                                                        viewBox="0 0 24 24">
                                                                                        <circle cx="11" cy="11" r="8">
                                                                                        </circle>
                                                                                        <line x1="21" y1="21" x2="16.65"
                                                                                            y2="16.65"></line>
                                                                                    </svg>
                                                                                    <p class="text-lg font-medium">No
                                                                                        SEO pages found</p>
                                                                                    <p
                                                                                        class="text-sm text-gray-400 mt-1">
                                                                                        Add a new page to get started
                                                                                    </p>
                                                                                </div>
                                                                            </td>
                                                                        </tr>
                                                                        <% } %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <!-- Enhanced Pagination -->
                                        <% if (totalPages > 1) { %>
                                            <div class="flex flex-col sm:flex-row items-center justify-between border-t border-gray-200 bg-white px-4 py-4 sm:px-6 rounded-b-xl mt-[-1rem] shadow-sm gap-4">
                                                <div class="flex-1 flex justify-between sm:hidden w-full">
                                                    <% if (currentPage > 1) { %>
                                                        <a href="/admin/seo?page=<%= currentPage - 1 %>" class="relative inline-flex items-center px-4 py-2 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 border border-gray-300">Previous</a>
                                                    <% } %>
                                                    <% if (currentPage < totalPages) { %>
                                                        <a href="/admin/seo?page=<%= currentPage + 1 %>" class="relative inline-flex items-center px-4 py-2 ml-3 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 border border-gray-300">Next</a>
                                                    <% } %>
                                                </div>
                                                <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between w-full">
                                                    <div>
                                                        <p class="text-sm text-gray-700">
                                                            Showing <span class="font-medium"><%= (currentPage - 1) * limit + 1 %></span> to <span class="font-medium"><%= Math.min(currentPage * limit, totalItems) %></span> of <span class="font-medium"><%= totalItems %></span> results
                                                            <span class="mx-2 text-gray-300">|</span>
                                                            <span class="text-indigo-600 font-semibold text-xs uppercase tracking-wider">Page <%= currentPage %> of <%= totalPages %></span>
                                                        </p>
                                                    </div>
                                                    <div>
                                                        <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                                                            <% if (currentPage > 1) { %>
                                                                <a href="/admin/seo?page=<%= currentPage - 1 %>" class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                                                    <span class="sr-only">Previous</span>
                                                                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" /></svg>
                                                                </a>
                                                            <% } %>
                                                            
                                                            <% 
                                                            let startPage = Math.max(1, currentPage - 2);
                                                            let endPage = Math.min(totalPages, startPage + 4);
                                                            if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);
                                                            %>

                                                            <% if (startPage > 1) { %>
                                                                <a href="/admin/seo?page=1" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50">1</a>
                                                                <% if (startPage > 2) { %>
                                                                    <span class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300">...</span>
                                                                <% } %>
                                                            <% } %>

                                                            <% for(let i = startPage; i <= endPage; i++) { %>
                                                                <a href="/admin/seo?page=<%= i %>" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold <%= currentPage === i ? 'bg-indigo-600 text-white focus:visible:outline focus:visible:outline-2 focus:visible:outline-offset-2 focus:visible:outline-indigo-600' : 'text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:outline-offset-0' %>"><%= i %></a>
                                                            <% } %>

                                                            <% if (endPage < totalPages) { %>
                                                                <% if (endPage < totalPages - 1) { %>
                                                                    <span class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300">...</span>
                                                                <% } %>
                                                                <a href="/admin/seo?page=<%= totalPages %>" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50"><%= totalPages %></a>
                                                            <% } %>

                                                            <% if (currentPage < totalPages) { %>
                                                                <a href="/admin/seo?page=<%= currentPage + 1 %>" class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                                                    <span class="sr-only">Next</span>
                                                                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
                                                                </a>
                                                            <% } %>
                                                        </nav>
                                                    </div>
                                                </div>
                                            </div>
                                        <% } %>
                                    </div>
                                </main>
                        </div>

                        <script src="/js/toast.js"></script>
</body>

</html>