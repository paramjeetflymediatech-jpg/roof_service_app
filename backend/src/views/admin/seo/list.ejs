  <%- include('../../partials/header') %>

<body <% if (error && error.length> 0) { %>data-flash-error="<%= error %>"<% } %>
            <% if (success && success.length> 0) { %>data-flash-success="<%= success %>"<% } %>>

                        <!-- Toast Container -->
                        <div id="toast-container"></div>

                        <div class="admin-wrapper">
                            <%- include('../../partials/sidebar') %>

                                <main class="main-content">
<%- include('../../partials/top-header') %>

                                    <div class="content">
                                        <!-- Page Header & Search -->
                                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                                            <div class="header-content">
                                                <h1 class="text-2xl font-bold text-gray-900 leading-tight">SEO Pages</h1>
                                                <p class="text-gray-500 mt-1">Manage meta tags and Open Graph settings for all pages</p>
                                            </div>
                                            
                                            <div class="flex flex-col md:flex-row gap-3">
                                                <!-- Search Form -->
                                                <form id="searchForm" action="/admin/seo" method="GET" class="flex flex-col md:flex-row gap-3">
                                                    <div class="relative flex-1 md:w-64">
                                                        <input type="text" name="search" id="searchInput" 
                                                            value="<%= typeof query !== 'undefined' ? query.search || '' : '' %>"
                                                            placeholder="Search page name, title..." 
                                                            class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 outline-none transition shadow-sm bg-white">
                                                        <div class="absolute left-3 top-2.5 text-gray-400">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                                        </div>
                                                    </div>
                                                    <a href="/admin/seo" class="clear-btn px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition text-sm font-medium flex items-center justify-center">Clear</a>
                                                </form>

                                                <a href="/admin/seo/create"
                                                    class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition flex items-center gap-1">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                                    </svg>
                                                    Add New Page
                                                </a>
                                            </div>
                                        </div>

                                        <!-- Stats Quick View -->
                                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                                            <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-indigo-500">
                                                <p class="text-sm font-medium text-gray-500 uppercase">Total Pages</p>
                                                <p class="text-2xl font-bold text-gray-900">
                                                    <%= seoPages.length %>
                                                </p>
                                            </div>
                                            <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-green-500">
                                                <p class="text-sm font-medium text-gray-500 uppercase">Indexable</p>
                                                <p class="text-2xl font-bold text-gray-900">
                                                    <%= seoPages.filter(p=> !p.metaRobots.includes('noindex')).length %>
                                                </p>
                                            </div>
                                            <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-yellow-500">
                                                <p class="text-sm font-medium text-gray-500 uppercase">No Index</p>
                                                <p class="text-2xl font-bold text-gray-900">
                                                    <%= seoPages.filter(p=> p.metaRobots.includes('noindex')).length %>
                                                </p>
                                            </div>
                                        </div>

                                        <div id="listCardContainer" class="block md:hidden space-y-4">
                                            <%- include('./_cards') %>
                                        </div>

                                        <!-- Desktop View (Table) -->
                                        <div
                                            class="hidden md:block table-container shadow-lg rounded-xl overflow-hidden bg-white">
                                            <div class="overflow-x-hidden">
                                                <table class="data-table w-full table-fixed">
                                                    <thead class="bg-gray-50">
                                                        <tr>
                                                            <th
                                                                class="w-1/6 px-6 py-4 text-left text-xs font-medium text-white uppercase tracking-wider">
                                                                Page Name
                                                            </th>
                                                            <th
                                                                class="w-1/4 px-6 py-4 text-left text-xs font-medium text-white uppercase tracking-wider hidden md:table-cell">
                                                                Page Title
                                                            </th>
                                                            <th
                                                                class="w-1/3 px-6 py-4 text-left text-xs font-medium text-white uppercase tracking-wider hidden lg:table-cell">
                                                                Meta Description
                                                            </th>
                                                            <th
                                                                class="w-1/6 px-6 py-4 text-left text-xs font-medium text-white uppercase tracking-wider hidden sm:table-cell">
                                                                Last Updated
                                                            </th>
                                                            <th
                                                                class="w-16 px-6 py-4 text-left text-xs font-medium text-white uppercase tracking-wider">
                                                                Actions
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="listTableBody" class="divide-y divide-gray-200">
                                                        <%- include('./_table_rows') %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <div id="paginationContainer">
                                            <%- include('./_pagination') %>
                                        </div>
                                    </div>
                                </main>
                        </div>

                        <script src="/js/toast.js"></script>
                        <script src="/js/list-ajax.js"></script>
</body>

</html>