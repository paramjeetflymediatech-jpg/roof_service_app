<%- include('../../partials/header') %>

<body <% if (error && error.length> 0) { %>data-flash-error="<%= error %>"<% } %>
      <% if (success && success.length> 0) { %>data-flash-success="<%= success %>"<% } %>>
  
  <!-- Toast Container -->
  <div id="toast-container"></div>

  <div class="admin-wrapper">
    <%- include('../../partials/sidebar') %>

    <main class="main-content">
      <%- include('../../partials/top-header') %>

      <div class="content">
        <!-- Page Header & Search -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-900 leading-tight">Data Deletion Requests</h1>
                <p class="text-gray-500 mt-1 pb-4">Manage and process user requests for data deletion</p>
            </div>
            
            <div class="flex flex-col md:flex-row gap-3">
                <!-- Search Form -->
                <form id="searchForm" action="/admin/deletion-requests" method="GET" class="flex flex-col md:flex-row gap-3">
                    <div class="relative flex-1 md:w-64">
                        <input type="text" name="search" id="searchInput" 
                            value="<%= typeof query !== 'undefined' ? query.search || '' : '' %>"
                            placeholder="Search by email..." 
                            class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 outline-none transition shadow-sm bg-white">
                        <div class="absolute left-3 top-2.5 text-gray-400">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        </div>
                    </div>
                    <a href="/admin/deletion-requests" class="clear-btn px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition text-sm font-medium flex items-center justify-center">Clear</a>
                </form>
            </div>
        </div>
        <!-- Stats -->
        <div class="mb-6 grid grid-cols-1 md:grid-cols-4 gap-4">
          <div class="bg-white rounded-lg shadow p-4">
            <div class="text-sm text-gray-600">Total Requests</div>
            <div class="text-2xl font-bold text-gray-900"><%= totalRequests %></div>
          </div>
          <div class="bg-yellow-50 rounded-lg shadow p-4">
            <div class="text-sm text-gray-600">Pending</div>
            <div class="text-2xl font-bold text-yellow-700">
              <%= requests.filter(r => r.status === 'pending').length %>
            </div>
          </div>
          <div class="bg-green-50 rounded-lg shadow p-4">
            <div class="text-sm text-gray-600">Completed</div>
            <div class="text-2xl font-bold text-green-700">
              <%= requests.filter(r => r.status === 'completed').length %>
            </div>
          </div>
          <div class="bg-red-50 rounded-lg shadow p-4">
            <div class="text-sm text-gray-600">Rejected</div>
            <div class="text-2xl font-bold text-red-700">
              <%= requests.filter(r => r.status === 'rejected').length %>
            </div>
          </div>
        </div>

        <div id="listCardContainer" class="block md:hidden space-y-4">
          <%- include('./_cards') %>
        </div>

        <!-- Desktop View (Table) -->
        <div class="hidden md:block table-container text-black">
          <table class="data-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Status</th>
                <th>Requested</th>
                <th>Processed</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="listTableBody">
              <%- include('./_table_rows') %>
            </tbody>
          </table>
        </div>

        <div id="paginationContainer">
          <%- include('./_pagination') %>
        </div>

        <!-- Total Count -->
        <div class="mt-4 text-sm text-gray-600">
          Showing <%= requests.length %> of <%= totalRequests %> requests
        </div>
      </div>
    </main>
  </div>

  <script src="/js/toast.js"></script>
  <script src="/js/list-ajax.js"></script>
</body>

</html>
