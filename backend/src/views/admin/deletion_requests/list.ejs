<%- include('../../partials/header') %>

<body <% if (error && error.length> 0) { %>data-flash-error="<%= error %>"<% } %>
      <% if (success && success.length> 0) { %>data-flash-success="<%= success %>"<% } %>>
  
  <!-- Toast Container -->
  <div id="toast-container"></div>

  <div class="admin-wrapper">
    <%- include('../../partials/sidebar') %>

    <main class="main-content">
      <%- include('../../partials/top-header') %>

      <div class="content">
        <!-- Stats -->
        <div class="mb-6 grid grid-cols-1 md:grid-cols-4 gap-4">
          <div class="bg-white rounded-lg shadow p-4">
            <div class="text-sm text-gray-600">Total Requests</div>
            <div class="text-2xl font-bold text-gray-900"><%= totalRequests %></div>
          </div>
          <div class="bg-yellow-50 rounded-lg shadow p-4">
            <div class="text-sm text-gray-600">Pending</div>
            <div class="text-2xl font-bold text-yellow-700">
              <%= requests.filter(r => r.status === 'pending').length %>
            </div>
          </div>
          <div class="bg-green-50 rounded-lg shadow p-4">
            <div class="text-sm text-gray-600">Completed</div>
            <div class="text-2xl font-bold text-green-700">
              <%= requests.filter(r => r.status === 'completed').length %>
            </div>
          </div>
          <div class="bg-red-50 rounded-lg shadow p-4">
            <div class="text-sm text-gray-600">Rejected</div>
            <div class="text-2xl font-bold text-red-700">
              <%= requests.filter(r => r.status === 'rejected').length %>
            </div>
          </div>
        </div>

        <!-- Mobile View (Cards) -->
        <div class="block md:hidden space-y-4">
          <% if (requests && requests.length> 0) { %>
            <% requests.forEach(request=> { %>
              <div class="bg-white rounded-lg shadow border border-gray-200 p-4">
                <div class="flex justify-between items-start mb-3">
                  <div>
                    <h3 class="font-semibold text-gray-900"><%= request.name %></h3>
                    <p class="text-sm text-gray-500"><%= request.email %></p>
                  </div>
                  <span class="px-2 py-0.5 text-xs font-medium rounded-full 
                    <%= request.status === 'pending' ? 'bg-yellow-100 text-yellow-800' : 
                        request.status === 'completed' ? 'bg-green-100 text-green-800' :
                        request.status === 'processing' ? 'bg-blue-100 text-blue-800' :
                        'bg-red-100 text-red-800' %>">
                    <%= request.status.toUpperCase() %>
                  </span>
                </div>

                <div class="text-sm text-gray-600 mb-4">
                  <div>Requested: <%= new Date(request.requestedAt).toLocaleString() %></div>
                  <% if (request.processedAt) { %>
                    <div>Processed: <%= new Date(request.processedAt).toLocaleString() %></div>
                  <% } %>
                </div>

                <% if (request.status === 'pending') { %>
                  <div class="flex gap-2 pt-3 border-t border-gray-100">
                    <a href="/admin/deletion-requests/<%= request.id %>" class="w-full text-center py-2 bg-blue-50 text-blue-700 rounded hover:bg-blue-100 transition text-sm font-medium">
                      View Details
                    </a>
                  </div>
                <% } else { %>
                  <div class="flex gap-2 pt-3 border-t border-gray-100">
                    <a href="/admin/deletion-requests/<%= request.id %>" class="w-full text-center py-2 bg-gray-50 text-gray-700 rounded hover:bg-gray-100 transition text-sm font-medium">
                      View Details
                    </a>
                  </div>
                <% } %>
              </div>
            <% }) %>
          <% } else { %>
            <div class="text-center py-8 bg-white rounded-lg border border-gray-200 text-gray-500">
              No deletion requests found
            </div>
          <% } %>
        </div>

        <!-- Desktop View (Table) -->
        <div class="hidden md:block table-container text-black">
          <table class="data-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Status</th>
                <th>Requested</th>
                <th>Processed</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (requests && requests.length> 0) { %>
                <% requests.forEach(request=> { %>
                  <tr>
                    <td><%= request.name %></td>
                    <td><%= request.email %></td>
                    <td>
                      <span class="badge 
                        <%= request.status === 'pending' ? 'badge-warning' : 
                            request.status === 'completed' ? 'badge-success' :
                            request.status === 'processing' ? 'badge-primary' :
                            'badge-danger' %>">
                        <%= request.status.toUpperCase() %>
                      </span>
                    </td>
                    <td><%= new Date(request.requestedAt).toLocaleString() %></td>
                    <td>
                      <% if (request.processedAt) { %>
                        <%= new Date(request.processedAt).toLocaleString() %>
                      <% } else { %>
                        -
                      <% } %>
                    </td>
                    <td>
                      <a href="/admin/deletion-requests/<%= request.id %>" 
                        class="px-3 py-1 bg-blue-500 text-white rounded hover:bg-blue-600 transition text-sm">
                        View Details
                      </a>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="text-center text-gray-500">No requests found</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Enhanced Pagination -->
        <% if (totalPages > 1) { %>
          <div class="flex flex-col sm:flex-row items-center justify-between border-t border-gray-200 bg-white px-4 py-4 sm:px-6 rounded-b-xl mt-4 shadow-sm gap-4">
              <div class="flex-1 flex justify-between sm:hidden w-full">
                  <% if (currentPage > 1) { %>
                      <a href="/admin/deletion-requests?page=<%= currentPage - 1 %>" class="relative inline-flex items-center px-4 py-2 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 border border-gray-300">Previous</a>
                  <% } %>
                  <% if (currentPage < totalPages) { %>
                      <a href="/admin/deletion-requests?page=<%= currentPage + 1 %>" class="relative inline-flex items-center px-4 py-2 ml-3 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 border border-gray-300">Next</a>
                  <% } %>
              </div>
              <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between w-full">
                  <div>
                      <p class="text-sm text-gray-700">
                          Showing <span class="font-medium"><%= (currentPage - 1) * limit + 1 %></span> to <span class="font-medium"><%= Math.min(currentPage * limit, totalItems) %></span> of <span class="font-medium"><%= totalItems %></span> results
                          <span class="mx-2 text-gray-300">|</span>
                          <span class="text-indigo-600 font-semibold text-xs uppercase tracking-wider">Page <%= currentPage %> of <%= totalPages %></span>
                      </p>
                  </div>
                  <div>
                      <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                          <% if (currentPage > 1) { %>
                              <a href="/admin/deletion-requests?page=<%= currentPage - 1 %>" class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                  <span class="sr-only">Previous</span>
                                  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" /></svg>
                              </a>
                          <% } %>
                          
                          <% 
                          let startPage = Math.max(1, currentPage - 2);
                          let endPage = Math.min(totalPages, startPage + 4);
                          if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);
                          %>

                          <% if (startPage > 1) { %>
                              <a href="/admin/deletion-requests?page=1" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50">1</a>
                              <% if (startPage > 2) { %>
                                  <span class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300">...</span>
                              <% } %>
                          <% } %>

                          <% for(let i = startPage; i <= endPage; i++) { %>
                              <a href="/admin/deletion-requests?page=<%= i %>" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold <%= currentPage === i ? 'bg-indigo-600 text-white focus:visible:outline focus:visible:outline-2 focus:visible:outline-offset-2 focus:visible:outline-indigo-600' : 'text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:outline-offset-0' %>"><%= i %></a>
                          <% } %>

                          <% if (endPage < totalPages) { %>
                              <% if (endPage < totalPages - 1) { %>
                                  <span class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300">...</span>
                              <% } %>
                              <a href="/admin/deletion-requests?page=<%= totalPages %>" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50"><%= totalPages %></a>
                          <% } %>

                          <% if (currentPage < totalPages) { %>
                              <a href="/admin/deletion-requests?page=<%= currentPage + 1 %>" class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                  <span class="sr-only">Next</span>
                                  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
                              </a>
                          <% } %>
                      </nav>
                  </div>
              </div>
          </div>
        <% } %>

        <!-- Total Count -->
        <div class="mt-4 text-sm text-gray-600">
          Showing <%= requests.length %> of <%= totalRequests %> requests
        </div>
      </div>
    </main>
  </div>

  <script src="/js/toast.js"></script>
</body>

</html>
