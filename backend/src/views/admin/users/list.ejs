  <%- include('../../partials/header') %>

<body <% if (error && error.length> 0) { %>data-flash-error="<%= error %>"<% } %>
            <% if (success && success.length> 0) { %>data-flash-success="<%= success %>"<% } %>
                        >
                        <!-- Toast Container -->
                        <div id="toast-container"></div>

                        <!-- Delete Confirmation Modal -->
                        <div id="deleteModal" class="modal">
                            <div class="bg-white rounded-lg p-6 max-w-md w-full mx-4">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Confirm Delete</h3>
                                <p class="text-gray-600 mb-6">Are you sure you want to delete this user? This action
                                    cannot be undone.</p>
                                <div class="flex gap-4 justify-end">
                                    <button onclick="closeDeleteModal()"
                                        class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition">
                                        Cancel
                                    </button>
                                    <form id="deleteForm" method="POST" class="inline">
                                        <button type="submit"
                                            class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <div class="admin-wrapper">
                            <%- include('../../partials/sidebar') %>

                                <main class="main-content">
<%- include('../../partials/top-header') %>

                                    <div class="content">
                                        <!-- Add User Button -->
                                        <!-- Add Usero Button -->
                                        <div class="mb-6 flex gap-3">
                                            <a href="/admin/users/new"
                                                class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
                                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2" d="M12 4v16m8-8H4"></path>
                                                </svg>
                                                Add New User
                                            </a>
                                            <% if (users.length> 1) { %>
                                                <form action="/admin/users/delete-all" method="POST"
                                                    onsubmit="return confirm('WARNING: Are you sure you want to delete ALL users (except yourself)? This action cannot be undone.');">
                                                    <button type="submit"
                                                        class="inline-flex items-center px-4 py-2 bg-red-100 text-red-700 rounded-lg hover:bg-red-200 transition">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2"
                                                            viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                            stroke-width="2" stroke-linecap="round"
                                                            stroke-linejoin="round">
                                                            <polyline points="3 6 5 6 21 6"></polyline>
                                                            <path
                                                                d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                            </path>
                                                            <line x1="10" y1="11" x2="10" y2="17"></line>
                                                            <line x1="14" y1="11" x2="14" y2="17"></line>
                                                        </svg>
                                                        Delete All
                                                    </button>
                                                </form>
                                                <% } %>
                                        </div>

                                        <!-- Mobile View (Cards) -->
                                        <div class="block md:hidden space-y-4">
                                            <% if (users && users.length> 0) { %>
                                                <% users.forEach(user=> { %>
                                                    <div class="bg-white rounded-lg shadow border border-gray-200 p-4">
                                                        <div class="flex justify-between items-start mb-3">
                                                            <div>
                                                                <h3 class="font-semibold text-gray-900 truncate"
                                                                    title="<%= user.name %>">
                                                                    <%= user.name %>
                                                                </h3>
                                                                <p class="text-sm text-gray-500 truncate"
                                                                    title="<%= user.email %>">
                                                                    <%= user.email %>
                                                                </p>
                                                            </div>
                                                            <span
                                                                class="px-2 py-0.5 text-xs font-medium rounded-full <%= user.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                                                                <%= user.isActive ? 'Active' : 'Inactive' %>
                                                            </span>
                                                        </div>

                                                        <div
                                                            class="flex items-center justify-between text-sm text-gray-500 mb-4">
                                                            <span
                                                                class="bg-gray-100 px-2 py-1 rounded text-gray-700 font-medium text-xs">
                                                                <%= user.role.toUpperCase() %>
                                                            </span>
                                                            <span>
                                                                <%= new Date(user.createdAt).toLocaleDateString() %>
                                                            </span>
                                                        </div>

                                                        <div class="flex gap-2 pt-3 border-t border-gray-100">
                                                            <a href="/admin/users/<%= user.id %>/edit"
                                                                class="flex-1 text-center py-2 bg-yellow-50 text-yellow-700 rounded hover:bg-yellow-100 transition text-sm font-medium">
                                                                Edit
                                                            </a>
                                                            <button
                                                                onclick="confirmDelete('<%= user.id %>', '<%= user.name %>')"
                                                                class="flex-1 text-center py-2 bg-red-50 text-red-700 rounded hover:bg-red-100 transition text-sm font-medium">
                                                                Delete
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <% }) %>
                                                        <% } else { %>
                                                            <div
                                                                class="text-center py-8 bg-white rounded-lg border border-gray-200 text-gray-500">
                                                                No users found
                                                            </div>
                                                            <% } %>
                                        </div>

                                        <!-- Desktop View (Table) -->
                                        <div class="hidden md:block table-container text-black">
                                            <table class="data-table">
                                                <thead>
                                                    <tr>
                                                        <th>Name</th>
                                                        <th>Email</th>
                                                        <th>Role</th>
                                                        <th>Status</th>
                                                        <th>Created</th>
                                                        <th>Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (users && users.length> 0) { %>
                                                        <% users.forEach(user=> { %>
                                                            <tr>
                                                                <td>
                                                                    <%= user.name %>
                                                                </td>
                                                                <td>
                                                                    <%= user.email %>
                                                                </td>
                                                                <td>
                                                                    <span
                                                                        class="badge <%= user.role === 'admin' ? 'badge-primary' : 'badge-secondary' %>">
                                                                        <%= user.role.toUpperCase() %>
                                                                    </span>
                                                                </td>
                                                                <td>
                                                                    <span
                                                                        class="badge <%= user.isActive ? 'badge-success' : 'badge-danger' %>">
                                                                        <%= user.isActive ? 'Active' : 'Inactive' %>
                                                                    </span>
                                                                </td>
                                                                <td>
                                                                    <%= new Date(user.createdAt).toLocaleDateString() %>
                                                                </td>
                                                                <td>
                                                                    <div class="flex gap-2">
                                                                        <a href="/admin/users/<%= user.id %>/edit"
                                                                            class="px-3 py-1 bg-yellow-500 text-white rounded hover:bg-yellow-600 transition text-sm">
                                                                            Edit
                                                                        </a>
                                                                        <button
                                                                            onclick="confirmDelete('<%= user.id %>', '<%= user.name %>')"
                                                                            class="px-3 py-1 bg-red-500 text-white rounded hover:bg-red-600 transition text-sm">
                                                                            Delete
                                                                        </button>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                            <% }) %>
                                                                <% } else { %>
                                                                    <tr>
                                                                        <td colspan="6"
                                                                            class="text-center text-gray-500">No users
                                                                            found</td>
                                                                    </tr>
                                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>

                                        <!-- Enhanced Pagination -->
                                        <% if (totalPages > 1) { %>
                                            <div class="flex flex-col sm:flex-row items-center justify-between border-t border-gray-200 bg-white px-4 py-4 sm:px-6 rounded-b-xl mt-[-1rem] shadow-sm gap-4">
                                                <div class="flex-1 flex justify-between sm:hidden w-full">
                                                    <% if (currentPage > 1) { %>
                                                        <a href="/admin/users?page=<%= currentPage - 1 %>" class="relative inline-flex items-center px-4 py-2 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 border border-gray-300">Previous</a>
                                                    <% } %>
                                                    <% if (currentPage < totalPages) { %>
                                                        <a href="/admin/users?page=<%= currentPage + 1 %>" class="relative inline-flex items-center px-4 py-2 ml-3 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 border border-gray-300">Next</a>
                                                    <% } %>
                                                </div>
                                                <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between w-full">
                                                    <div>
                                                        <p class="text-sm text-gray-700">
                                                            Showing <span class="font-medium"><%= (currentPage - 1) * limit + 1 %></span> to <span class="font-medium"><%= Math.min(currentPage * limit, totalItems) %></span> of <span class="font-medium"><%= totalItems %></span> results
                                                            <span class="mx-2 text-gray-300">|</span>
                                                            <span class="text-indigo-600 font-semibold text-xs uppercase tracking-wider">Page <%= currentPage %> of <%= totalPages %></span>
                                                        </p>
                                                    </div>
                                                    <div>
                                                        <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                                                            <% if (currentPage > 1) { %>
                                                                <a href="/admin/users?page=<%= currentPage - 1 %>" class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                                                    <span class="sr-only">Previous</span>
                                                                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" /></svg>
                                                                </a>
                                                            <% } %>
                                                            
                                                            <% 
                                                            let startPage = Math.max(1, currentPage - 2);
                                                            let endPage = Math.min(totalPages, startPage + 4);
                                                            if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);
                                                            %>

                                                            <% if (startPage > 1) { %>
                                                                <a href="/admin/users?page=1" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50">1</a>
                                                                <% if (startPage > 2) { %>
                                                                    <span class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300">...</span>
                                                                <% } %>
                                                            <% } %>

                                                            <% for(let i = startPage; i <= endPage; i++) { %>
                                                                <a href="/admin/users?page=<%= i %>" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold <%= currentPage === i ? 'bg-indigo-600 text-white focus:visible:outline focus:visible:outline-2 focus:visible:outline-offset-2 focus:visible:outline-indigo-600' : 'text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:outline-offset-0' %>"><%= i %></a>
                                                            <% } %>

                                                            <% if (endPage < totalPages) { %>
                                                                <% if (endPage < totalPages - 1) { %>
                                                                    <span class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300">...</span>
                                                                <% } %>
                                                                <a href="/admin/users?page=<%= totalPages %>" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50"><%= totalPages %></a>
                                                            <% } %>

                                                            <% if (currentPage < totalPages) { %>
                                                                <a href="/admin/users?page=<%= currentPage + 1 %>" class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                                                    <span class="sr-only">Next</span>
                                                                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
                                                                </a>
                                                            <% } %>
                                                        </nav>
                                                    </div>
                                                </div>
                                            </div>
                                        <% } %>

                                                <!-- Total Count -->
                                                <div class="mt-4 text-sm text-gray-600">
                                                    Showing <%= users.length %> of <%= totalUsers %> users
                                                </div>
                                    </div>
                                </main>
                        </div>

                        <script src="/js/toast.js"></script>
                        <script>
                            function confirmDelete(userId, userName) {
                                const modal = document.getElementById('deleteModal');
                                const form = document.getElementById('deleteForm');
                                form.action = `/admin/users/${userId}/delete`;
                                modal.classList.add('show');
                            }

                            function closeDeleteModal() {
                                const modal = document.getElementById('deleteModal');
                                modal.classList.remove('show');
                            }

                            // Close modal on outside click
                            document.getElementById('deleteModal').addEventListener('click', function (e) {
                                if (e.target === this) {
                                    closeDeleteModal();
                                }
                            });
                        </script>
</body>

</html>