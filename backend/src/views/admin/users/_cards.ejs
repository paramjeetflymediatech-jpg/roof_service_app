<% if (users && users.length > 0) { %>
    <% users.forEach(user => { %>
        <div class="bg-white rounded-lg shadow border border-gray-200 p-4">
            <div class="flex justify-between items-start mb-3">
                <div>
                    <h3 class="font-semibold text-gray-900 truncate" title="<%= user.name %>"><%= user.name %></h3>
                    <p class="text-sm text-gray-500 truncate" title="<%= user.email %>"><%= user.email %></p>
                </div>
                <span class="px-2 py-0.5 text-xs font-medium rounded-full <%= user.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                    <%= user.isActive ? 'Active' : 'Inactive' %>
                </span>
            </div>
            <div class="flex items-center justify-between text-sm text-gray-500 mb-4">
                <span class="bg-gray-100 px-2 py-1 rounded text-gray-700 font-medium text-xs">
                    <%= user.role.toUpperCase() %>
                </span>
                <span><%= new Date(user.createdAt).toLocaleDateString("en-GB") %></span>
            </div>
            <div class="flex gap-2 pt-3 border-t border-gray-100">
                <a href="/admin/users/<%= user.id %>/edit" class="flex-1 text-center py-2 bg-indigo-50 text-indigo-700 rounded hover:bg-indigo-100 transition text-sm font-medium flex items-center justify-center gap-2" title="Edit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                    Edit
                </a>
                <button type="button" onclick="confirmDelete('<%= user.id %>', '<%= user.name %>')" class="flex-1 text-center py-2 bg-red-50 text-red-700 rounded hover:bg-red-100 transition text-sm font-medium flex items-center justify-center gap-2" title="Delete">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                    Delete
                </button>
            </div>
        </div>
    <% }) %>
<% } else { %>
    <div class="text-center py-8 bg-white rounded-lg border border-gray-200 text-gray-500">
        No users found
    </div>
<% } %>
