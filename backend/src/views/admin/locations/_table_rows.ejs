<% if (locations && locations.length > 0) { %>
    <% locations.forEach(location => { %>
        <tr>
            <td><strong><%= location.name %></strong></td>
            <td><code><%= location.slug %></code></td>
            <td><%= location.description ? location.description.substring(0, 50) + (location.description.length > 50 ? '...' : '') : '-' %></td>
            <td>
                <% if (location.image) { %>
                    <img src="<%= location.image %>" alt="<%= location.name %>" class="w-12 h-8 object-cover rounded border border-gray-200">
                <% } else { %>
                    <span class="text-gray-400 text-xs">No image</span>
                <% } %>
            </td>
            <td>
                <% 
                    let neighborhoods = [];
                    if (location.neighborhoods) {
                        try {
                            neighborhoods = typeof location.neighborhoods === 'string' ? JSON.parse(location.neighborhoods) : location.neighborhoods;
                        } catch(e) {
                            neighborhoods = [];
                        }
                    }
                %>
                <span class="bg-blue-100 text-blue-800 text-xs font-semibold px-2.5 py-0.5 rounded-full"><%= Array.isArray(neighborhoods) ? neighborhoods.length : 0 %> Neighborhoods</span>
            </td>
            <td>
                <div class="flex gap-2">
                    <a href="/admin/locations/<%= location.id %>/edit" class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-lg transition" title="Edit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                        </svg>
                    </a>
                    <button type="button" onclick="confirmDelete('<%= location.id %>')" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition" title="Delete">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                    </button>
                </div>
            </td>
        </tr>
    <% }) %>
<% } else { %>
    <tr><td colspan="6" class="text-center text-gray-500 py-4">No locations found</td></tr>
<% } %>
