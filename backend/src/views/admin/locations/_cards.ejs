<% if (locations && locations.length > 0) { %>
    <% locations.forEach(location => { %>
        <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 text-black">
            <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-3">
                    <% if (location.image) { %>
                        <img src="<%= location.image %>" alt="<%= location.name %>" class="w-10 h-10 object-cover rounded">
                    <% } else { %>
                        <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center text-blue-600">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-geo-alt-fill" viewBox="0 0 16 16">
                                <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6"/>
                            </svg>
                        </div>
                    <% } %>
                    <div>
                        <h3 class="font-bold text-gray-900"><%= location.name %></h3>
                        <p class="text-xs text-gray-500"><%= location.slug %></p>
                    </div>
                </div>
                <div class="flex gap-2">
                    <a href="/admin/locations/<%= location.id %>/edit" class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-lg transition" title="Edit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                        </svg>
                    </a>
                    <button type="button" onclick="confirmDelete('<%= location.id %>')" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition" title="Delete">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                    </button>
                </div>
            </div>
            <div class="flex gap-4 text-sm text-gray-600">
                <div>
                    <% 
                        let neighborhoods = [];
                        if (location.neighborhoods) {
                            try {
                                neighborhoods = typeof location.neighborhoods === 'string' ? JSON.parse(location.neighborhoods) : location.neighborhoods;
                            } catch(e) {
                                neighborhoods = [];
                            }
                        }
                    %>
                    <span class="text-gray-400">Neighborhoods:</span> <span class="font-medium"><%= Array.isArray(neighborhoods) ? neighborhoods.length : 0 %></span>
                </div>
            </div>
        </div>
    <% }) %>
<% } else { %>
    <div class="col-span-full py-12 text-center bg-white rounded-xl border border-dashed border-gray-300 text-black">
        <p class="text-gray-500">No locations found matching your criteria.</p>
    </div>
<% } %>
