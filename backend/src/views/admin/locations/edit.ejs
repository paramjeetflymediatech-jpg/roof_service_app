<%- include('../../partials/header') %>
<body <% if (error && error.length > 0) { %>data-flash-error="<%= error %>"<% } %> <% if (success && success.length > 0) { %>data-flash-success="<%= success %>"<% } %>>
    <div id="toast-container"></div>
    <div class="admin-wrapper text-black">
        <%- include('../../partials/sidebar') %>
        <main class="main-content">
            <%- include('../../partials/top-header') %>
            <div class="content">
                <div class="page-header">
                    <div class="header-content">
                        <h1>Edit Location</h1>
                        <p>Edit service area location details</p>
                    </div>
                </div>
                <div class="form-card">
                    <form action="/admin/locations/<%= location.id %>" method="POST" class="form-grid">
                        <div class="form-group">
                            <label for="name" class="form-label">Name <span class="text-red-500">*</span></label>
                            <input type="text" id="name" name="name" required class="form-input" value="<%= location.name %>">
                        </div>
                        <div class="form-group">
                            <label for="slug" class="form-label">Slug <span class="text-red-500">*</span></label>
                            <input type="text" id="slug" name="slug" required class="form-input" value="<%= location.slug %>">
                        </div>
                        <div class="form-group full-width">
                            <label for="image" class="form-label">Image URL</label>
                            <input type="text" id="image" name="image" class="form-input" value="<%= location.image %>">
                        </div>
                        <div class="form-group full-width">
                            <label for="description" class="form-label">Description</label>
                            <textarea id="description" name="description" rows="3" class="form-input"><%= location.description %></textarea>
                        </div>
                        <div class="form-group full-width">
                            <label for="neighborhoods" class="form-label">Neighborhoods (One per line)</label>
                            <%
                                let neighborhoodsVal = '';
                                if (location.neighborhoods) {
                                    let nArray = [];
                                    try {
                                        nArray = typeof location.neighborhoods === 'string' ? JSON.parse(location.neighborhoods) : location.neighborhoods;
                                    } catch(e) {
                                        nArray = [];
                                    }
                                    if (Array.isArray(nArray)) {
                                        neighborhoodsVal = nArray.join('\n');
                                    }
                                }
                            %>
                            <textarea id="neighborhoods" name="neighborhoods" rows="6" class="form-input"><%= neighborhoodsVal %></textarea>
                        </div>
                        <div class="form-buttons">
                            <button type="submit" class="btn btn-primary">Update Location</button>
                            <a href="/admin/locations" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>
    <script src="/js/toast.js"></script>
</body>
</html>
