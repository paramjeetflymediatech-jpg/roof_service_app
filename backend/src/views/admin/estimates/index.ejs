<%- include('../../partials/header') %>

<body <% if (error && error.length > 0) { %>data-flash-error="<%= error %>"<% } %>
      <% if (success && success.length > 0) { %>data-flash-success="<%= success %>"<% } %>>

    <div id="toast-container"></div>

    <div class="admin-wrapper">
        <%- include('../../partials/sidebar') %>

        <main class="main-content">
            <%- include('../../partials/top-header') %>

            <div class="content p-6">
                <!-- Page Header & Search -->
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                    <div>
                        <h1 class="text-2xl font-bold text-gray-900 leading-tight">Estimates</h1>
                        <p class="text-gray-500 mt-1">Manage and create professional cost estimates for your clients.</p>
                    </div>
                    
                    <div class="flex flex-col md:flex-row gap-3">
                        <!-- Search & Filter Form -->
                        <form id="searchForm" action="/admin/estimates" method="GET" class="flex flex-col md:flex-row gap-3">
                            <div class="relative flex-1 md:w-64">
                                <input type="text" name="search" id="searchInput" 
                                    value="<%= typeof query !== 'undefined' ? query.search || '' : '' %>"
                                    placeholder="Search estimate #, client..." 
                                    class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 outline-none transition shadow-sm bg-white">
                                <div class="absolute left-3 top-2.5 text-gray-400">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                </div>
                            </div>
                            <select name="status" class="px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 outline-none transition shadow-sm bg-white">
                                <option value="">All Statuses</option>
                                <option value="Draft" <%= typeof query !== 'undefined' && query.status === 'Draft' ? 'selected' : '' %>>Draft</option>
                                <option value="Sent" <%= typeof query !== 'undefined' && query.status === 'Sent' ? 'selected' : '' %>>Sent</option>
                                <option value="Accepted" <%= typeof query !== 'undefined' && query.status === 'Accepted' ? 'selected' : '' %>>Accepted</option>
                                <option value="Rejected" <%= typeof query !== 'undefined' && query.status === 'Rejected' ? 'selected' : '' %>>Rejected</option>
                            </select>
                            <a href="/admin/estimates" class="clear-btn px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition text-sm font-medium flex items-center justify-center">Clear</a>
                        </form>

                        <a href="/admin/estimates/create" 
                           class="inline-flex items-center px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-all shadow-sm hover:shadow-md gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            Create Estimate
                        </a>
                    </div>
                </div>

                <!-- Estimates Table -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead class="bg-gray-50 border-b border-gray-200">
                                <tr>
                                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Number</th>
                                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Client</th>
                                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Date</th>
                                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Total</th>
                                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                                    <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="listTableBody" class="divide-y divide-gray-100">
                                <%- include('./_table_rows') %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div id="paginationContainer">
                    <%- include('./_pagination') %>
                </div>

                <!-- Hidden Card Container for AJAX script compatibility -->
                <div id="listCardContainer" class="hidden"></div>
            </div>
        </main>
    </div>

    <script src="/js/toast.js"></script>
    <script src="/js/list-ajax.js"></script>
</body>
</html>
