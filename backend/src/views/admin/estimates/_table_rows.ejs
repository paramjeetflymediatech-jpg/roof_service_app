<% if (estimates && estimates.length > 0) { %>
    <% estimates.forEach(estimate => { %>
        <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap font-medium text-indigo-600">
                <%= estimate.estimateNumber %>
            </td>
            <td class="px-6 py-4">
                <div class="text-sm font-medium text-gray-900"><%= estimate.clientName %></div>
                <div class="text-xs text-gray-500"><%= estimate.clientEmail %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                <%= new Date(estimate.date).toLocaleDateString() %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">
                $<%= Number(estimate.total || 0).toFixed(2) %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
                <% 
                    let statusClass = "bg-gray-100 text-gray-800";
                    if(estimate.status === 'Accepted') statusClass = "bg-green-100 text-green-800";
                    if(estimate.status === 'Sent') statusClass = "bg-blue-100 text-blue-800";
                    if(estimate.status === 'Rejected') statusClass = "bg-red-100 text-red-800";
                %>
                <div class="flex items-center gap-2">
                    <span class="px-2.5 py-1 rounded-full text-xs font-medium <%= statusClass %>">
                        <%= estimate.status %>
                    </span>
                    <% if (estimate.invoices && estimate.invoices.length > 0) { %>
                        <a href="/admin/invoices/<%= estimate.invoices[0].id %>/preview" target="_blank" class="w-6 h-6 rounded flex items-center justify-center bg-emerald-50 text-emerald-600 hover:bg-emerald-100 transition" title="Invoice Generated">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        </a>
                    <% } %>
                </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right">
                <div class="flex justify-end gap-2">
                    <% if (estimate.status === 'Accepted') { %>
                        <a href="/admin/invoices/generate/<%= estimate.id %>" class="p-2 text-gray-400 hover:text-green-600 hover:bg-green-50 rounded-lg transition" title="Generate Invoice">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        </a>
                    <% } %>
                    <a href="/admin/estimates/<%= estimate.id %>/preview" target="_blank" class="p-2 text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition" title="Preview/Print">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </a>
                    <a href="/admin/estimates/<%= estimate.id %>/edit" class="p-2 text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition" title="Edit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    </a>
                    <form action="/admin/estimates/<%= estimate.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this estimate?');">
                        <input type="hidden" name="_method" value="DELETE">
                        <button type="submit" class="p-2 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition" title="Delete">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        </button>
                    </form>
                </div>
            </td>
        </tr>
    <% }) %>
<% } else { %>
    <tr>
        <td colspan="6" class="px-6 py-12 text-center text-gray-500">
            <div class="flex flex-col items-center">
                <svg class="w-12 h-12 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2z"></path>
                </svg>
                <p class="text-lg font-medium">No estimates found</p>
                <p class="text-sm mt-1">Try adjusting your search or filters.</p>
            </div>
        </td>
    </tr>
<% } %>
