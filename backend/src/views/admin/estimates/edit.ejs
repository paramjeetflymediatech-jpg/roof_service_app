<%- include('../../partials/header') %>

<body class="bg-gray-50">
    <div class="admin-wrapper">
        <%- include('../../partials/sidebar') %>

        <main class="main-content">
            <%- include('../../partials/top-header') %>

            <div class="content p-6">
                <!-- Page Header -->
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                    <div>
                        <a href="/admin/estimates" class="inline-flex items-center text-sm text-gray-500 hover:text-indigo-600 mb-4 transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                            Back to Estimates
                        </a>
                        <h1 class="text-2xl font-bold text-gray-900">Edit Estimate <%= estimate.estimateNumber %></h1>
                        <p class="text-gray-500 mt-1">Update the details of this estimate below.</p>
                    </div>
                    <% if (estimate.leadId) { %>
                        <div class="flex items-center gap-3">
                            <a href="/admin/leads/<%= estimate.leadId %>" class="px-4 py-2 bg-white border border-gray-200 text-gray-700 rounded-lg hover:bg-gray-50 transition flex items-center gap-2 text-sm font-medium">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle></svg>
                                View Linked Lead
                            </a>
                        </div>
                    <% } %>
                </div>

                <form action="/admin/estimates/<%= estimate.id %>" method="POST" id="estimateForm">
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                        <!-- Left Column: Client & Basic Info -->
                        <div class="lg:col-span-2 space-y-8">
                            <!-- Client Details -->
                            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                                <h2 class="text-lg font-semibold text-gray-900 mb-6 flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                    Client Information
                                </h2>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div class="space-y-2">
                                        <label class="block text-sm font-medium text-gray-700">Client Name *</label>
                                        <input type="text" name="clientName" value="<%= estimate.clientName %>" required class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
                                    </div>
                                    <div class="space-y-2">
                                        <label class="block text-sm font-medium text-gray-700">Client Email</label>
                                        <input type="email" name="clientEmail" value="<%= estimate.clientEmail %>" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
                                    </div>
                                    <div class="space-y-2">
                                        <label class="block text-sm font-medium text-gray-700">Client Phone</label>
                                        <input type="text" name="clientPhone" value="<%= estimate.clientPhone %>" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
                                    </div>
                                    <div class="space-y-2">
                                        <label class="block text-sm font-medium text-gray-700">Estimate Date</label>
                                        <input type="date" name="date" value="<%= estimate.date %>" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
                                    </div>
                                    <div class="md:col-span-2 space-y-2">
                                        <label class="block text-sm font-medium text-gray-700">Service Address</label>
                                        <textarea name="clientAddress" rows="2" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all"><%= estimate.clientAddress %></textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- Scope of Work / Items -->
                            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                                <div class="flex items-center justify-between mb-6">
                                    <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                                        Scope of Work
                                    </h2>
                                    <button type="button" id="addItemBtn" class="inline-flex items-center text-sm font-medium text-indigo-600 hover:text-indigo-700 gap-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                        Add Line Item
                                    </button>
                                </div>

                                <div class="space-y-4" id="itemsContainer">
                                    <!-- Items Header -->
                                    <div class="hidden md:grid grid-cols-12 gap-4 px-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                        <div class="col-span-6">Description</div>
                                        <div class="col-span-2">Rate ($)</div>
                                        <div class="col-span-2">Qty</div>
                                        <div class="col-span-2 text-right">Amount</div>
                                    </div>

                                    <!-- Existing Items -->
                                    <% estimate.items.forEach((item, index) => { %>
                                        <div class="item-row grid grid-cols-1 md:grid-cols-12 gap-4 p-4 bg-gray-50 rounded-xl border border-gray-100 relative group">
                                            <div class="col-span-1 md:col-span-6">
                                                <textarea name="items[<%= index %>][description]" rows="2" required class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm"><%= item.description %></textarea>
                                            </div>
                                            <div class="col-span-1 md:col-span-2">
                                                <input type="number" name="items[<%= index %>][rate]" step="0.01" required value="<%= item.rate %>" class="item-rate w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
                                            </div>
                                            <div class="col-span-1 md:col-span-2">
                                                <input type="number" name="items[<%= index %>][qty]" step="1" required value="<%= item.qty %>" class="item-qty w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
                                            </div>
                                            <div class="col-span-1 md:col-span-2 text-right self-center pr-2">
                                                <span class="item-amount text-sm font-semibold text-gray-900">$<%= Number(item.amount || 0).toFixed(2) %></span>
                                            </div>
                                            <button type="button" class="remove-item absolute -right-2 -top-2 bg-white text-red-500 border border-red-100 rounded-full p-1 shadow-sm opacity-0 group-hover:opacity-100 transition-opacity">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                            </button>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Settings & Summary -->
                        <div class="space-y-8">
                            <!-- Summary & Actions -->
                            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 sticky top-6">
                                <h2 class="text-lg font-semibold text-gray-900 mb-6 flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                                    Estimate Summary
                                </h2>
                                
                                <div class="space-y-4 mb-6">
                                    <div class="flex justify-between text-sm text-gray-600">
                                        <span>Subtotal</span>
                                        <span id="subtotalDisplay">$<%= Number(estimate.subtotal || 0).toFixed(2) %></span>
                                    </div>
                                    <div class="flex items-center justify-between text-sm text-gray-600">
                                        <label class="flex items-center gap-2 cursor-pointer">
                                            <input type="checkbox" name="applyGst" id="applyGst" class="rounded text-indigo-600 focus:ring-indigo-500" <%= estimate.applyGst !== false ? 'checked' : '' %>>
                                            <span>GST (5%)</span>
                                        </label>
                                        <span id="gstDisplay">$0.00</span>
                                    </div>
                                    <div class="flex items-center justify-between text-sm text-gray-600">
                                        <label class="flex items-center gap-2 cursor-pointer">
                                            <input type="checkbox" name="applyPst" id="applyPst" class="rounded text-indigo-600 focus:ring-indigo-500" <%= estimate.applyPst ? 'checked' : '' %>>
                                            <span id="pstLabel">PST (<%= estimate.provincialTaxRate || 7 %>%)</span>
                                        </label>
                                        <div class="flex items-center gap-2">
                                            <% const currentTaxKey = `${estimate.provincialTaxRate || 7.0},${estimate.provincialTaxType || 'PST'}`; %>
                                            <select id="provinceTaxSelect" class="text-[10px] border-gray-200 rounded py-0 px-1 focus:ring-indigo-500">
                                                <option value="7.0,PST" <%= currentTaxKey === '7,PST' || currentTaxKey === '7.0,PST' || currentTaxKey === '7.000,PST' ? 'selected' : '' %>>BC (PST 7%)</option>
                                                <option value="6.0,PST" <%= currentTaxKey === '6,PST' || currentTaxKey === '6.0,PST' || currentTaxKey === '6.000,PST' ? 'selected' : '' %>>SK (PST 6%)</option>
                                                <option value="7.0,PST" <%= currentTaxKey === '7,PST' || currentTaxKey === '7.0,PST' || currentTaxKey === '7.000,PST' ? 'selected' : '' %>>MB (PST 7%)</option>
                                                <option value="9.975,QST" <%= currentTaxKey === '9.975,QST' ? 'selected' : '' %>>QC (QST 9.975%)</option>
                                            </select>
                                            <input type="hidden" name="provincialTaxRate" id="provincialTaxRateInput" value="<%= estimate.provincialTaxRate || 7.0 %>">
                                            <input type="hidden" name="provincialTaxType" id="provincialTaxTypeInput" value="<%= estimate.provincialTaxType || 'PST' %>">
                                            <span id="pstDisplay">$0.00</span>
                                        </div>
                                    </div>
                                    <div class="pt-4 border-t border-gray-100 flex justify-between items-center">
                                        <span class="text-base font-bold text-gray-900">Total</span>
                                        <span class="text-xl font-bold text-indigo-600" id="totalDisplay">$<%= Number(estimate.total || 0).toFixed(2) %></span>
                                    </div>
                                </div>

                                <div class="space-y-4">
                                    <div class="space-y-2">
                                        <label class="block text-sm font-medium text-gray-700">Status</label>
                                        <select name="status" class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm">
                                            <option value="Draft" <%= estimate.status === 'Draft' ? 'selected' : '' %>>Draft</option>
                                            <option value="Sent" <%= estimate.status === 'Sent' ? 'selected' : '' %>>Sent</option>
                                            <option value="Accepted" <%= estimate.status === 'Accepted' ? 'selected' : '' %>>Accepted</option>
                                            <option value="Rejected" <%= estimate.status === 'Rejected' ? 'selected' : '' %>>Rejected</option>
                                        </select>
                                    </div>
                                    <div class="space-y-2">
                                        <label class="block text-sm font-medium text-gray-700">Time Estimate</label>
                                        <input type="text" name="timeEstimate" value="<%= estimate.timeEstimate %>" class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm">
                                    </div>
                                    <div class="space-y-2">
                                        <label class="block text-sm font-medium text-gray-700">Expiry Date</label>
                                        <input type="date" name="expiryDate" value="<%= estimate.expiryDate %>" class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm">
                                    </div>
                                    <div class="space-y-2">
                                        <label class="block text-sm font-medium text-gray-700">Notes (Optional)</label>
                                        <textarea name="notes" rows="3" class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm"><%= estimate.notes %></textarea>
                                    </div>
                                </div>

                                <div class="mt-8 space-y-3">
                                    <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl transition-all shadow-lg shadow-indigo-100">
                                        Save Changes
                                    </button>
                                    <a href="/admin/estimates/<%= estimate.id %>/preview" target="_blank" class="block w-full py-3 text-center bg-gray-50 text-gray-700 font-semibold rounded-xl border border-gray-200 hover:bg-gray-100 transition-all">
                                        Preview Report
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </main>
    </div>

    <!-- Template for duplication -->
    <template id="itemRowTemplate">
        <div class="item-row grid grid-cols-1 md:grid-cols-12 gap-4 p-4 bg-gray-50 rounded-xl border border-gray-100 relative group animate-in slide-in-from-top-2 duration-200">
            <div class="col-span-1 md:col-span-6">
                <textarea name="items[INDEX][description]" rows="2" required class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm"></textarea>
            </div>
            <div class="col-span-1 md:col-span-2">
                <input type="number" name="items[INDEX][rate]" step="0.01" required value="0" class="item-rate w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
            </div>
            <div class="col-span-1 md:col-span-2">
                <input type="number" name="items[INDEX][qty]" step="1" required value="1" class="item-qty w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
            </div>
            <div class="col-span-1 md:col-span-2 text-right self-center pr-2">
                <span class="item-amount text-sm font-semibold text-gray-900">$0.00</span>
            </div>
            <button type="button" class="remove-item absolute -right-2 -top-2 bg-white text-red-500 border border-red-100 rounded-full p-1 shadow-sm opacity-0 group-hover:opacity-100 transition-opacity">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>
    </template>

    <script src="/js/toast.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const itemsContainer = document.getElementById('itemsContainer');
            const addItemBtn = document.getElementById('addItemBtn');
            const itemRowTemplate = document.getElementById('itemRowTemplate');
            
            // Initialization
            let rowCount = itemsContainer.querySelectorAll('.item-row').length;

            function updateIndices() {
                const rows = itemsContainer.querySelectorAll('.item-row');
                rows.forEach((row, index) => {
                    const inputs = row.querySelectorAll('input, textarea');
                    inputs.forEach(input => {
                        const name = input.getAttribute('name');
                        if (name) input.setAttribute('name', name.replace(/\[\d+\]/, `[${index}]`));
                    });
                });
                rowCount = rows.length;
            }

            function calculateTotals() {
                let subtotal = 0;
                itemsContainer.querySelectorAll('.item-row').forEach(row => {
                    const rate = parseFloat(row.querySelector('.item-rate').value) || 0;
                    const qty = parseFloat(row.querySelector('.item-qty').value) || 0;
                    const amount = rate * qty;
                    row.querySelector('.item-amount').textContent = `$${amount.toFixed(2)}`;
                    subtotal += amount;
                });
                
                const applyGst = document.getElementById('applyGst').checked;
                const applyPst = document.getElementById('applyPst').checked;
                const gst = applyGst ? subtotal * 0.05 : 0;
                
                const provinceSelect = document.getElementById('provinceTaxSelect');
                const [pRate, pType] = provinceSelect.value.split(',');
                const pstRate = parseFloat(pRate) || 0;
                const pst = applyPst ? subtotal * (pstRate / 100) : 0;
                const total = subtotal + gst + pst;

                // Update hidden inputs and labels
                document.getElementById('provincialTaxRateInput').value = pstRate;
                document.getElementById('provincialTaxTypeInput').value = pType;
                document.getElementById('pstLabel').textContent = `${pType} (${pstRate}%)`;

                document.getElementById('subtotalDisplay').textContent = `$${subtotal.toFixed(2)}`;
                document.getElementById('gstDisplay').textContent = `$${gst.toFixed(2)}`;
                document.getElementById('pstDisplay').textContent = `$${pst.toFixed(2)}`;
                document.getElementById('totalDisplay').textContent = `$${total.toFixed(2)}`;
            }

            document.getElementById('applyGst').addEventListener('change', calculateTotals);
            document.getElementById('applyPst').addEventListener('change', calculateTotals);
            document.getElementById('provinceTaxSelect').addEventListener('change', calculateTotals);

            addItemBtn.addEventListener('click', () => {
                const clone = itemRowTemplate.content.cloneNode(true);
                const newRow = clone.querySelector('.item-row');
                const inputs = newRow.querySelectorAll('input, textarea');
                inputs.forEach(input => {
                    input.setAttribute('name', input.getAttribute('name').replace('INDEX', rowCount));
                });
                itemsContainer.appendChild(newRow);
                rowCount++;
                calculateTotals();
            });

            itemsContainer.addEventListener('click', (e) => {
                if (e.target.closest('.remove-item')) {
                    if (itemsContainer.querySelectorAll('.item-row').length > 1) {
                        e.target.closest('.item-row').remove();
                        updateIndices(); calculateTotals();
                    } else alert('At least one item required.');
                }
            });

            itemsContainer.addEventListener('input', (e) => {
                if (e.target.classList.contains('item-rate') || e.target.classList.contains('item-qty')) calculateTotals();
            });
        });
    </script>
</body>
</html>
