<%- include('../../partials/header') %>

    <body class="bg-gray-50">
        <div class="admin-wrapper">
            <%- include('../../partials/sidebar') %>

                <main class="main-content">
                    <%- include('../../partials/top-header') %>

                        <div class="content p-6">
                            <!-- Page Header -->
                            <div class="mb-8">
                                <a href="/admin/estimates"
                                    class="inline-flex items-center text-sm text-gray-500 hover:text-indigo-600 mb-4 transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round" class="mr-1">
                                        <line x1="19" y1="12" x2="5" y2="12"></line>
                                        <polyline points="12 19 5 12 12 5"></polyline>
                                    </svg>
                                    Back to Estimates
                                </a>
                                <h1 class="text-2xl font-bold text-gray-900">Create New Estimate</h1>
                                <p class="text-gray-500 mt-1">Fill in the details below to generate a professional
                                    estimate.</p>
                            </div>

                            <form action="/admin/estimates" method="POST" id="estimateForm" enctype="multipart/form-data">
                                <% if (typeof lead !=='undefined' && lead) { %>
                                    <input type="hidden" name="leadId" value="<%= lead.id %>">
                                    <% } %>
                                        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                                            <!-- Left Column: Client & Basic Info -->
                                            <div class="lg:col-span-2 space-y-8">
                                                <!-- Client Details -->
                                                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                                                    <h2
                                                        class="text-lg font-semibold text-gray-900 mb-6 flex items-center gap-2">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                            viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                            stroke-width="2" stroke-linecap="round"
                                                            stroke-linejoin="round" class="text-indigo-500">
                                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                                            <circle cx="12" cy="7" r="4"></circle>
                                                        </svg>
                                                        Client Information
                                                    </h2>
                                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                                        <div class="space-y-2">
                                                            <label
                                                                class="block text-sm font-medium text-gray-700">Client
                                                                Name *</label>
                                                            <input type="text" name="clientName" required
                                                                value="<%= typeof lead !== 'undefined' && lead ? lead.name : '' %>"
                                                                class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all"
                                                                placeholder="Enter client name">
                                                        </div>
                                                        <div class="space-y-2">
                                                            <label
                                                                class="block text-sm font-medium text-gray-700">Client
                                                                Email</label>
                                                            <input type="email" name="clientEmail"
                                                                value="<%= typeof lead !== 'undefined' && lead ? lead.email : '' %>"
                                                                class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all"
                                                                placeholder="client@example.com">
                                                        </div>
                                                        <div class="space-y-2">
                                                            <label
                                                                class="block text-sm font-medium text-gray-700">Client
                                                                Phone</label>
                                                            <input type="text" name="clientPhone"
                                                                value="<%= typeof lead !== 'undefined' && lead ? lead.phone : '' %>"
                                                                class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all"
                                                                placeholder="(555) 000-0000">
                                                        </div>
                                                        <div class="space-y-2">
                                                            <label
                                                                class="block text-sm font-medium text-gray-700">Estimate
                                                                Date</label>
                                                            <input type="date" name="date"
                                                                value="<%= new Date().toISOString().split('T')[0] %>"
                                                                class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
                                                        </div>
                                                        <div class="md:col-span-2 space-y-2">
                                                            <label
                                                                class="block text-sm font-medium text-gray-700">Service
                                                                Address</label>
                                                            <textarea name="clientAddress" rows="2"
                                                                class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all"
                                                                placeholder="Enter the job site address"><%= typeof lead !== 'undefined' && lead ? (lead.address + (lead.city ? ', ' + lead.city : '') + (lead.province ? ', ' + lead.province : '')) : '' %></textarea>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Scope of Work / Items -->
                                                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                                                    <div class="flex items-center justify-between mb-6">
                                                        <h2
                                                            class="text-lg font-semibold text-gray-900 flex items-center gap-2">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="20"
                                                                height="20" viewBox="0 0 24 24" fill="none"
                                                                stroke="currentColor" stroke-width="2"
                                                                stroke-linecap="round" stroke-linejoin="round"
                                                                class="text-indigo-500">
                                                                <line x1="8" y1="6" x2="21" y2="6"></line>
                                                                <line x1="8" y1="12" x2="21" y2="12"></line>
                                                                <line x1="8" y1="18" x2="21" y2="18"></line>
                                                                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                                                                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                                                                <line x1="3" y1="18" x2="3.01" y2="18"></line>
                                                            </svg>
                                                            Scope of Work
                                                        </h2>
                                                        <button type="button" id="addItemBtn"
                                                            class="inline-flex items-center text-sm font-medium text-indigo-600 hover:text-indigo-700 gap-1">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16"
                                                                height="16" viewBox="0 0 24 24" fill="none"
                                                                stroke="currentColor" stroke-width="2"
                                                                stroke-linecap="round" stroke-linejoin="round">
                                                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                                            </svg>
                                                            Add Line Item
                                                        </button>
                                                    </div>

                                                    <div class="space-y-4" id="itemsContainer">
                                                        <!-- Items Header -->
                                                        <div
                                                            class="hidden md:grid grid-cols-12 gap-4 px-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                                            <div class="col-span-6">Description</div>
                                                            <div class="col-span-2">Rate ($)</div>
                                                            <div class="col-span-2">Qty</div>
                                                            <div class="col-span-2 text-right">Amount</div>
                                                        </div>

                                                        <!-- First Item Template -->
                                                        <div
                                                            class="item-row grid grid-cols-1 md:grid-cols-12 gap-4 p-4 bg-gray-50 rounded-xl border border-gray-100 relative group">
                                                            <div class="col-span-1 md:col-span-6">
                                                                <textarea name="items[0][description]" rows="2" required
                                                                    class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm"
                                                                    placeholder="Describe the work to be done..."></textarea>
                                                            </div>
                                                            <div class="col-span-1 md:col-span-2">
                                                                <input type="number" name="items[0][rate]" step="0.01"
                                                                    required value="0"
                                                                    class="item-rate w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm"
                                                                    placeholder="0.00">
                                                            </div>
                                                            <div class="col-span-1 md:col-span-2">
                                                                <input type="number" name="items[0][qty]" step="1"
                                                                    required value="1"
                                                                    class="item-qty w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm"
                                                                    placeholder="1">
                                                            </div>
                                                            <div
                                                                class="col-span-1 md:col-span-2 text-right self-center pr-2">
                                                                <span
                                                                    class="item-amount text-sm font-semibold text-gray-900">$0.00</span>
                                                            </div>
                                                            <button type="button"
                                                                class="remove-item absolute -right-2 -top-2 bg-white text-red-500 border border-red-100 rounded-full p-1 shadow-sm opacity-0 group-hover:opacity-100 transition-opacity">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16"
                                                                    height="16" viewBox="0 0 24 24" fill="none"
                                                                    stroke="currentColor" stroke-width="2"
                                                                    stroke-linecap="round" stroke-linejoin="round">
                                                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                                                </svg>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Estimate Images -->
                                                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                                                    <h2 class="text-lg font-semibold text-gray-900 mb-6 flex items-center gap-2">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                                                        Estimate Photos (Max 5)
                                                    </h2>
                                                    <div class="space-y-4">
                                                        <div id="imageDropZone" class="mt-1 flex justify-center px-6 pt-10 pb-10 border-2 border-gray-300 border-dashed rounded-2xl hover:border-indigo-400 transition-all cursor-pointer group relative bg-gray-50/50">
                                                            <div class="space-y-2 text-center">
                                                                <svg class="mx-auto h-12 w-12 text-gray-400 group-hover:text-indigo-500 transition-colors" stroke="currentColor" fill="none" viewBox="0 0 48 48" aria-hidden="true">
                                                                    <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                                                </svg>
                                                                <div class="flex text-sm text-gray-600 justify-center">
                                                                    <label for="estimateImages" class="relative cursor-pointer rounded-md font-bold text-indigo-600 hover:text-indigo-500 focus-within:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                                                                        <span>Click to upload files</span>
                                                                        <input id="estimateImages" name="estimateImages" type="file" multiple accept="image/*" class="sr-only">
                                                                    </label>
                                                                    <p class="pl-1">or drag and drop</p>
                                                                </div>
                                                                <p class="text-xs text-gray-400">Attach site photos or material references (Max 5)</p>
                                                            </div>
                                                        </div>
                                                        <div id="imagePreviewContainer" class="grid grid-cols-2 md:grid-cols-5 gap-4 mt-4"></div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Right Column: Settings & Summary -->
                                            <div class="space-y-8">
                                                <!-- Summary & Actions -->
                                                <div
                                                    class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 sticky top-6">
                                                    <h2
                                                        class="text-lg font-semibold text-gray-900 mb-6 flex items-center gap-2">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                            viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                            stroke-width="2" stroke-linecap="round"
                                                            stroke-linejoin="round" class="text-indigo-500">
                                                            <rect x="1" y="4" width="22" height="16" rx="2" ry="2">
                                                            </rect>
                                                            <line x1="1" y1="10" x2="23" y2="10"></line>
                                                        </svg>
                                                        Estimate Summary
                                                    </h2>

                                                    <div class="space-y-4 mb-6">
                                                        <div class="flex justify-between text-sm text-gray-600">
                                                            <span>Subtotal</span>
                                                            <span id="subtotalDisplay">$0.00</span>
                                                        </div>
                                                        <div
                                                            class="flex items-center justify-between text-sm text-gray-600">
                                                            <label class="flex items-center gap-2 cursor-pointer">
                                                                <input type="checkbox" name="applyGst" id="applyGst"
                                                                    class="rounded text-indigo-600 focus:ring-indigo-500"
                                                                    checked>
                                                                <span>GST (5%)</span>
                                                            </label>
                                                            <span id="gstDisplay">$0.00</span>
                                                        </div>
                                                        <div
                                                            class="flex items-center justify-between text-sm text-gray-600">
                                                            <label class="flex items-center gap-2 cursor-pointer">
                                                                <input type="checkbox" name="applyPst" id="applyPst"
                                                                    class="rounded text-indigo-600 focus:ring-indigo-500">
                                                                <span id="pstLabel">PST (7%)</span>
                                                            </label>
                                                            <div class="flex items-center gap-2">
                                                                <select id="provinceTaxSelect"
                                                                    class="text-[10px] border-gray-200 rounded py-0 px-1 focus:ring-indigo-500">
                                                                    <option value="7.0,PST" selected>BC (PST 7%)
                                                                    </option>
                                                                    <option value="6.0,PST">SK (PST 6%)</option>
                                                                    <option value="7.0,PST">MB (PST 7%)</option>
                                                                    <option value="9.975,QST">QC (QST 9.975%)</option>
                                                                </select>
                                                                <input type="hidden" name="provincialTaxRate"
                                                                    id="provincialTaxRateInput" value="7.0">
                                                                <input type="hidden" name="provincialTaxType"
                                                                    id="provincialTaxTypeInput" value="PST">
                                                                <span id="pstDisplay">$0.00</span>
                                                            </div>
                                                        </div>
                                                        <div
                                                            class="pt-4 border-t border-gray-100 flex justify-between items-center">
                                                            <span class="text-base font-bold text-gray-900">Total</span>
                                                            <span class="text-xl font-bold text-indigo-600"
                                                                id="totalDisplay">$0.00</span>
                                                        </div>
                                                    </div>

                                                    <div class="space-y-4">
                                                        <div class="space-y-2">
                                                            <label class="block text-sm font-medium text-gray-700">Time
                                                                Estimate</label>
                                                            <input type="text" name="timeEstimate"
                                                                class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm"
                                                                placeholder="e.g. 2-3 days">
                                                        </div>
                                                        <div class="space-y-2">
                                                            <label
                                                                class="block text-sm font-medium text-gray-700">Expiry
                                                                Date</label>
                                                            <input type="date" name="expiryDate" required
                                                                class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm">
                                                        </div>
                                                        <div class="space-y-2">
                                                            <label class="block text-sm font-medium text-gray-700">Terms & Conditions</label>
                                                            <textarea name="notes" rows="3"
                                                                class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm"
                                                                placeholder="Add additional terms or specific conditions..."></textarea>
                                                        </div>
                                                    </div>

                                                    <div class="mt-8 space-y-3">
                                                        <button type="submit"
                                                            class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl transition-all shadow-lg shadow-indigo-100 flex items-center justify-center gap-2">
                                                            Create & Preview
                                                        </button>
                                                        <a href="/admin/estimates"
                                                            class="block w-full py-3 text-center text-gray-600 font-medium hover:text-gray-900 transition-colors">
                                                            Cancel
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                            </form>
                        </div>
                </main>
        </div>

        <!-- Hidden Template for New Row -->
        <template id="itemRowTemplate">
            <div
                class="item-row grid grid-cols-1 md:grid-cols-12 gap-4 p-4 bg-gray-50 rounded-xl border border-gray-100 relative group animate-in slide-in-from-top-2 duration-200">
                <div class="col-span-1 md:col-span-6">
                    <textarea name="items[INDEX][description]" rows="2" required
                        class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm"
                        placeholder="Describe the work to be done..."></textarea>
                </div>
                <div class="col-span-1 md:col-span-2">
                    <input type="number" name="items[INDEX][rate]" step="0.01" required value="0"
                        class="item-rate w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm"
                        placeholder="0.00">
                </div>
                <div class="col-span-1 md:col-span-2">
                    <input type="number" name="items[INDEX][qty]" step="1" required value="1"
                        class="item-qty w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm"
                        placeholder="1">
                </div>
                <div class="col-span-1 md:col-span-2 text-right self-center pr-2">
                    <span class="item-amount text-sm font-semibold text-gray-900">$0.00</span>
                </div>
                <button type="button"
                    class="remove-item absolute -right-2 -top-2 bg-white text-red-500 border border-red-100 rounded-full p-1 shadow-sm opacity-0 group-hover:opacity-100 transition-opacity">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
        </template>

        <script src="/js/toast.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const itemsContainer = document.getElementById('itemsContainer');
                const addItemBtn = document.getElementById('addItemBtn');
                const itemRowTemplate = document.getElementById('itemRowTemplate');

                let rowCount = 1;

                // Update row indices to ensure proper form submission
                function updateIndices() {
                    const rows = itemsContainer.querySelectorAll('.item-row');
                    rows.forEach((row, index) => {
                        const inputs = row.querySelectorAll('input, textarea');
                        inputs.forEach(input => {
                            const name = input.getAttribute('name');
                            if (name) {
                                input.setAttribute('name', name.replace(/\[\d+\]/, `[${index}]`));
                            }
                        });
                    });
                    rowCount = rows.length;
                }

                // Calculation Logic
                function calculateTotals() {
                    let subtotal = 0;
                    const rows = itemsContainer.querySelectorAll('.item-row');

                    rows.forEach(row => {
                        const rate = parseFloat(row.querySelector('.item-rate').value) || 0;
                        const qty = parseFloat(row.querySelector('.item-qty').value) || 0;
                        const amount = rate * qty;

                        row.querySelector('.item-amount').textContent = `$${amount.toFixed(2)}`;
                        subtotal += amount;
                    });

                    const applyGst = document.getElementById('applyGst').checked;
                    const applyPst = document.getElementById('applyPst').checked;
                    const gst = applyGst ? subtotal * 0.05 : 0;

                    const provinceSelect = document.getElementById('provinceTaxSelect');
                    const [pRate, pType] = provinceSelect.value.split(',');
                    const pstRate = parseFloat(pRate) || 0;
                    const pst = applyPst ? subtotal * (pstRate / 100) : 0;
                    const total = subtotal + gst + pst;

                    // Update hidden inputs and labels
                    document.getElementById('provincialTaxRateInput').value = pstRate;
                    document.getElementById('provincialTaxTypeInput').value = pType;
                    document.getElementById('pstLabel').textContent = `${pType} (${pstRate}%)`;

                    document.getElementById('subtotalDisplay').textContent = `$${subtotal.toFixed(2)}`;
                    document.getElementById('gstDisplay').textContent = `$${gst.toFixed(2)}`;
                    document.getElementById('pstDisplay').textContent = `$${pst.toFixed(2)}`;
                    document.getElementById('totalDisplay').textContent = `$${total.toFixed(2)}`;
                }

                document.getElementById('applyGst').addEventListener('change', calculateTotals);
                document.getElementById('applyPst').addEventListener('change', calculateTotals);
                document.getElementById('provinceTaxSelect').addEventListener('change', calculateTotals);

                // Add new row
                addItemBtn.addEventListener('click', () => {
                    const clone = itemRowTemplate.content.cloneNode(true);
                    const newRow = clone.querySelector('.item-row');

                    // Set initial name attributes with correct index
                    const inputs = newRow.querySelectorAll('input, textarea');
                    inputs.forEach(input => {
                        const name = input.getAttribute('name');
                        input.setAttribute('name', name.replace('INDEX', rowCount));
                    });

                    itemsContainer.appendChild(newRow);
                    rowCount++;
                    calculateTotals();
                });

                // Remove row
                itemsContainer.addEventListener('click', (e) => {
                    if (e.target.closest('.remove-item')) {
                        const rows = itemsContainer.querySelectorAll('.item-row');
                        if (rows.length > 1) {
                            e.target.closest('.item-row').remove();
                            updateIndices();
                            calculateTotals();
                        } else {
                            showToast('Estimate must have at least one line item.', 'error');
                        }
                    }
                });

                // Input change events for live calculation
                itemsContainer.addEventListener('input', (e) => {
                    if (e.target.classList.contains('item-rate') || e.target.classList.contains('item-qty')) {
                        calculateTotals();
                    }
                });

                // Form validation
                document.getElementById('estimateForm').addEventListener('submit', function (e) {
                    const rows = itemsContainer.querySelectorAll('.item-row');
                    if (rows.length === 0) {
                        e.preventDefault();
                        showToast('Please add at least one line item.', 'error');
                    }
                });

                // Image Preview Logic
                const estimateImagesInput = document.getElementById('estimateImages');
                const imagePreviewContainer = document.getElementById('imagePreviewContainer');
                let selectedFiles = [];

                if (estimateImagesInput) {
                    estimateImagesInput.addEventListener('change', function() {
                        const newFiles = Array.from(this.files);
                        
                        if (selectedFiles.length + newFiles.length > 5) {
                            showToast('Maximum 5 images allowed total', 'error');
                            this.value = '';
                            return;
                        }

                        selectedFiles = [...selectedFiles, ...newFiles];
                        renderPreviews();
                        updateInputFiles();
                    });
                }

                function updateInputFiles() {
                    const dt = new DataTransfer();
                    selectedFiles.forEach(file => dt.items.add(file));
                    estimateImagesInput.files = dt.files;
                }

                function renderPreviews() {
                    imagePreviewContainer.innerHTML = '';
                    selectedFiles.forEach((file, index) => {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            const div = document.createElement('div');
                            div.className = 'relative aspect-square rounded-lg overflow-hidden border border-gray-200 group animate-in zoom-in-95';
                            div.innerHTML = `
                                <img src="${e.target.result}" class="w-full h-full object-cover">
                                <button type="button" onclick="removeNewFile(${index})" class="absolute top-1 right-1 bg-red-500 text-white p-1 rounded-full opacity-0 group-hover:opacity-100 transition-all hover:bg-red-600 shadow-md">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                </button>
                            `;
                            imagePreviewContainer.appendChild(div);
                        }
                        reader.readAsDataURL(file);
                    });
                }

                window.removeNewFile = function(index) {
                    selectedFiles.splice(index, 1);
                    renderPreviews();
                    updateInputFiles();
                };

                // Drag and Drop Logic
                const dropZone = document.getElementById('imageDropZone');
                if (dropZone && estimateImagesInput) {
                    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                        dropZone.addEventListener(eventName, (e) => {
                            e.preventDefault();
                            e.stopPropagation();
                        }, false);
                    });

                    ['dragenter', 'dragover'].forEach(eventName => {
                        dropZone.addEventListener(eventName, () => {
                            dropZone.classList.add('border-indigo-500', 'bg-indigo-50/80');
                        }, false);
                    });

                    ['dragleave', 'drop'].forEach(eventName => {
                        dropZone.addEventListener(eventName, () => {
                            dropZone.classList.remove('border-indigo-500', 'bg-indigo-50/80');
                        }, false);
                    });

                    dropZone.addEventListener('drop', (e) => {
                        const dt = e.dataTransfer;
                        const files = Array.from(dt.files);
                        
                        if (selectedFiles.length + files.length > 5) {
                            showToast('Maximum 5 images allowed total', 'error');
                            return;
                        }

                        selectedFiles = [...selectedFiles, ...files];
                        renderPreviews();
                        updateInputFiles();
                    }, false);

                    dropZone.addEventListener('click', (e) => {
                        if (e.target.closest('label')) return;
                        estimateImagesInput.click();
                    });
                }

                // Initial calculation
                calculateTotals();
            });

            // Simple toast if toast.js isn't available
            function showToast(message, type) {
                if (window.showToastMessage) {
                    window.showToastMessage(message, type);
                } else {
                    alert(message);
                }
            }
        </script>
    </body>

    </html>