  <%- include('../../partials/header') %>

<body class="bg-gray-50">
    <div class="admin-wrapper">
        <%- include('../../partials/sidebar') %>

            <main class="main-content">
<%- include('../../partials/top-header') %>

                <div class="content">
                    <!-- Page Header & Search -->
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                        <div class="header-content">
                            <h1 class="text-2xl font-bold text-gray-900 leading-tight">Blog Management</h1>
                            <p class="text-gray-500 mt-1">Manage your blog posts and articles</p>
                        </div>
                        
                        <div class="flex flex-col md:flex-row gap-3">
                            <!-- Search & Filter Form -->
                            <form id="searchForm" action="/admin/blogs" method="GET" class="flex flex-col md:flex-row gap-3">
                                <div class="relative flex-1 md:w-64">
                                    <input type="text" name="search" id="searchInput" 
                                        value="<%= typeof query !== 'undefined' ? query.search || '' : '' %>"
                                        placeholder="Search title, author..." 
                                        class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 outline-none transition shadow-sm bg-white">
                                    <div class="absolute left-3 top-2.5 text-gray-400">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                    </div>
                                </div>
                                <select name="status" class="px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 outline-none transition shadow-sm bg-white">
                                    <option value="">All Statuses</option>
                                    <option value="published" <%= typeof query !== 'undefined' && query.status === 'published' ? 'selected' : '' %>>Published</option>
                                    <option value="draft" <%= typeof query !== 'undefined' && query.status === 'draft' ? 'selected' : '' %>>Draft</option>
                                </select>
                                <a href="/admin/blogs" class="clear-btn px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition text-sm font-medium flex items-center justify-center">Clear</a>
                            </form>

                            <a href="/admin/blogs/create"
                                class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition flex items-center gap-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                Create New Blog
                            </a>
                        </div>
                    </div>

                    <!-- Stats Quick View -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                        <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-indigo-500">
                            <p class="text-sm font-medium text-gray-500 uppercase">Total Blogs</p>
                            <p class="text-2xl font-bold text-gray-900">
                                <%= blogs.length %>
                            </p>
                        </div>
                        <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-green-500">
                            <p class="text-sm font-medium text-gray-500 uppercase">Published</p>
                            <p class="text-2xl font-bold text-gray-900">
                                <%= blogs.filter(b=> b.status === 'published').length %>
                            </p>
                        </div>
                        <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-yellow-500">
                            <p class="text-sm font-medium text-gray-500 uppercase">Drafts</p>
                            <p class="text-2xl font-bold text-gray-900">
                                <%= blogs.filter(b=> b.status === 'draft').length %>
                            </p>
                        </div>
                    </div>

                    <!-- Blog List Table -->
                    <div class="bg-white shadow-lg rounded-xl overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full table-fixed">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th
                                            class="w-1/4 px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                            Title</th>
                                        <th
                                            class="w-1/6 px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden md:table-cell">
                                            Status</th>
                                        <th
                                            class="w-1/6 px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden md:table-cell">
                                            Author</th>
                                        <th
                                            class="w-1/6 px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden sm:table-cell">
                                            Date</th>
                                        <th
                                            class="w-24 px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                            Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="listTableBody" class="divide-y divide-gray-200">
                                    <%- include('./_table_rows') %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                    <div id="paginationContainer">
                        <%- include('./_pagination') %>
                    </div>

                    <!-- Hidden Card Container for AJAX script compatibility -->
                    <div id="listCardContainer" class="hidden"></div>
                </div>
            </main>
        </div>
    <script src="/js/toast.js"></script>
    <script src="/js/list-ajax.js"></script>
</body>

</html>