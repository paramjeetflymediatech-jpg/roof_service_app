<%- include('../../partials/header') %>

<body class="bg-gray-50">
    <div class="admin-wrapper">
        <%- include('../../partials/sidebar') %>

        <main class="main-content">
            <%- include('../../partials/top-header') %>

            <div class="content p-6">
                <!-- Page Header -->
                <div class="mb-8">
                    <a href="/admin/invoices" class="inline-flex items-center text-sm text-gray-500 hover:text-indigo-600 mb-4 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                        Back to Invoices
                    </a>
                    <h1 class="text-2xl font-bold text-gray-900">Create New Invoice</h1>
                    <p class="text-gray-500 mt-1">Fill in the details below to generate a professional invoice for completed work.</p>
                </div>

                <form action="/admin/invoices" method="POST" id="invoiceForm">
                    <% if (typeof estimate !== 'undefined' && estimate) { %>
                        <input type="hidden" name="estimateId" value="<%= estimate.id %>">
                    <% } %>
                    <% if (typeof lead !== 'undefined' && lead) { %>
                        <input type="hidden" name="leadId" value="<%= lead.id %>">
                    <% } %>
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                        <!-- Left Column: Client & Basic Info -->
                        <div class="lg:col-span-2 space-y-8">
                            <!-- Client Details -->
                            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                                <h2 class="text-lg font-semibold text-gray-900 mb-6 flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                    Client Information
                                </h2>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div class="space-y-2">
                                        <label class="block text-sm font-medium text-gray-700">Client Name *</label>
                                        <input type="text" name="clientName" required value="<%= typeof estimate !== 'undefined' && estimate ? estimate.clientName : (typeof lead !== 'undefined' && lead ? lead.name : '') %>" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="Enter client name">
                                    </div>
                                    <div class="space-y-2">
                                        <label class="block text-sm font-medium text-gray-700">Client Email</label>
                                        <input type="email" name="clientEmail" value="<%= typeof estimate !== 'undefined' && estimate ? estimate.clientEmail : (typeof lead !== 'undefined' && lead ? lead.email : '') %>" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="client@example.com">
                                    </div>
                                    <div class="space-y-2">
                                        <label class="block text-sm font-medium text-gray-700">Client Phone</label>
                                        <input type="text" name="clientPhone" value="<%= typeof estimate !== 'undefined' && estimate ? estimate.clientPhone : (typeof lead !== 'undefined' && lead ? lead.phone : '') %>" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="(555) 000-0000">
                                    </div>
                                    <div class="space-y-2">
                                        <label class="block text-sm font-medium text-gray-700">Invoice Date</label>
                                        <input type="date" name="date" value="<%= new Date().toISOString().split('T')[0] %>" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all">
                                    </div>
                                    <div class="md:col-span-2 space-y-2">
                                        <label class="block text-sm font-medium text-gray-700">Service Address</label>
                                        <textarea name="clientAddress" rows="2" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" placeholder="Enter the job site address"><%= typeof estimate !== 'undefined' && estimate ? estimate.clientAddress : (typeof lead !== 'undefined' && lead ? lead.address : '') %></textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- Scope of Work / Items -->
                            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                                <div class="flex items-center justify-between mb-6">
                                    <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                                        Invoiced Items
                                    </h2>
                                    <button type="button" id="addItemBtn" class="inline-flex items-center text-sm font-medium text-indigo-600 hover:text-indigo-700 gap-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                        Add Line Item
                                    </button>
                                </div>

                                <div class="space-y-4" id="itemsContainer">
                                    <!-- Items Header -->
                                    <div class="hidden md:grid grid-cols-12 gap-4 px-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                        <div class="col-span-6">Description</div>
                                        <div class="col-span-2">Rate ($)</div>
                                        <div class="col-span-2">Qty</div>
                                        <div class="col-span-2 text-right">Amount</div>
                                    </div>

                                    <% if (typeof estimate !== 'undefined' && estimate && estimate.items && estimate.items.length > 0) { %>
                                        <% estimate.items.forEach((item, index) => { %>
                                            <div class="item-row grid grid-cols-1 md:grid-cols-12 gap-4 p-4 bg-gray-50 rounded-xl border border-gray-100 relative group">
                                                <div class="col-span-1 md:col-span-6">
                                                    <textarea name="items[<%= index %>][description]" rows="2" required class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm" placeholder="Describe the work to be done..."><%= item.description %></textarea>
                                                </div>
                                                <div class="col-span-1 md:col-span-2">
                                                    <input type="number" name="items[<%= index %>][rate]" step="0.01" required value="<%= item.rate %>" class="item-rate w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm" placeholder="0.00">
                                                </div>
                                                <div class="col-span-1 md:col-span-2">
                                                    <input type="number" name="items[<%= index %>][qty]" step="0.01" required value="<%= item.qty %>" class="item-qty w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm" placeholder="1">
                                                </div>
                                                <div class="col-span-1 md:col-span-2 text-right self-center pr-2">
                                                    <span class="item-amount text-sm font-semibold text-gray-900">$<%= (Number(item.rate) * Number(item.qty)).toFixed(2) %></span>
                                                </div>
                                                <button type="button" class="remove-item absolute -right-2 -top-2 bg-white text-red-500 border border-red-100 rounded-full p-1 shadow-sm opacity-0 group-hover:opacity-100 transition-opacity">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                </button>
                                            </div>
                                        <% }) %>
                                    <% } else { %>
                                        <!-- First Item Template -->
                                        <div class="item-row grid grid-cols-1 md:grid-cols-12 gap-4 p-4 bg-gray-50 rounded-xl border border-gray-100 relative group">
                                            <div class="col-span-1 md:col-span-6">
                                                <textarea name="items[0][description]" rows="2" required class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm" placeholder="Describe the work to be done..."></textarea>
                                            </div>
                                            <div class="col-span-1 md:col-span-2">
                                                <input type="number" name="items[0][rate]" step="0.01" required value="0" class="item-rate w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm" placeholder="0.00">
                                            </div>
                                            <div class="col-span-1 md:col-span-2">
                                                <input type="number" name="items[0][qty]" step="1" required value="1" class="item-qty w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm" placeholder="1">
                                            </div>
                                            <div class="col-span-1 md:col-span-2 text-right self-center pr-2">
                                                <span class="item-amount text-sm font-semibold text-gray-900">$0.00</span>
                                            </div>
                                            <button type="button" class="remove-item absolute -right-2 -top-2 bg-white text-red-500 border border-red-100 rounded-full p-1 shadow-sm opacity-0 group-hover:opacity-100 transition-opacity">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                            </button>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Settings & Summary -->
                        <div class="space-y-8">
                            <!-- Summary & Actions -->
                            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 sticky top-6">
                                <h2 class="text-lg font-semibold text-gray-900 mb-6 flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                                    Invoice Summary
                                </h2>

                                <% if (typeof workHours !== 'undefined' && workHours > 0) { %>
                                    <div class="mb-6 p-4 bg-blue-50 rounded-xl border border-blue-100">
                                        <div class="flex items-center justify-between mb-3">
                                            <div class="flex items-center gap-2 text-blue-700">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                                <span class="text-sm font-semibold">Tracked Hours</span>
                                            </div>
                                            <span class="text-base font-bold text-blue-700"><%= workHours %> Hours</span>
                                        </div>
                                        <div class="space-y-3">
                                            <div class="flex items-center gap-2">
                                                <div class="text-[10px] text-blue-600 font-bold uppercase whitespace-nowrap">Rate/hr ($)</div>
                                                <input type="number" id="trackedLaborRate" value="100" class="w-full px-2 py-1 text-sm border border-blue-200 rounded focus:ring-1 focus:ring-blue-500">
                                            </div>
                                            <button type="button" id="addLaborAsItemBtn" data-hours="<%= workHours %>" class="w-full py-2 bg-blue-600 text-white text-xs font-bold rounded-lg hover:bg-blue-700 transition-all shadow-sm">
                                                Add to Invoice ($<span id="trackedLaborTotal"><%= (workHours * 100).toFixed(2) %></span>)
                                            </button>
                                        </div>
                                    </div>
                                <% } %>

                                <!-- Manual Work Period Calculator -->
                                <div class="mb-6 p-4 bg-gray-50 rounded-xl border border-gray-200">
                                    <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3 text-center">Work Period Calculator</h3>
                                    <div class="grid grid-cols-2 gap-3 mb-3">
                                        <div class="space-y-1">
                                            <label class="text-[10px] text-gray-400 uppercase">Start Time</label>
                                            <input type="time" id="manualStartTime" class="w-full px-2 py-1 text-sm border border-gray-300 rounded focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500">
                                        </div>
                                        <div class="space-y-1">
                                            <label class="text-[10px] text-gray-400 uppercase">End Time</label>
                                            <input type="time" id="manualEndTime" class="w-full px-2 py-1 text-sm border border-gray-300 rounded focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500">
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2 mb-3">
                                        <div class="text-[10px] text-gray-500 font-bold uppercase whitespace-nowrap">Rate/hr ($)</div>
                                        <input type="number" id="manualLaborRate" value="100" class="w-full px-2 py-1 text-sm border border-gray-300 rounded focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500">
                                    </div>
                                    <button type="button" id="calculateManualHoursBtn" class="w-full py-2 bg-gray-200 text-gray-700 text-xs font-bold rounded-lg hover:bg-gray-300 transition-all">
                                        Calculate & Add Hours
                                    </button>
                                </div>
                                
                                <div class="space-y-4 mb-6">
                                    <div class="flex justify-between text-sm text-gray-600">
                                        <span>Subtotal</span>
                                        <span id="subtotalDisplay">$0.00</span>
                                    </div>
                                    <div class="flex items-center justify-between text-sm text-gray-600">
                                        <label class="flex items-center gap-2 cursor-pointer">
                                            <input type="checkbox" name="applyGst" id="applyGst" class="rounded text-indigo-600 focus:ring-indigo-500" checked>
                                            <span>GST (5%)</span>
                                        </label>
                                        <span id="gstDisplay">$0.00</span>
                                    </div>
                                    <div class="flex items-center justify-between text-sm text-gray-600">
                                        <label class="flex items-center gap-2 cursor-pointer">
                                            <input type="checkbox" name="applyPst" id="applyPst" class="rounded text-indigo-600 focus:ring-indigo-500">
                                            <span id="pstLabel">PST (7%)</span>
                                        </label>
                                        <div class="flex items-center gap-2">
                                            <select id="provinceTaxSelect" class="text-[10px] border-gray-200 rounded py-0 px-1 focus:ring-indigo-500">
                                                <option value="7.0,PST" selected>BC (PST 7%)</option>
                                                <option value="6.0,PST">SK (PST 6%)</option>
                                                <option value="7.0,PST">MB (PST 7%)</option>
                                                <option value="9.975,QST">QC (QST 9.975%)</option>
                                            </select>
                                            <input type="hidden" name="provincialTaxRate" id="provincialTaxRateInput" value="7.0">
                                            <input type="hidden" name="provincialTaxType" id="provincialTaxTypeInput" value="PST">
                                            <span id="pstDisplay">$0.00</span>
                                        </div>
                                    </div>
                                    <div class="pt-4 border-t border-gray-100 flex justify-between items-center">
                                        <span class="text-base font-bold text-gray-900">Total</span>
                                        <span class="text-xl font-bold text-indigo-600" id="totalDisplay">$0.00</span>
                                    </div>
                                </div>

                                <div class="space-y-4">
                                    <div class="space-y-2">
                                        <label class="block text-sm font-medium text-gray-700">Due Date</label>
                                        <input type="date" name="dueDate" value="<%= new Date(Date.now() + 14 * 24 * 60 * 60 * 1000).toISOString().split('T')[0] %>" class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm">
                                    </div>
                                    <div class="space-y-2">
                                        <label class="block text-sm font-medium text-gray-700">Notes (Optional)</label>
                                        <textarea name="notes" rows="3" class="w-full px-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 text-sm" placeholder="Add additional terms or payment instructions..."><%= typeof estimate !== 'undefined' && estimate ? estimate.notes : '' %></textarea>
                                    </div>
                                </div>

                                <div class="mt-8 space-y-3">
                                    <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl transition-all shadow-lg shadow-indigo-100 flex items-center justify-center gap-2">
                                        Create & Preview
                                    </button>
                                    <a href="/admin/invoices" class="block w-full py-3 text-center text-gray-600 font-medium hover:text-gray-900 transition-colors">
                                        Cancel
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </main>
    </div>

    <!-- Hidden Template for New Row -->
    <template id="itemRowTemplate">
        <div class="item-row grid grid-cols-1 md:grid-cols-12 gap-4 p-4 bg-gray-50 rounded-xl border border-gray-100 relative group animate-in slide-in-from-top-2 duration-200">
            <div class="col-span-1 md:col-span-6">
                <textarea name="items[INDEX][description]" rows="2" required class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm" placeholder="Describe the work to be done..."></textarea>
            </div>
            <div class="col-span-1 md:col-span-2">
                <input type="number" name="items[INDEX][rate]" step="0.01" required value="0" class="item-rate w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm" placeholder="0.00">
            </div>
            <div class="col-span-1 md:col-span-2">
                <input type="number" name="items[INDEX][qty]" step="0.01" required value="1" class="item-qty w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm" placeholder="1">
            </div>
            <div class="col-span-1 md:col-span-2 text-right self-center pr-2">
                <span class="item-amount text-sm font-semibold text-gray-900">$0.00</span>
            </div>
            <button type="button" class="remove-item absolute -right-2 -top-2 bg-white text-red-500 border border-red-100 rounded-full p-1 shadow-sm opacity-0 group-hover:opacity-100 transition-opacity">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>
    </template>

    <script src="/js/toast.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const itemsContainer = document.getElementById('itemsContainer');
            const addItemBtn = document.getElementById('addItemBtn');
            const itemRowTemplate = document.getElementById('itemRowTemplate');
            
            // Update row indices to ensure proper form submission
            function updateIndices() {
                const rows = itemsContainer.querySelectorAll('.item-row');
                rows.forEach((row, index) => {
                    const inputs = row.querySelectorAll('input, textarea');
                    inputs.forEach(input => {
                        const name = input.getAttribute('name');
                        if (name) {
                            input.setAttribute('name', name.replace(/\[\d+\]/, `[${index}]`));
                        }
                    });
                });
            }

            // Calculation Logic
            function calculateTotals() {
                let subtotal = 0;
                const rows = itemsContainer.querySelectorAll('.item-row');
                
                rows.forEach(row => {
                    const rate = parseFloat(row.querySelector('.item-rate').value) || 0;
                    const qty = parseFloat(row.querySelector('.item-qty').value) || 0;
                    const amount = rate * qty;
                    
                    row.querySelector('.item-amount').textContent = `$${amount.toFixed(2)}`;
                    subtotal += amount;
                });

                const applyGst = document.getElementById('applyGst').checked;
                const applyPst = document.getElementById('applyPst').checked;
                const gst = applyGst ? subtotal * 0.05 : 0;
                
                const provinceSelect = document.getElementById('provinceTaxSelect');
                const [pRate, pType] = provinceSelect.value.split(',');
                const pstRate = parseFloat(pRate) || 0;
                const pst = applyPst ? subtotal * (pstRate / 100) : 0;
                const total = subtotal + gst + pst;

                // Update hidden inputs and labels
                document.getElementById('provincialTaxRateInput').value = pstRate;
                document.getElementById('provincialTaxTypeInput').value = pType;
                document.getElementById('pstLabel').textContent = `${pType} (${pstRate}%)`;

                document.getElementById('subtotalDisplay').textContent = `$${subtotal.toFixed(2)}`;
                document.getElementById('gstDisplay').textContent = `$${gst.toFixed(2)}`;
                document.getElementById('pstDisplay').textContent = `$${pst.toFixed(2)}`;
                document.getElementById('totalDisplay').textContent = `$${total.toFixed(2)}`;
            }

            document.getElementById('applyGst').addEventListener('change', calculateTotals);
            document.getElementById('applyPst').addEventListener('change', calculateTotals);
            document.getElementById('provinceTaxSelect').addEventListener('change', calculateTotals);

            // Add new row
            addItemBtn.addEventListener('click', () => {
                const rows = itemsContainer.querySelectorAll('.item-row');
                const nextIndex = rows.length;
                
                const clone = itemRowTemplate.content.cloneNode(true);
                const newRow = clone.querySelector('.item-row');
                
                // Set initial name attributes with correct index
                const inputs = newRow.querySelectorAll('input, textarea');
                inputs.forEach(input => {
                    const name = input.getAttribute('name');
                    input.setAttribute('name', name.replace('INDEX', nextIndex));
                });

                itemsContainer.appendChild(newRow);
                calculateTotals();
            });

            // Add Labor from tracked hours
            const addLaborAsItemBtn = document.getElementById('addLaborAsItemBtn');
            const trackedLaborRateInput = document.getElementById('trackedLaborRate');
            const trackedLaborTotalDisplay = document.getElementById('trackedLaborTotal');

            if (trackedLaborRateInput) {
                trackedLaborRateInput.addEventListener('input', () => {
                    const hours = parseFloat(addLaborAsItemBtn.dataset.hours) || 0;
                    const rate = parseFloat(trackedLaborRateInput.value) || 0;
                    trackedLaborTotalDisplay.textContent = (hours * rate).toFixed(2);
                });
            }

            if (addLaborAsItemBtn) {
                addLaborAsItemBtn.addEventListener('click', () => {
                    const hours = addLaborAsItemBtn.dataset.hours;
                    const rate = trackedLaborRateInput ? trackedLaborRateInput.value : 0;
                    const rows = itemsContainer.querySelectorAll('.item-row');
                    const nextIndex = rows.length;
                    
                    const clone = itemRowTemplate.content.cloneNode(true);
                    const newRow = clone.querySelector('.item-row');
                    
                    const inputs = newRow.querySelectorAll('input, textarea');
                    inputs.forEach(input => {
                        const name = input.getAttribute('name');
                        if (name.includes('description')) {
                            input.value = 'Tracked Work Hours';
                        }
                        if (name.includes('qty')) {
                            input.value = hours;
                        }
                        if (name.includes('rate')) {
                            input.value = rate;
                        }
                        input.setAttribute('name', name.replace('INDEX', nextIndex));
                    });
                
                    itemsContainer.appendChild(newRow);
                    calculateTotals();
                    if (window.showToast) {
                        window.showToast('Work hours added to invoice items.', 'success');
                    }
                });
            }

            // Manual Time Calculator Logic
            const calculateManualHoursBtn = document.getElementById('calculateManualHoursBtn');
            const manualStartTimeInput = document.getElementById('manualStartTime');
            const manualEndTimeInput = document.getElementById('manualEndTime');
            const manualLaborRateInput = document.getElementById('manualLaborRate');

            if (calculateManualHoursBtn) {
                calculateManualHoursBtn.addEventListener('click', () => {
                    const start = manualStartTimeInput.value;
                    const end = manualEndTimeInput.value;
                    const rate = manualLaborRateInput ? manualLaborRateInput.value : 0;

                    if (!start || !end) {
                        alert('Please enter both start and end times.');
                        return;
                    }

                    const [sH, sM] = start.split(':').map(Number);
                    const [eH, eM] = end.split(':').map(Number);

                    let startT = sH + (sM / 60);
                    let endT = eH + (eM / 60);

                    let diff = endT - startT;
                    if (diff < 0) diff += 24; // overnight wrap

                    if (diff === 0) {
                        alert('Start and end times cannot be the same.');
                        return;
                    }

                    const hours = diff.toFixed(2);
                    
                    // Add as item
                    const rows = itemsContainer.querySelectorAll('.item-row');
                    const nextIndex = rows.length;
                    
                    const clone = itemRowTemplate.content.cloneNode(true);
                    const newRow = clone.querySelector('.item-row');
                    
                    const inputs = newRow.querySelectorAll('input, textarea');
                    inputs.forEach(input => {
                        const name = input.getAttribute('name');
                        if (name.includes('description')) {
                            input.value = `Work Hours (${start} - ${end})`;
                        }
                        if (name.includes('qty')) {
                            input.value = hours;
                        }
                        if (name.includes('rate')) {
                            input.value = rate;
                        }
                        input.setAttribute('name', name.replace('INDEX', nextIndex));
                    });

                    itemsContainer.appendChild(newRow);
                    calculateTotals();
                    if (window.showToast) {
                        window.showToast(`Manual Work Hours (${hours} hrs @ $${rate}/hr) added.`, 'success');
                    }
                });
            }

            // Remove row
            itemsContainer.addEventListener('click', (e) => {
                if (e.target.closest('.remove-item')) {
                    const rows = itemsContainer.querySelectorAll('.item-row');
                    if (rows.length > 1) {
                        e.target.closest('.item-row').remove();
                        updateIndices();
                        calculateTotals();
                    } else {
                        showToast('Invoice must have at least one line item.', 'error');
                    }
                }
            });

            // Input change events for live calculation
            itemsContainer.addEventListener('input', (e) => {
                if (e.target.classList.contains('item-rate') || e.target.classList.contains('item-qty')) {
                    calculateTotals();
                }
            });

            // Form validation
            document.getElementById('invoiceForm').addEventListener('submit', function(e) {
                const rows = itemsContainer.querySelectorAll('.item-row');
                if (rows.length === 0) {
                    e.preventDefault();
                    showToast('Please add at least one line item.', 'error');
                }
            });

            // Initial calculation
            calculateTotals();
        });

        // Simple toast if toast.js isn't available
        function showToast(message, type) {
            if (window.showToastMessage) {
                window.showToastMessage(message, type);
            } else {
                alert(message);
            }
        }
    </script>
</body>
</html>
