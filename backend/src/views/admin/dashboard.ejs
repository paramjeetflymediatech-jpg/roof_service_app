  <%- include('../partials/header') %>

<body <% if (error && error.length> 0) { %>data-flash-error="<%= error %>"<% } %>
            <% if (success && success.length> 0) { %>data-flash-success="<%= success %>"<% } %>
                        >
                        <!-- Toast Container -->
                        <div id="toast-container"></div>

                        <div class="admin-wrapper">
                            <%- include('../partials/sidebar') %>

                                <main class="main-content">
<%- include('../partials/top-header') %>

                                    <div class="content">
                                        <!-- Welcome Banner -->
                                        <div class="welcome-banner">
                                            <div class="banner-content">
                                                <h1>Welcome back, <%= userName %>! 👋</h1>
                                                <p>Here's what's happening with your roofing service business today</p>
                                            </div>
                                            <div class="banner-decoration">
                                                <div class="decoration-circle"></div>
                                                <div class="decoration-circle-2"></div>
                                            </div>
                                        </div>

                                        <!-- Stats Grid with Enhanced Design -->
                                        <div class="stats-header">
                                            <h2>Key Metrics</h2>
                                            <p>Real-time business insights</p>
                                        </div>

                                        <div class="stats-grid">
                                            <div class="stat-card stat-card-primary">
                                                <div class="stat-top">
                                                    <div class="stat-icon">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"
                                                            viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                            stroke-width="2">
                                                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                                            <circle cx="9" cy="7" r="4"></circle>
                                                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                                        </svg>
                                                    </div>
                                                    <div class="stat-trend">↑ 12%</div>
                                                </div>
                                                <div class="stat-info">
                                                    <h3>
                                                        <%= stats.totalUsers %>
                                                    </h3>
                                                    <p>Total Users</p>
                                                </div>
                                            </div>

                                            <div class="stat-card stat-card-success">
                                                <div class="stat-top">
                                                    <div class="stat-icon">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"
                                                            viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                            stroke-width="2">
                                                            <path d="M9 11l3 3L22 3"></path>
                                                            <path
                                                                d="M20 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h11">
                                                            </path>
                                                        </svg>
                                                    </div>
                                                    <div class="stat-trend">↑ 8%</div>
                                                </div>
                                                <div class="stat-info">
                                                    <h3>
                                                        <%= stats.totalLeads %>
                                                    </h3>
                                                    <p>Total Leads</p>
                                                </div>
                                            </div>

                                            <div class="stat-card stat-card-info">
                                                <div class="stat-top">
                                                    <div class="stat-icon">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"
                                                            viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                            stroke-width="2">
                                                            <path
                                                                d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2m-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z">
                                                            </path>
                                                        </svg>
                                                    </div>
                                                    <div class="stat-trend">↑ 24%</div>
                                                </div>
                                                <div class="stat-info">
                                                    <h3>
                                                        <%= stats.newLeads %>
                                                    </h3>
                                                    <p>New Leads</p>
                                                </div>
                                            </div>

                                            <div class="stat-card stat-card-warning">
                                                <div class="stat-top">
                                                    <div class="stat-icon">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"
                                                            viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                            stroke-width="2">
                                                            <circle cx="12" cy="12" r="10"></circle>
                                                            <polyline points="12 6 12 12 16 14"></polyline>
                                                        </svg>
                                                    </div>
                                                    <div class="stat-trend">↓ 5%</div>
                                                </div>
                                                <div class="stat-info">
                                                    <h3>
                                                        <%= stats.inProgressLeads %>
                                                    </h3>
                                                    <p>In Progress</p>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Quick Actions Section -->
                                        <div class="quick-actions-section">
                                            <div class="section-header">
                                                <h2>Quick Actions</h2>
                                                <p>Access key features instantly</p>
                                            </div>
                                            <div class="quick-links-grid">
                                                <a href="/admin/users" class="quick-link-card card-blue">
                                                    <div class="card-top">
                                                        <div class="card-icon">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="28"
                                                                height="28" viewBox="0 0 24 24" fill="none"
                                                                stroke="currentColor" stroke-width="2">
                                                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2">
                                                                </path>
                                                                <circle cx="9" cy="7" r="4"></circle>
                                                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                                            </svg>
                                                        </div>
                                                    </div>
                                                    <div class="card-content">
                                                        <h3>Manage Users</h3>
                                                        <p>Add, edit or delete users from the system</p>
                                                    </div>
                                                    <div class="card-arrow">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                            viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                            stroke-width="2">
                                                            <line x1="5" y1="12" x2="19" y2="12"></line>
                                                            <polyline points="12 5 19 12 12 19"></polyline>
                                                        </svg>
                                                    </div>
                                                </a>
                                                <a href="/admin/leads" class="quick-link-card card-green">
                                                    <div class="card-top">
                                                        <div class="card-icon">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="28"
                                                                height="28" viewBox="0 0 24 24" fill="none"
                                                                stroke="currentColor" stroke-width="2">
                                                                <path d="M9 11l3 3L22 3"></path>
                                                                <path
                                                                    d="M20 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h11">
                                                                </path>
                                                            </svg>
                                                        </div>
                                                    </div>
                                                    <div class="card-content">
                                                        <h3>Manage Leads</h3>
                                                        <p>Track and manage all customer leads</p>
                                                    </div>
                                                    <div class="card-arrow">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                            viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                            stroke-width="2">
                                                            <line x1="5" y1="12" x2="19" y2="12"></line>
                                                            <polyline points="12 5 19 12 12 19"></polyline>
                                                        </svg>
                                                    </div>
                                                </a>

                                            </div>
                                        </div>
                                    </div>
                                </main>
                        </div>

                        <script src="/js/toast.js"></script>
</body>

</html>