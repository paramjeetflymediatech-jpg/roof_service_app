<%- include('../../partials/header') %>

<body <% if (error && error.length > 0) { %>data-flash-error="<%= error %>"<% } %>
    <% if (success && success.length > 0) { %>data-flash-success="<%= success %>"<% } %>>
    
    <!-- Toast Container -->
    <div id="toast-container"></div>

    <div class="admin-wrapper">
        <%- include('../../partials/sidebar') %>

        <main class="main-content">
<%- include('../../partials/top-header') %>

            <div class="content">
                <!-- Action Bar -->
                <div class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    <div>
                        <h1 class="text-2xl font-bold text-gray-800">Gallery</h1>
                        <p class="text-gray-500 mt-1">Manage your portfolio images</p>
                    </div>
                    <a href="/admin/gallery/create" class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition shadow-lg shadow-blue-200">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        Add New Image
                    </a>
                </div>

                <!-- Breadcrumbs -->
                <nav class="flex mb-6 text-gray-500 text-sm" aria-label="Breadcrumb">
                    <ol class="inline-flex items-center space-x-1 md:space-x-3">
                        <% breadcrumbs.forEach((crumb, index) => { %>
                            <li class="inline-flex items-center">
                                <% if (index > 0) { %>
                                    <svg class="w-4 h-4 mx-2 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                                    </svg>
                                <% } %>
                                <% if (crumb.url !== "#") { %>
                                    <a href="<%= crumb.url %>" class="hover:text-blue-600 transition-colors">
                                        <%= crumb.name %>
                                    </a>
                                <% } else { %>
                                    <span class="text-gray-900 font-medium"><%= crumb.name %></span>
                                <% } %>
                            </li>
                        <% }); %>
                    </ol>
                </nav>

                <!-- Grid Layout -->
                <div class="<%= viewMode === 'images' ? 'columns-1 sm:columns-2 md:columns-3 lg:columns-4' : 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4' %> gap-6 space-y-6">
                    <% if (items.length === 0) { %>
                        <div class="break-inside-avoid col-span-full items-center justify-center text-center py-16 bg-white rounded-2xl border-2 border-dashed border-gray-200">
                            <div class="bg-gray-50 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4">
                                <svg class="h-10 w-10 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <h3 class="text-lg font-medium text-gray-900">No content here</h3>
                            <p class="mt-2 text-gray-500 max-w-sm mx-auto">This folder appears to be empty.</p>
                            <a href="/admin/gallery/create" class="mt-6 inline-flex text-blue-600 font-medium hover:text-blue-700">
                                Upload Image &rarr;
                            </a>
                        </div>
                    <% } %>

                    <% if (viewMode === 'folders' || viewMode === 'subfolders') { %>
                        <% items.forEach(folder => { %>
                            <a href="<%= folder.url %>" class="block group">
                                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl hover:border-blue-100 transition-all duration-300">
                                    <div class="flex items-center justify-between mb-4">
                                        <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300">
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                                            </svg>
                                        </div>
                                        <span class="text-xs font-medium text-gray-400 bg-gray-50 px-3 py-1 rounded-full"><%= folder.count %> photos</span>
                                    </div>
                                    <h3 class="text-gray-800 font-bold text-lg group-hover:text-blue-600 transition-colors"><%= folder.name %></h3>
                                    <p class="text-gray-500 text-sm mt-1">View collection &rarr;</p>
                                </div>
                            </a>
                        <% }); %>
                    <% } else { %>
                        <% items.forEach(item => { %>
                            <div class="gallery-card break-inside-avoid mb-6 bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-xl transition-all duration-300 group relative cursor-pointer"
                                 data-image-url="<%= process.env.BACKEND_URL %><%= item.imageUrl %>"
                                 data-title="<%= item.title %>"
                                 data-category="<%= item.category || 'Uncategorized' %>"
                                 data-date="<%= new Date(item.createdAt).toLocaleDateString() %>"
                                 data-id="<%= item.id %>">
                                <div class="relative overflow-hidden pointer-events-none">
                                    <img src="<%= process.env.BACKEND_URL %><%= item.imageUrl %>" class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-700" alt="<%= item.title %>">
                                    
                                    <!-- Overlay on hover -->
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-5 pointer-events-auto">
                                        <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300 pointer-events-none">
                                            <h3 class="text-white font-bold text-lg truncate leading-tight" title="<%= item.title %>">
                                                <%= item.title %>
                                            </h3>
                                            <p class="text-gray-300 text-sm mb-4 mt-1">
                                                <%= item.category || 'Uncategorized' %> <% if (item.location) { %> • <%= item.location %><% } %>
                                            </p>
                                            <div class="flex justify-between items-center pointer-events-auto">
                                                <span class="text-xs text-white/80 bg-white/20 backdrop-blur-md px-3 py-1 rounded-full border border-white/10">
                                                    <%= new Date(item.createdAt).toLocaleDateString() %>
                                                </span>
                                                <div class="delete-btn-wrapper" onclick="event.stopPropagation()">
                                                    <form action="/admin/gallery/<%= item.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this image?');">
                                                        <button type="submit" class="p-2 bg-red-500 hover:bg-red-600 text-white rounded-full transition shadow-lg shadow-red-500/30 transform hover:scale-110 active:scale-95">
                                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                                            </svg>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>

                <% if (totalPages > 1 && viewMode === 'images') { %>
                    <div class="pagination mt-8 flex justify-center">
                        <% if (currentPage > 1) { %>
                            <a href="/admin/gallery?page=<%= currentPage - 1 %>&location=<%= encodeURIComponent(location) %>&category=<%= encodeURIComponent(category) %>"
                                class="px-4 py-2 border rounded-lg mx-1 hover:bg-gray-100 transition text-gray-700">Previous</a>
                        <% } %>

                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <a href="/admin/gallery?page=<%= i %>&location=<%= encodeURIComponent(location) %>&category=<%= encodeURIComponent(category) %>"
                                class="px-4 py-2 border rounded-lg mx-1 <%= currentPage === i ? 'bg-blue-600 text-white border-blue-600' : 'text-gray-700 hover:bg-gray-100' %> transition">
                                <%= i %>
                            </a>
                        <% } %>

                        <% if (currentPage < totalPages) { %>
                            <a href="/admin/gallery?page=<%= currentPage + 1 %>&location=<%= encodeURIComponent(location) %>&category=<%= encodeURIComponent(category) %>"
                                class="px-4 py-2 border rounded-lg mx-1 hover:bg-gray-100 transition text-gray-700">Next</a>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </main>
    </div>  
    <script src="/js/toast.js"></script>
</body>

</html>
