<% if (services && services.length > 0) { %>
    <% services.forEach(service => { %>
        <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap"><%= service.name %></td>
            <td class="px-6 py-4 whitespace-nowrap">
                <% if (service.category) { %>
                    <span class="bg-gray-100 text-gray-800 text-xs font-semibold px-2.5 py-0.5 rounded"><%= service.category.name %></span>
                <% } else { %>
                    <span class="text-gray-400">-</span>
                <% } %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap"><code><%= service.slug %></code></td>
            <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-0.5 text-xs font-medium rounded-full <%= service.status === 'published' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                    <%= service.status ? service.status.toUpperCase() : 'DRAFT' %>
                </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex gap-2">
                    <a href="/admin/services/<%= service.id %>/edit" class="p-2 text-yellow-600 hover:bg-yellow-50 rounded-lg transition" title="Edit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    </a>
                    <button onclick="confirmDelete('<%= service.id %>')" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition" title="Delete">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                    </button>
                </div>
            </td>
        </tr>
    <% }) %>
<% } else { %>
    <tr>
        <td colspan="5" class="px-6 py-10 text-center text-gray-500">
            <div class="flex flex-col items-center">
                <svg class="w-12 h-12 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <p class="text-lg font-medium">No services found</p>
                <p class="text-sm">Try adjusting your search or filters</p>
            </div>
        </td>
    </tr>
<% } %>
