<%- include('../../partials/header') %>

    <body <% if (error && error.length> 0) { %>data-flash-error="<%= error %>"<% } %>
                <% if (success && success.length> 0) { %>data-flash-success="<%= success %>"<% } %>>
                            <div id="toast-container"></div>
                            <div class="admin-wrapper">
                                <%- include('../../partials/sidebar') %>
                                    <main class="main-content">
                                        <%- include('../../partials/top-header') %>
                                            <div class="content">
                                                <div class="page-header">
                                                    <div class="header-content">
                                                        <h1>Edit Service</h1>
                                                        <p>Edit service details</p>
                                                    </div>
                                                </div>
                                                <div class="form-card">
                                                    <form action="/admin/services/<%= service.id %>" method="POST"
                                                        enctype="multipart/form-data" class="form-grid">
                                                        <div class="form-group">
                                                            <label for="name" class="form-label">Name <span
                                                                    class="text-red-500">*</span></label>
                                                            <input type="text" id="name" name="name" required
                                                                class="form-input" value="<%= service.name %>">
                                                        </div>
                                                        <div class="form-group">
                                                            <label for="slug" class="form-label">Slug <span
                                                                    class="text-red-500">*</span></label>
                                                            <input type="text" id="slug" name="slug" required
                                                                class="form-input" value="<%= service.slug %>">
                                                        </div>

                                                        <div class="form-group">
                                                            <label for="categoryId" class="form-label">Category</label>
                                                            <select id="categoryId" name="categoryId"
                                                                class="form-input">
                                                                <option value="">Select Category</option>
                                                                <% categories.forEach(category=> { %>
                                                                    <option value="<%= category.id %>"
                                                                        <%=service.categoryId==category.id ? 'selected'
                                                                        : '' %>><%= category.name %>
                                                                    </option>
                                                                    <% }); %>
                                                            </select>
                                                        </div>

                                                        <div class="form-group">
                                                            <label for="status" class="form-label">Status</label>
                                                            <select id="status" name="status" class="form-input">
                                                                <option value="draft" <%=service.status==='draft'
                                                                    ? 'selected' : '' %>>Draft</option>
                                                                <option value="published"
                                                                    <%=service.status==='published' ? 'selected' : '' %>
                                                                    >Published</option>
                                                                <option value="archived" <%=service.status==='archived'
                                                                    ? 'selected' : '' %>>Archived</option>
                                                            </select>
                                                        </div>

                                                         <div class="form-group full-width text-black">
                                                             <label class="form-label font-bold text-gray-700 mb-2 block">Connect to Locations</label>
                                                             <div class="relative w-full" id="locationDropdownContainer">
                                                                 <button type="button" id="locationDropdownBtn" class="w-full px-4 py-2.5 text-left border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white flex justify-between items-center shadow-sm">
                                                                     <span id="selectedLocationsLabel" class="truncate text-gray-500">Select Locations</span>
                                                                     <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                         <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                                                     </svg>
                                                                 </button>
                                                                 <div id="locationDropdownMenu" class="absolute left-0 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg z-50 hidden max-h-60 overflow-y-auto p-2">
                                                                     <div class="flex flex-col gap-1">
                                                                         <% locations.forEach(location => { %>
                                                                             <% 
                                                                                 let isChecked = false;
                                                                                 if (service.locationIds && Array.isArray(service.locationIds)) {
                                                                                     isChecked = service.locationIds.includes(location.id);
                                                                                 }
                                                                             %>
                                                                             <label class="flex items-center gap-2 cursor-pointer p-2 hover:bg-gray-50 rounded transition">
                                                                                 <input type="checkbox" name="locationIds" value="<%= location.id %>" <%= isChecked ? 'checked' : '' %> class="location-checkbox rounded text-indigo-600 focus:ring-indigo-500">
                                                                                 <span class="text-sm font-medium text-gray-700"><%= location.name %></span>
                                                                             </label>
                                                                         <% }); %>
                                                                     </div>
                                                                 </div>
                                                             </div>
                                                             <p class="text-xs text-gray-500 mt-1">Select the locations where this service should be available. If none are selected, the service will be available globally in all locations.</p>
                                                         </div>

                                                        <div class="form-group">
                                                            <label for="icon" class="form-label">Icon (Emoji or
                                                                URL)</label>
                                                            <input type="text" id="icon" name="icon" class="form-input"
                                                                value="<%= service.icon %>">
                                                        </div>

                                                        <div class="form-group">
                                                            <label for="basePrice" class="form-label">Base Price
                                                                ($)</label>
                                                            <input type="number" id="basePrice" name="basePrice"
                                                                step="0.01" class="form-input"
                                                                value="<%= service.basePrice %>">
                                                        </div>

                                                        <div class="form-group full-width">
                                                            <label for="image" class="form-label">Featured Image</label>
                                                            <% if (service.featuredImageUrl) { %>
                                                                <div class="mb-2">
                                                                    <img src="<%= service.featuredImageUrl.startsWith('http') ? service.featuredImageUrl : process.env.BACKEND_URL + service.featuredImageUrl %>"
                                                                        alt="Current Image"
                                                                        class="h-20 w-auto rounded border border-gray-200">
                                                                </div>
                                                                <% } %>
                                                                    <input type="file" id="image" name="image"
                                                                        class="form-input" accept="image/*">
                                                                    <p class="text-xs text-gray-500 mt-1">Or provide URL
                                                                        below</p>
                                                                    <input type="text" name="featuredImageUrl"
                                                                        class="form-input mt-2"
                                                                        value="<%= service.featuredImageUrl %>"
                                                                        placeholder="https://example.com/image.jpg">
                                                        </div>

                                                        <div class="form-group full-width">
                                                            <label for="whyChooseUs" class="form-label">Why Choose Us
                                                                (One item per line)</label>
                                                            <textarea id="whyChooseUs" name="whyChooseUs" rows="5"
                                                                class="form-input"><%= service.whyChooseUs ? (Array.isArray(service.whyChooseUs) ? service.whyChooseUs.join('\n') : service.whyChooseUs) : '' %></textarea>
                                                        </div>

                                                        <div class="form-group full-width">
                                                            <label for="shortDescription" class="form-label">Short
                                                                Description</label>
                                                            <textarea id="shortDescription" name="shortDescription"
                                                                rows="2"
                                                                class="form-input"><%= service.shortDescription %></textarea>
                                                        </div>

                                                         <div class="form-group full-width">
                                                             <label for="longDescription" class="form-label">Service Content</label>
                                                             <textarea id="longDescription" name="longDescription"
                                                                 rows="10" class="form-input"
                                                                 placeholder="Enter service description..."><%= service.longDescription %></textarea>
                                                         </div>
 

                                                        <div class="form-buttons">
                                                            <button type="submit" class="btn btn-primary">Update
                                                                Service</button>
                                                            <a href="/admin/services"
                                                                class="btn btn-secondary">Cancel</a>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                    </main>
                            </div>
                            <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
                            <style>
                                .ck-editor__editable_inline {
                                    min-height: 300px;
                                    border-bottom-left-radius: 0.5rem !important;
                                    border-bottom-right-radius: 0.5rem !important;
                                }
                                .ck-editor__top {
                                    border-top-left-radius: 0.5rem !important;
                                    border-top-right-radius: 0.5rem !important;
                                }
                                .ck.ck-editor {
                                    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
                                    border-radius: 0.5rem;
                                    margin-top: 0.5rem;
                                }
                                .ck.ck-editor__editable:not(.ck-editor__nested-editable).ck-focused {
                                    border-color: #6366f1 !important;
                                    box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2) !important;
                                }
                            </style>
                            <script src="/js/toast.js"></script>
                            <script>
                                let editorInstance = null;

                                window.addEventListener('DOMContentLoaded', () => {
                                    ClassicEditor.create(document.getElementById('longDescription'), {
                                        toolbar: [
                                            'heading', '|', 'bold', 'italic', 'link', 'bulletedList', 'numberedList', 
                                            'blockQuote', 'insertTable', 'undo', 'redo'
                                        ]
                                    }).then(editor => {
                                        editorInstance = editor;
                                    }).catch(error => {
                                        console.error("CKEditor initialization failed:", error);
                                    });
                                });

                                const mainForm = document.querySelector('form');
                                if (mainForm) {
                                    mainForm.addEventListener('submit', () => {
                                        if (editorInstance) {
                                            document.getElementById('longDescription').value = editorInstance.getData();
                                        }
                                    });
                                }

                                // Handle location dropdown toggles and labels
                                const dropdownBtn = document.getElementById('locationDropdownBtn');
                                const dropdownMenu = document.getElementById('locationDropdownMenu');
                                const checkboxes = document.querySelectorAll('.location-checkbox');
                                const label = document.getElementById('selectedLocationsLabel');

                                if (dropdownBtn && dropdownMenu) {
                                    dropdownBtn.addEventListener('click', (e) => {
                                        e.stopPropagation();
                                        dropdownMenu.classList.toggle('hidden');
                                    });

                                    document.addEventListener('click', (e) => {
                                        if (!dropdownMenu.contains(e.target) && e.target !== dropdownBtn) {
                                            dropdownMenu.classList.add('hidden');
                                        }
                                    });

                                    function updateLabel() {
                                        const selected = [];
                                        checkboxes.forEach((cb) => {
                                            if (cb.checked) {
                                                selected.push(cb.nextElementSibling.textContent.trim());
                                            }
                                        });
                                        if (selected.length > 0) {
                                            label.textContent = selected.join(', ');
                                            label.classList.remove('text-gray-500');
                                            label.classList.add('text-gray-900');
                                        } else {
                                            label.textContent = 'Select Locations';
                                            label.classList.remove('text-gray-900');
                                            label.classList.add('text-gray-500');
                                        }
                                    }

                                    checkboxes.forEach((cb) => {
                                        cb.addEventListener('change', updateLabel);
                                    });

                                    updateLabel();
                                }
                            </script>
    </body>

    </html>