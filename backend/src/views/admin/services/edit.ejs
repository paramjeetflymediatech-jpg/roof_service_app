  <%- include('../../partials/header') %>
<body <% if (error && error.length > 0) { %>data-flash-error="<%= error %>"<% } %> <% if (success && success.length > 0) { %>data-flash-success="<%= success %>"<% } %>>
    <div id="toast-container"></div>
    <div class="admin-wrapper">
        <%- include('../../partials/sidebar') %>
        <main class="main-content">
<%- include('../../partials/top-header') %>
            <div class="content">
                <div class="page-header">
                    <div class="header-content">
                        <h1>Edit Service</h1>
                        <p>Edit service details</p>
                    </div>
                </div>
                <div class="form-card">
                    <form action="/admin/services/<%= service.id %>" method="POST" enctype="multipart/form-data" class="form-grid">
                        <div class="form-group">
                            <label for="name" class="form-label">Name <span class="text-red-500">*</span></label>
                            <input type="text" id="name" name="name" required class="form-input" value="<%= service.name %>">
                        </div>
                        <div class="form-group">
                            <label for="slug" class="form-label">Slug <span class="text-red-500">*</span></label>
                            <input type="text" id="slug" name="slug" required class="form-input" value="<%= service.slug %>">
                        </div>
                        
                        <div class="form-group">
                            <label for="categoryId" class="form-label">Category</label>
                            <select id="categoryId" name="categoryId" class="form-input">
                                <option value="">Select Category</option>
                                <% categories.forEach(category => { %>
                                    <option value="<%= category.id %>" <%= service.categoryId == category.id ? 'selected' : '' %>><%= category.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label for="status" class="form-label">Status</label>
                            <select id="status" name="status" class="form-input">
                                <option value="draft" <%= service.status === 'draft' ? 'selected' : '' %>>Draft</option>
                                <option value="published" <%= service.status === 'published' ? 'selected' : '' %>>Published</option>
                                <option value="archived" <%= service.status === 'archived' ? 'selected' : '' %>>Archived</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="icon" class="form-label">Icon (Emoji or URL)</label>
                            <input type="text" id="icon" name="icon" class="form-input" value="<%= service.icon %>">
                        </div>

                        <div class="form-group">
                            <label for="basePrice" class="form-label">Base Price ($)</label>
                            <input type="number" id="basePrice" name="basePrice" step="0.01" class="form-input" value="<%= service.basePrice %>">
                        </div>
                        
                        <div class="form-group full-width">
                            <label for="image" class="form-label">Featured Image</label>
                            <% if (service.featuredImageUrl) { %>
                                <div class="mb-2">
                                    <img src="<%= service.featuredImageUrl.startsWith('http') ? service.featuredImageUrl : process.env.BACKEND_URL + service.featuredImageUrl %>" alt="Current Image" class="h-20 w-auto rounded border border-gray-200">
                                </div>
                            <% } %>
                            <input type="file" id="image" name="image" class="form-input" accept="image/*">
                            <p class="text-xs text-gray-500 mt-1">Or provide URL below</p>
                            <input type="text" name="featuredImageUrl" class="form-input mt-2" value="<%= service.featuredImageUrl %>" placeholder="https://example.com/image.jpg">
                        </div>

                        <div class="form-group full-width">
                            <label for="whyChooseUs" class="form-label">Why Choose Us (One item per line)</label>
                            <textarea id="whyChooseUs" name="whyChooseUs" rows="5" class="form-input"><%= service.whyChooseUs ? (Array.isArray(service.whyChooseUs) ? service.whyChooseUs.join('\n') : service.whyChooseUs) : '' %></textarea>
                        </div>

                        <div class="form-group full-width">
                            <label for="shortDescription" class="form-label">Short Description</label>
                            <textarea id="shortDescription" name="shortDescription" rows="2" class="form-input"><%= service.shortDescription %></textarea>
                        </div>

                        <div class="form-group full-width">
                            <label for="longDescription" class="form-label">Long Description</label>
                            <textarea id="longDescription" name="longDescription" rows="5" class="form-input"><%= service.longDescription %></textarea>
                        </div>

                        <div class="form-group full-width">
                            <label for="heading" class="form-label">Service Heading</label>
                            <input type="text" id="heading" name="heading" class="form-input" value="<%= service.heading %>" placeholder="e.g. Expert Roofing Solutions">
                        </div>

                        <div class="form-group full-width">
                            <label for="subHeading" class="form-label">Secondary Heading</label>
                            <input type="text" id="subHeading" name="subHeading" class="form-input" value="<%= service.subHeading %>" placeholder="e.g. Why Choose Our Installation?">
                        </div>

                        <div class="form-group full-width">
                            <label for="subDescription" class="form-label">Secondary Description</label>
                            <textarea id="subDescription" name="subDescription" rows="4" class="form-input" placeholder="Detailed secondary information about this service..."><%= service.subDescription %></textarea>
                        </div>

                        <div class="form-buttons">
                            <button type="submit" class="btn btn-primary">Update Service</button>
                            <a href="/admin/services" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>
    <script src="/js/toast.js"></script>
</body>
</html>
