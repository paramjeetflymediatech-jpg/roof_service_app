<% if (services && services.length > 0) { %>
    <% services.forEach(service => { %>
        <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 mb-4">
            <div class="flex gap-4 mb-3">
                <div class="w-16 h-16 rounded-lg overflow-hidden flex-shrink-0 bg-gray-100">
                    <% if (service.featuredImageUrl) { %>
                        <img src="<%= service.featuredImageUrl %>" alt="<%= service.name %>" class="w-full h-full object-cover">
                    <% } else { %>
                        <div class="w-full h-full flex items-center justify-center text-gray-400">
                            <i class="<%= service.icon || 'fas fa-tools' %> fa-lg"></i>
                        </div>
                    <% } %>
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="font-bold text-gray-900 truncate"><%= service.name %></h3>
                    <p class="text-xs text-gray-500 mb-1"><%= service.category ? service.category.name : 'No Category' %></p>
                    <div class="flex items-center gap-2">
                        <span class="px-2 py-0.5 rounded-full text-xs font-medium 
                            <%= service.status === 'published' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' %>">
                            <%= service.status.charAt(0).toUpperCase() + service.status.slice(1) %>
                        </span>
                        <% if (service.basePrice) { %>
                            <span class="text-xs font-semibold text-gray-900">$<%= service.basePrice %></span>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end gap-2 pt-3 border-t border-gray-50">
                <a href="/admin/services/<%= service.id %>/edit" class="flex-1 text-center py-2 px-4 bg-blue-50 text-blue-600 rounded-lg hover:bg-blue-100 transition text-sm font-medium">
                    Edit
                </a>
                <button onclick="confirmDelete('<%= service.id %>')" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                </button>
            </div>
        </div>
    <% }) %>
<% } else { %>
    <div class="col-span-full py-12 text-center bg-white rounded-xl border border-dashed border-gray-300">
        <p class="text-gray-500">No services found.</p>
    </div>
<% } %>
