                                                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                                            </svg>
                                                            Add New Lead
                                                        </a>
                                            </div>
                                        </div>

                                        <!-- Stats Quick View -->
                                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                                            <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-blue-500">
                                                <p class="text-sm font-medium text-gray-500 uppercase">Total Leads</p>
                                                <p class="text-2xl font-bold text-gray-900">
                                                    <%= totalLeads %>
                                                </p>
                                            </div>
                                            <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-yellow-500">
                                                <p class="text-sm font-medium text-gray-500 uppercase">Pending Review
                                                </p>
                                                <p class="text-2xl font-bold text-gray-900">
                                                    <%= leads.filter(l=> l.status === 'new' || l.status ===
                                                        'pending').length %>
                                                </p>
                                            </div>
                                            <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-green-500">
                                                <p class="text-sm font-medium text-gray-500 uppercase">completed</p>
                                                <p class="text-2xl font-bold text-gray-900">
                                                    <%= leads.filter(l=> l.status === 'completed').length %>
                                                </p>
                                            </div>
                                        </div>

                                        <!-- Mobile View (Cards) -->
                                        <div class="block md:hidden space-y-4">
                                            <% if (leads.length===0) { %>
                                                <div
                                                    class="text-center py-8 bg-white rounded-lg border border-gray-200 text-gray-500">
                                                    <div class="flex flex-col items-center">
                                                        <svg class="w-12 h-12 text-gray-300 mb-4" fill="none"
