                                                            </div>

                                                            <div
                                                                class="flex items-center justify-between text-sm text-gray-500 mb-4 bg-gray-50 p-2 rounded">
                                                                <span
                                                                    class="badge badge-type text-xs px-2 py-1 rounded">
                                                                    <%= lead.leadType %>
                                                                </span>
                                                                <span class="text-xs">
                                                                    <%= new Date(lead.createdAt).toLocaleDateString() %>
                                                                </span>
                                                            </div>

                                                            <div class="flex gap-2 pt-2 border-t border-gray-100">
                                                                <a href="/admin/leads/<%= lead.id %>/edit"
                                                                    class="flex-1 text-center py-2 bg-indigo-50 text-indigo-700 rounded hover:bg-indigo-100 transition text-sm font-medium flex items-center justify-center gap-1">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16"
                                                                        height="16" viewBox="0 0 24 24" fill="none"
                                                                        stroke="currentColor" stroke-width="2"
                                                                        stroke-linecap="round" stroke-linejoin="round">
                                                                        <path
                                                                            d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7">
                                                                        </path>
                                                                        <path
                                                                            d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z">
                                                                        </path>
                                                                    </svg>
                                                                    Edit
                                                                </a>
                                                                <a href="/admin/leads/<%= lead.id %>"
                                                                    class="flex-1 text-center py-2 bg-blue-50 text-blue-700 rounded hover:bg-blue-100 transition text-sm font-medium flex items-center justify-center gap-1">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                                        <circle cx="12" cy="12" r="3"></circle>
                                                                    </svg>
                                                                    View
                                                                </a>
                                                                <form action="/admin/leads/<%= lead.id %>/delete"
                                                                    method="POST"
                                                                    onsubmit="return confirm('Are you sure you want to delete this lead?');"
                                                                    class="flex-1">
                                                                    <button type="submit"
                                                                        class="w-full py-2 bg-red-50 text-red-700 rounded hover:bg-red-100 transition text-sm font-medium flex items-center justify-center gap-1">
                                                                        <svg xmlns="http://www.w3.org/2000/svg"
                                                                            width="16" height="16" viewBox="0 0 24 24"
                                                                            fill="none" stroke="currentColor"
                                                                            stroke-width="2" stroke-linecap="round"
                                                                            stroke-linejoin="round">
                                                                            <polyline points="3 6 5 6 21 6"></polyline>
                                                                            <path
                                                                                d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                                            </path>
                                                                        </svg>
                                                                        Delete
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        </div>
                                                        <% }) %>
                                                            <% } %>
                                        </div>

                                        <div
                                            class="hidden md:block table-container shadow-lg rounded-xl overflow-hidden overflow-x-auto">
                                            <table class="data-table w-full">
                                                <thead>
                                                    <tr>
                                                    <tr>
                                                        <th
                                                            class="px-6 py-4 text-left font-medium text-white uppercase tracking-wider">
                                                            Customer</th>
                                                        <th
                                                            class="px-6 py-4 text-left font-medium text-white uppercase tracking-wider hidden md:table-cell">
                                                            Contact Details</th>
                                                        <th
                                                            class="px-6 py-4 text-left font-medium text-white uppercase tracking-wider hidden lg:table-cell">
                                                            Request Type</th>
                                                        <th
                                                            class="px-6 py-4 text-left font-medium text-white uppercase tracking-wider">
                                                            Status</th>
                                                        <th
                                                            class="px-6 py-4 text-left font-medium text-white uppercase tracking-wider hidden xl:table-cell">
                                                            Received</th>
                                                        <th
                                                            class="px-6 py-4 text-left font-medium text-white uppercase tracking-wider">
                                                            Actions</th>
                                                    </tr>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (leads.length===0) { %>
                                                        <tr>
                                                            <td colspan="6"
                                                                class="px-6 py-10 text-center text-gray-500">
                                                                <div class="flex flex-col items-center">
                                                                    <svg class="w-12 h-12 text-gray-300 mb-4"
                                                                        fill="none" stroke="currentColor"
                                                                        viewBox="0 0 24 24">
                                                                        <path stroke-linecap="round"
                                                                            stroke-linejoin="round" stroke-width="2"
                                                                            d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2z">
                                                                        </path>
                                                                    </svg>
                                                                    <p class="text-lg font-medium">No leads found</p>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <% } else { %>
                                                            <% leads.forEach(lead=> { %>
                                                                <tr class="hover:bg-gray-50 transition-colors">
                                                                    <td class="px-6 py-4 whitespace-nowrap">
                                                                        <div class="font-semibold text-gray-900">
                                                                            <%= lead.name %>
                                                                        </div>
                                                                        <!-- Mobile-only contact info -->
                                                                        <div
                                                                            class="md:hidden text-xs text-gray-500 mt-1">
                                                                            <%= lead.email %><br>
                                                                                <%= lead.leadType %>
                                                                        </div>
                                                                    </td>
                                                                    <td class="px-6 py-4 hidden md:table-cell">
                                                                        <div class="text-sm text-gray-600">
                                                                            <%= lead.email %>
                                                                        </div>
                                                                        <div class="text-sm text-gray-500">
                                                                            <%= lead.phone %>
                                                                        </div>
                                                                    </td>
                                                                    <td class="px-6 py-4 hidden lg:table-cell">
                                                                        <span class="badge badge-type">
                                                                            <%= lead.leadType %>
                                                                        </span>
                                                                    </td>
                                                                    <td class="px-6 py-4 whitespace-nowrap">
                                                                        <span class="badge badge-<%= lead.status %>">
                                                                            <%= lead.status.replace('_', ' '
                                                                                ).toUpperCase() %>
                                                                        </span>
                                                                    </td>
                                                                    <td
                                                                        class="px-6 py-4 text-sm text-gray-500 hidden xl:table-cell">
                                                                        <%= new
                                                                            Date(lead.createdAt).toLocaleDateString() %>
                                                                    </td>
                                                                    <td class="px-6 py-4 whitespace-nowrap">
                                                                        <div class="flex gap-2">
                                                                            <a href="/admin/leads/<%= lead.id %>/edit"
                                                                                class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-lg transition"
                                                                                title="Edit">
                                                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                                                    width="20" height="20"
                                                                                    viewBox="0 0 24 24" fill="none"
                                                                                    stroke="currentColor"
                                                                                    stroke-width="2"
                                                                                    stroke-linecap="round"
                                                                                    stroke-linejoin="round">
                                                                                    <path
                                                                                        d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7">
                                                                                    </path>
                                                                                    <path
                                                                                        d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z">
                                                                                    </path>
                                                                                </svg>
                                                                            </a>
                                                                            <a href="/admin/leads/<%= lead.id %>"
                                                                                class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg transition"
                                                                                title="View Details">
                                                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                                                    <circle cx="12" cy="12" r="3"></circle>
                                                                                </svg>
                                                                            </a>
                                                                            <% if (lead.status !== 'closed_won' && lead.status !== 'closed_lost') { %>
                                                                                <button type="button" onclick="openAssignModal('<%= lead.id %>', '<%= lead.name %>')"
                                                                                    class="p-2 text-green-600 hover:bg-green-50 rounded-lg transition"
                                                                                    title="Assign to Employee">
                                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                                                                        <circle cx="8.5" cy="7" r="4"></circle>
                                                                                        <line x1="20" y1="8" x2="20" y2="14"></line>
                                                                                        <line x1="23" y1="11" x2="17" y2="11"></line>
                                                                                    </svg>
                                                                                </button>
                                                                            <% } %>

                                                                            <form
                                                                                action="/admin/leads/<%= lead.id %>/delete"
                                                                                method="POST"
                                                                                onsubmit="return confirm('Are you sure you want to delete this lead?');"
                                                                                class="inline">
                                                                                <button type="submit"
                                                                                    class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition"
                                                                                    title="Delete">
                                                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                                                        width="20" height="20"
                                                                                        viewBox="0 0 24 24" fill="none"
                                                                                        stroke="currentColor"
                                                                                        stroke-width="2"
                                                                                        stroke-linecap="round"
                                                                                        stroke-linejoin="round">
                                                                                        <polyline points="3 6 5 6 21 6">
                                                                                        </polyline>
                                                                                        <path
                                                                                            d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                                                        </path>
                                                                                    </svg>
                                                                                </button>
                                                                            </form>
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                                <% }) %>
                                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>

                                        <% if (totalPages> 1) { %>
                                            <div class="pagination mt-8 flex justify-center">
                                                <% if (currentPage> 1) { %>
                                                    <a href="/admin/leads?page=<%= currentPage - 1 %>"
                                                        class="px-4 py-2 border rounded-lg mx-1 hover:bg-gray-100 transition">Previous</a>
                                                    <% } %>

                                                        <% for (let i=1; i <=totalPages; i++) { %>
                                                            <a href="/admin/leads?page=<%= i %>"
                                                                class="px-4 py-2 border rounded-lg mx-1 <%= currentPage === i ? 'bg-blue-600 text-white border-blue-600' : 'hover:bg-gray-100' %> transition">
                                                                <%= i %>
                                                            </a>
                                                            <% } %>

                                                                <% if (currentPage < totalPages) { %>
                                                                    <a href="/admin/leads?page=<%= currentPage + 1 %>"
                                                                        class="px-4 py-2 border rounded-lg mx-1 hover:bg-gray-100 transition">Next</a>
                                                                    <% } %>
                                            </div>
                                            <% } %>
                                    </div>
                                </main>
                        </div>

                        <script src="/js/toast.js"></script>

                        <!-- Assignment modal1 -->
                        <div id="assignModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden z-50 overflow-y-auto h-full w-full flex items-center justify-center px-4">
                            <div class="relative mx-auto p-5 border w-full max-w-2xl shadow-lg rounded-md bg-white">
                                <div class="mt-3">
                                    <div class="flex justify-between items-center mb-4">
                                        <h3 class="text-lg leading-6 font-medium text-gray-900" id="modalTitle">Assign Lead</h3>
                                        <button id="closeModalBtn" type="button" class="text-gray-400 hover:text-gray-500">
                                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                            </svg>
                                        </button>
                                    </div>
                                    
                                    <div class="px-2 py-2">
                                        <p class="text-sm text-gray-500 mb-6">Assign <span id="leadNameSpan" class="font-bold text-gray-900"></span> to an employee.</p>
                                        
                                        <form id="assignForm">
                                            <input type="hidden" id="assignLeadId">
                                            <input type="hidden" id="selectedEmployeeId">
                                            
                                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                                                <div>
                                                    <label class="block text-gray-700 text-sm font-bold mb-2" for="assignDate">
                                                        Select Date
                                                    </label>
                                                    <input class="shadow-sm appearance-none border border-gray-300 rounded-lg w-full py-2.5 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" 
                                                        id="assignDate" type="date" required>
                                                </div>

                                                <div>
                                                    <label class="block text-gray-700 text-sm font-bold mb-2" for="assignSlot">
                                                        Select Time Slot
                                                    </label>
                                                    <select class="shadow-sm appearance-none border border-gray-300 rounded-lg w-full py-2.5 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                                        id="assignSlot" required>
                                                        <option value="">Choose a slot...</option>
                                                        <option value="morning">Morning (9 AM - 12 PM)</option>
                                                        <option value="afternoon">Afternoon (1 PM - 5 PM)</option>
                                                        <option value="evening">Evening (5 PM - 8 PM)</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="mb-6">
                                                <div class="flex justify-between items-center mb-2">
                                                    <label class="block text-gray-700 text-sm font-bold">
                                                        Select Employee
                                                    </label>
                                                    <span id="loadingEmployees" class="text-xs text-blue-600 hidden flex items-center gap-1">
                                                        <svg class="animate-spin h-3 w-3 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                                        </svg>
                                                        Checking availability...
                                                    </span>
                                                </div>
                                                
                                                <div id="employeeGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-60 overflow-y-auto p-1">
                                                    <div class="col-span-full text-center py-8 text-gray-400 bg-gray-50 rounded-lg border border-dashed border-gray-300">
                                                        Select a date and time slot to view available employees
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="flex gap-3 pt-4 border-t border-gray-100">
                                                <button id="closeModalBtnFooter" type="button" class="flex-1 px-4 py-2.5 bg-white border border-gray-300 text-gray-700 text-sm font-medium rounded-lg shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-200">
                                                    Cancel
                                                </button>
                                                <button id="assignSubmitBtn" type="submit" disabled class="flex-1 px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed">
                                                    Assign & Approve
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <script>
                            document.addEventListener('DOMContentLoaded', function() {
                                const assignModalEl = document.getElementById('assignModal');
                                const closeBtn = document.getElementById('closeModalBtn');
                                const closeBtnFooter = document.getElementById('closeModalBtnFooter');
                                const dateInput = document.getElementById('assignDate');
                                const slotInput = document.getElementById('assignSlot');
                                const employeeGrid = document.getElementById('employeeGrid');
                                const form = document.getElementById('assignForm');
                                const loadingMsg = document.getElementById('loadingEmployees');
                                const selectedEmployeeInput = document.getElementById('selectedEmployeeId');
                                const submitBtn = document.getElementById('assignSubmitBtn');

                                // Set min date to today
                                const today = new Date().toISOString().split('T')[0];
                                if (dateInput) dateInput.min = today;

                                window.openAssignModal = function(leadId, leadName) {
                                    document.getElementById('assignLeadId').value = leadId;
                                    document.getElementById('leadNameSpan').innerText = leadName;
                                    // Reset form
                                    if (dateInput) dateInput.value = '';
                                    if (slotInput) slotInput.value = '';
                                    if (selectedEmployeeInput) selectedEmployeeInput.value = '';
                                    if (submitBtn) {
                                        submitBtn.disabled = true;
                                        submitBtn.textContent = 'Assign & Approve';
                                    }
                                    if (employeeGrid) employeeGrid.innerHTML = '<div class="col-span-full text-center py-8 text-gray-400 bg-gray-50 rounded-lg border border-dashed border-gray-300">Select a date and time slot to view available employees</div>';
                                    if (assignModalEl) assignModalEl.classList.remove('hidden');
                                }

                                function closeModal() {
                                    if (assignModalEl) assignModalEl.classList.add('hidden');
                                }

                                if (closeBtn) closeBtn.onclick = closeModal;
                                if (closeBtnFooter) closeBtnFooter.onclick = closeModal;

                                window.onclick = function(event) {
                                    if (event.target == assignModalEl) {
                                        closeModal();
                                    }
                                }

                                window.selectEmployee = function(id, name) {
                                    // Deselect all
                                    document.querySelectorAll('.employee-card').forEach(card => {
                                        card.classList.remove('ring-2', 'ring-blue-500', 'bg-blue-50');
                                        card.classList.add('bg-white', 'hover:bg-gray-50');
                                    });
                                    
                                    // Select clicked
                                    const selectedCard = document.getElementById(`emp-card-${id}`);
                                    if (selectedCard) {
                                        selectedCard.classList.remove('bg-white', 'hover:bg-gray-50');
                                        selectedCard.classList.add('ring-2', 'ring-blue-500', 'bg-blue-50');
                                        
                                        selectedEmployeeInput.value = id;
                                        submitBtn.disabled = false;
                                        submitBtn.textContent = `Assign to ${name}`;
                                    }
                                }

                                async function fetchAvailableEmployees() {
                                    const date = dateInput.value;
                                    const slot = slotInput.value;

                                    if (!date || !slot) return;

                                    if (loadingMsg) loadingMsg.classList.remove('hidden');
                                    if (employeeGrid) employeeGrid.innerHTML = '<div class="col-span-full py-8 flex justify-center"><svg class="animate-spin h-6 w-6 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg></div>';
                                    
                                    // Reset selection
                                    selectedEmployeeInput.value = '';
                                    if (submitBtn) {
                                        submitBtn.disabled = true;
                                        submitBtn.textContent = 'Assign & Approve';
                                    }

                                    try {
                                        const response = await fetch(`/admin/available-employees?date=${date}&slot=${slot}`);
                                        const data = await response.json();

                                        if (data.success && data.items.length > 0) {
                                            employeeGrid.innerHTML = '';
                                            data.items.forEach(emp => {
                                                const isAvailable = emp.isAvailable;
                                                const initial = emp.name.charAt(0).toUpperCase();
                                                
                                                const card = document.createElement('div');
                                                card.id = `emp-card-${emp.id}`;
                                                card.className = `employee-card p-3 rounded-lg border border-gray-200 cursor-pointer transition-all duration-200 ${isAvailable ? 'bg-white hover:bg-gray-50 hover:shadow-sm' : 'bg-gray-50 opacity-60 cursor-not-allowed'}`;
                                                
                                                if (isAvailable) {
                                                    // Use the global function
                                                    card.setAttribute('onclick', `selectEmployee('${emp.id}', '${emp.name}')`);
                                                }

                                                card.innerHTML = `
                                                    <div class="flex items-center gap-3">
                                                        <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-white shrink-0 ${isAvailable ? 'bg-blue-600' : 'bg-gray-400'}">
                                                            ${initial}
                                                        </div>
                                                        <div class="flex-1 min-w-0">
                                                            <p class="text-sm font-medium text-gray-900 truncate">${emp.name}</p>
                                                            <p class="text-xs text-gray-500 truncate">${emp.role}</p>
                                                        </div>
                                                        <div class="shrink-0">
                                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium ${isAvailable ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">
                                                                ${isAvailable ? 'Available' : 'Busy'}
                                                            </span>
                                                        </div>
                                                    </div>
                                                `;
                                                employeeGrid.appendChild(card);
                                            });
                                        } else {
                                            employeeGrid.innerHTML = '<div class="col-span-full text-center py-8 text-gray-500">No employees found.</div>';
                                        }
                                    } catch (error) {
                                        console.error('Error fetching employees:', error);
                                        if (employeeGrid) employeeGrid.innerHTML = '<div class="col-span-full text-center py-8 text-red-500">Error loading employees. Please try again.</div>';
                                    } finally {
                                        if (loadingMsg) loadingMsg.classList.add('hidden');
                                    }
                                }

                                if (dateInput) dateInput.addEventListener('change', fetchAvailableEmployees);
                                if (slotInput) slotInput.addEventListener('change', fetchAvailableEmployees);

                                if (form) {
                                    form.addEventListener('submit', async (e) => {
                                        e.preventDefault();
                                        const leadId = document.getElementById('assignLeadId').value;
                                        const employeeId = selectedEmployeeInput.value;
                                        const date = dateInput.value;
                                        const timeSlot = slotInput.value;
                                        
                                        let hour = 9;
                                        if (timeSlot === 'afternoon') hour = 13;
                                        if (timeSlot === 'evening') hour = 18;
                                        
                                        const scheduledDate = new Date(date);
                                        scheduledDate.setHours(hour, 0, 0, 0);

                                        if (!employeeId) {
                                            showToast('Please select an employee', 'error');
                                            return;
                                        }

                                        try {
                                            const response = await fetch(`/admin/leads/${leadId}/assign`, {
                                                method: 'POST',
                                                headers: {
                                                    'Content-Type': 'application/json'
                                                },
                                                body: JSON.stringify({
                                                    employeeId,
                                                    status: 'assigned',
                                                    scheduledDate: scheduledDate.toISOString(),
                                                })
                                            });
                                            
                                            const result = await response.json();

                                            if (result.success) {
                                                showToast('Lead assigned successfully', 'success');
                                                setTimeout(() => window.location.reload(), 1500);
                                            } else {
                                                showToast(result.message || 'Assignment failed', 'error');
                                            }
                                        } catch (error) {
                                            console.error('Assignment error:', error);
                                            showToast('An error occurred', 'error');
                                        }
                                    });
                                }
                            });
                        </script>
</body>

</html>