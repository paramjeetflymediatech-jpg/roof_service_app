<% if (leads.length === 0) { %>
    <tr>
        <td colspan="6" class="px-6 py-10 text-center text-gray-500">
            <div class="flex flex-col items-center">
                <svg class="w-12 h-12 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2z"></path>
                </svg>
                <p class="text-lg font-medium">No leads found</p>
            </div>
        </td>
    </tr>
<% } else { %>
    <% leads.forEach(lead => { %>
        <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap">
                <div class="font-semibold text-gray-900"><%= lead.name %></div>
                <div class="md:hidden text-xs text-gray-500 mt-1">
                    <%= lead.email %><br>
                    <%= lead.leadType %>
                </div>
            </td>
            <td class="px-6 py-4 hidden md:table-cell">
                <div class="text-sm text-gray-600"><%= lead.email %></div>
                <div class="text-sm text-gray-500"><%= lead.phone %></div>
            </td>
            <td class="px-6 py-4 hidden lg:table-cell">
                <span class="badge badge-type"><%= lead.leadType %></span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
                <span class="badge badge-<%= (lead.status || '').toLowerCase() %>">
                    <%= (lead.status || '').replace('_', ' ').toUpperCase() %>
                </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center gap-2">
                    <% if (lead.estimates && lead.estimates.length > 0) { %>
                        <a href="/admin/estimates/<%= lead.estimates[0].id %>/preview" target="_blank" class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center hover:bg-indigo-100 transition" title="View Estimate">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        </a>
                    <% } %>
                    <% if (lead.invoices && lead.invoices.length > 0) { %>
                        <a href="/admin/invoices/<%= lead.invoices[0].id %>/preview" target="_blank" class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center hover:bg-emerald-100 transition" title="View Invoice">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        </a>
                    <% } %>
                </div>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500 hidden xl:table-cell">
                <%= new Date(lead.createdAt).toLocaleDateString() %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex gap-2">
                    <a href="/admin/leads/<%= lead.id %>/edit" class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-lg transition" title="Edit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                        </svg>
                    </a>
                    <a href="/admin/leads/<%= lead.id %>" class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg transition" title="View Details">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </a>
                    <% if (lead.status !== 'closed_won' && lead.status !== 'closed_lost') { %>
                        <button type="button" onclick="openAssignModal('<%= lead.id %>', '<%= lead.name %>')" class="p-2 text-green-600 hover:bg-green-50 rounded-lg transition" title="Assign to Employee">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="8.5" cy="7" r="4"></circle>
                                <line x1="20" y1="8" x2="20" y2="14"></line>
                                <line x1="23" y1="11" x2="17" y2="11"></line>
                            </svg>
                        </button>
                    <% } %>
                    <form action="/admin/leads/<%= lead.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this lead?');" class="inline">
                        <button type="submit" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition" title="Delete">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                        </button>
                    </form>
                </div>
            </td>
        </tr>
    <% }) %>
<% } %>
