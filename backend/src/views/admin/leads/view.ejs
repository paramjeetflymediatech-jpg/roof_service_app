<%- include('../../partials/header') %>

    <body <% if (typeof error !=='undefined' && error && error.length> 0) { %>data-flash-error="<%= error %>"<% } %>
                <% if (typeof success !=='undefined' && success && success.length> 0) { %>data-flash-success="<%=
                        success %>"<% } %>
                            >

                            <!-- Toast Container -->
                            <div id="toast-container"></div>

                            <div class="admin-wrapper">
                                <%- include('../../partials/sidebar') %>

                                    <main class="main-content">
                                        <%- include('../../partials/top-header') %>

                                            <div class="content">
                                                <div class="max-w-4xl mx-auto">
                                                    <!-- Back Button -->
                                                    <div class="mb-6 flex justify-between items-center">
                                                        <a href="/admin/leads"
                                                            class="text-indigo-600 hover:text-indigo-900 flex items-center gap-2">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="20"
                                                                height="20" viewBox="0 0 24 24" fill="none"
                                                                stroke="currentColor" stroke-width="2">
                                                                <line x1="19" y1="12" x2="5" y2="12"></line>
                                                                <polyline points="12 19 5 12 12 5"></polyline>
                                                            </svg>
                                                            Back to Lead List
                                                        </a>

                                                        <div class="flex gap-2">
                                                            <!-- Approve Button -->
                                                            <% if (lead.status==='pending' || lead.status==='new' ||
                                                                lead.status==='quoted' ) { %>
                                                                <form action="/admin/leads/<%= lead.id %>/approve"
                                                                    method="POST"
                                                                    onsubmit="return confirm('Are you sure you want to approve this lead?');">
                                                                    <button type="submit"
                                                                        class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition flex items-center gap-2">
                                                                        <svg xmlns="http://www.w3.org/2000/svg"
                                                                            width="20" height="20" viewBox="0 0 24 24"
                                                                            fill="none" stroke="currentColor"
                                                                            stroke-width="2" stroke-linecap="round"
                                                                            stroke-linejoin="round">
                                                                            <polyline points="20 6 9 17 4 12">
                                                                            </polyline>
                                                                        </svg>
                                                                        Approve Lead
                                                                    </button>
                                                                </form>
                                                                <% } %>

                                                                    <!-- Create Estimate Button -->
                                                                    <a href="/admin/estimates/create?leadId=<%= lead.id %>"
                                                                        class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition flex items-center gap-2">
                                                                        <svg xmlns="http://www.w3.org/2000/svg"
                                                                            width="20" height="20" viewBox="0 0 24 24"
                                                                            fill="none" stroke="currentColor"
                                                                            stroke-width="2" stroke-linecap="round"
                                                                            stroke-linejoin="round">
                                                                            <path
                                                                                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z">
                                                                            </path>
                                                                            <polyline points="14 2 14 8 20 8">
                                                                            </polyline>
                                                                            <line x1="16" y1="13" x2="8" y2="13"></line>
                                                                            <line x1="16" y1="17" x2="8" y2="17"></line>
                                                                            <polyline points="10 9 9 9 8 9"></polyline>
                                                                        </svg>
                                                                        Create Estimate
                                                                    </a>

                                                                    <!-- Generate Invoice Button (for completed leads) -->
                                                                    <% if (lead.status &&
                                                                        lead.status.toLowerCase()==='completed' ) { %>
                                                                        <% if (!lead.invoices ||
                                                                            lead.invoices.length===0) { %>
                                                                            <a href="/admin/invoices/generate-from-lead/<%= lead.id %>"
                                                                                class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition flex items-center gap-2">
                                                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                                                    width="20" height="20"
                                                                                    viewBox="0 0 24 24" fill="none"
                                                                                    stroke="currentColor"
                                                                                    stroke-width="2"
                                                                                    stroke-linecap="round"
                                                                                    stroke-linejoin="round">
                                                                                    <path
                                                                                        d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z">
                                                                                    </path>
                                                                                    <polyline points="14 2 14 8 20 8">
                                                                                    </polyline>
                                                                                    <line x1="16" y1="13" x2="8"
                                                                                        y2="13"></line>
                                                                                    <line x1="16" y1="17" x2="8"
                                                                                        y2="17"></line>
                                                                                    <polyline points="10 9 9 9 8 9">
                                                                                    </polyline>
                                                                                </svg>
                                                                                Generate Invoice
                                                                            </a>
                                                                            <% } else { %>
                                                                                <a href="/admin/invoices/<%= lead.invoices[0].id %>/preview"
                                                                                    class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition flex items-center gap-2">
                                                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                                                        width="20" height="20"
                                                                                        viewBox="0 0 24 24" fill="none"
                                                                                        stroke="currentColor"
                                                                                        stroke-width="2"
                                                                                        stroke-linecap="round"
                                                                                        stroke-linejoin="round">
                                                                                        <path
                                                                                            d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z">
                                                                                        </path>
                                                                                        <circle cx="12" cy="12" r="3">
                                                                                        </circle>
                                                                                    </svg>
                                                                                    View Existing Invoice
                                                                                </a>
                                                                                <% } %>
                                                                                    <% } %>

                                                                                        <!-- Edit Button -->
                                                                                        <a href="/admin/leads/<%= lead.id %>/edit"
                                                                                            class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition flex items-center gap-2">
                                                                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                                                                width="20" height="20"
                                                                                                viewBox="0 0 24 24"
                                                                                                fill="none"
                                                                                                stroke="currentColor"
                                                                                                stroke-width="2"
                                                                                                stroke-linecap="round"
                                                                                                stroke-linejoin="round">
                                                                                                <path
                                                                                                    d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7">
                                                                                                </path>
                                                                                                <path
                                                                                                    d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z">
                                                                                                </path>
                                                                                            </svg>
                                                                                            Edit Details
                                                                                        </a>
                                                        </div>
                                                    </div>

                                                    <!-- Associated Estimates & Invoices (Flow Section) -->
                                                    <% if ((lead.estimates && lead.estimates.length> 0) ||
                                                        (lead.invoices && lead.invoices.length > 0)) { %>
                                                        <div
                                                            class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8 pt-6 border-t border-gray-100">
                                                            <!-- Estimates Column -->
                                                            <% if (lead.estimates && lead.estimates.length> 0) { %>
                                                                <div
                                                                    class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
                                                                    <h3
                                                                        class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4 flex items-center gap-2">
                                                                        <svg xmlns="http://www.w3.org/2000/svg"
                                                                            width="16" height="16" viewBox="0 0 24 24"
                                                                            fill="none" stroke="currentColor"
                                                                            stroke-width="2" stroke-linecap="round"
                                                                            stroke-linejoin="round"
                                                                            class="text-indigo-500">
                                                                            <path
                                                                                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z">
                                                                            </path>
                                                                            <polyline points="14 2 14 8 20 8">
                                                                            </polyline>
                                                                            <line x1="16" y1="13" x2="8" y2="13"></line>
                                                                            <line x1="16" y1="17" x2="8" y2="17"></line>
                                                                            <polyline points="10 9 9 9 8 9"></polyline>
                                                                        </svg>
                                                                        Associated Estimates
                                                                    </h3>
                                                                    <div class="space-y-3">
                                                                        <% lead.estimates.forEach(est=> { %>
                                                                            <div
                                                                                class="flex items-center justify-between p-3 bg-white rounded-xl border border-gray-200 shadow-sm hover:border-indigo-300 transition-all">
                                                                                <div class="flex flex-col">
                                                                                    <span
                                                                                        class="text-sm font-bold text-gray-900">
                                                                                        <%= est.estimateNumber %>
                                                                                    </span>
                                                                                    <span
                                                                                        class="text-[10px] text-gray-400 font-medium uppercase">
                                                                                        <%= est.status %> • $<%=
                                                                                                est.total %>
                                                                                    </span>
                                                                                </div>
                                                                                <a href="/admin/estimates/<%= est.id %>/preview"
                                                                                    class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors">
                                                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                                                        width="18" height="18"
                                                                                        viewBox="0 0 24 24" fill="none"
                                                                                        stroke="currentColor"
                                                                                        stroke-width="2"
                                                                                        stroke-linecap="round"
                                                                                        stroke-linejoin="round">
                                                                                        <path
                                                                                            d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z">
                                                                                        </path>
                                                                                        <circle cx="12" cy="12" r="3">
                                                                                        </circle>
                                                                                    </svg>
                                                                                </a>
                                                                            </div>
                                                                            <% }) %>
                                                                    </div>
                                                                </div>
                                                                <% } %>

                                                                    <!-- Invoices Column -->
                                                                    <% if (lead.invoices && lead.invoices.length> 0) {
                                                                        %>
                                                                        <div
                                                                            class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
                                                                            <h3
                                                                                class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4 flex items-center gap-2">
                                                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                                                    width="16" height="16"
                                                                                    viewBox="0 0 24 24" fill="none"
                                                                                    stroke="currentColor"
                                                                                    stroke-width="2"
                                                                                    stroke-linecap="round"
                                                                                    stroke-linejoin="round"
                                                                                    class="text-emerald-500">
                                                                                    <path
                                                                                        d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z">
                                                                                    </path>
                                                                                    <polyline points="14 2 14 8 20 8">
                                                                                    </polyline>
                                                                                    <line x1="16" y1="13" x2="8"
                                                                                        y2="13"></line>
                                                                                    <line x1="16" y1="17" x2="8"
                                                                                        y2="17"></line>
                                                                                    <polyline points="10 9 9 9 8 9">
                                                                                    </polyline>
                                                                                </svg>
                                                                                Associated Invoices
                                                                            </h3>
                                                                            <div class="space-y-3">
                                                                                <% lead.invoices.forEach(inv=> { %>
                                                                                    <div
                                                                                        class="flex items-center justify-between p-3 bg-white rounded-xl border border-gray-200 shadow-sm hover:border-emerald-300 transition-all">
                                                                                        <div class="flex flex-col">
                                                                                            <span
                                                                                                class="text-sm font-bold text-gray-900">
                                                                                                <%= inv.invoiceNumber %>
                                                                                            </span>
                                                                                            <span
                                                                                                class="text-[10px] text-gray-400 font-medium uppercase font-bold text-emerald-600">Generated</span>
                                                                                        </div>
                                                                                        <a href="/admin/invoices/<%= inv.id %>/preview"
                                                                                            class="p-2 text-emerald-600 hover:bg-emerald-50 rounded-lg transition-colors">
                                                                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                                                                width="18" height="18"
                                                                                                viewBox="0 0 24 24"
                                                                                                fill="none"
                                                                                                stroke="currentColor"
                                                                                                stroke-width="2"
                                                                                                stroke-linecap="round"
                                                                                                stroke-linejoin="round">
                                                                                                <path
                                                                                                    d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z">
                                                                                                </path>
                                                                                                <circle cx="12" cy="12"
                                                                                                    r="3"></circle>
                                                                                            </svg>
                                                                                        </a>
                                                                                    </div>
                                                                                    <% }) %>
                                                                            </div>
                                                                        </div>
                                                                        <% } %>
                                                        </div>
                                                        <% } %>

                                                            <!-- Lead Details Card -->
                                                            <div class="bg-white rounded-lg shadow-md overflow-hidden">
                                                                <!-- Header -->
                                                                <div
                                                                    class="px-8 py-6 border-b border-gray-100 flex justify-between items-start bg-gray-50">
                                                                    <div>
                                                                        <h2 class="text-2xl font-bold text-gray-900">
                                                                            <%= lead.name %>
                                                                        </h2>
                                                                        <p class="text-sm text-gray-500 mt-1">Submitted
                                                                            on <%= new
                                                                                Date(lead.createdAt).toLocaleDateString()
                                                                                %> at <%= new
                                                                                    Date(lead.createdAt).toLocaleTimeString()
                                                                                    %>
                                                                        </p>
                                                                    </div>
                                                                    <span class="px-3 py-1 rounded-full text-sm font-medium
                                <%= lead.status === 'pending' ? 'bg-blue-100 text-blue-800' :
                                   lead.status === 'in_progress' ? 'bg-yellow-100 text-yellow-800' :
                                   lead.status === 'quoted' ? 'bg-purple-100 text-purple-800' :
                                   lead.status === 'approved' ? 'bg-green-100 text-green-800' :
                                   lead.status === 'completed' ? 'bg-green-800 text-white' :
                                   'bg-gray-100 text-gray-800' %>">
                                                                        <%= lead.status.replace('_', ' ' ).toUpperCase()
                                                                            %>
                                                                    </span>
                                                                </div>

                                                                <div class="p-8 space-y-8">
                                                                    <!-- Contact Information -->
                                                                    <section>
                                                                        <h3
                                                                            class="text-lg font-semibold text-gray-900 mb-4 border-b pb-2">
                                                                            Contact Information</h3>
                                                                        <div
                                                                            class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                                                            <div>
                                                                                <p class="text-sm text-gray-500">Email
                                                                                </p>
                                                                                <p class="font-medium text-gray-900"><a
                                                                                        href="mailto:<%= lead.email %>"
                                                                                        class="text-indigo-600 hover:underline">
                                                                                        <%= lead.email %>
                                                                                    </a></p>
                                                                            </div>
                                                                            <div>
                                                                                <p class="text-sm text-gray-500">Phone
                                                                                </p>
                                                                                <p class="font-medium text-gray-900"><a
                                                                                        href="tel:<%= lead.phone %>"
                                                                                        class="text-indigo-600 hover:underline">
                                                                                        <%= lead.phone %>
                                                                                    </a></p>
                                                                            </div>
                                                                            <div class="md:col-span-2">
                                                                                <p class="text-sm text-gray-500">Address
                                                                                </p>
                                                                                <p class="font-medium text-gray-900">
                                                                                    <% if (lead.address) { %>
                                                                                        <%= lead.address %>
                                                                                            <%= lead.city ? ', ' +
                                                                                                lead.city : '' %>
                                                                                                <% } else { %>
                                                                                                    <span
                                                                                                        class="text-gray-400 italic">Not
                                                                                                        provided</span>
                                                                                                    <% } %>
                                                                                </p>
                                                                            </div>
                                                                        </div>
                                                                    </section>

                                                                    <!-- Service Details -->
                                                                    <section>
                                                                        <h3
                                                                            class="text-lg font-semibold text-gray-900 mb-4 border-b pb-2">
                                                                            Service Request Details</h3>
                                                                        <div
                                                                            class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                                                            <div>
                                                                                <p class="text-sm text-gray-500">Service
                                                                                    Type</p>
                                                                                <p class="font-medium text-gray-900">
                                                                                    <%= lead.serviceType
                                                                                        || 'Not specified' %>
                                                                                </p>
                                                                            </div>
                                                                            <div>
                                                                                <p class="text-sm text-gray-500">
                                                                                    Preferred Date</p>
                                                                                <p class="font-medium text-gray-900">
                                                                                    <%= lead.preferredDate ? new
                                                                                        Date(lead.preferredDate).toLocaleDateString()
                                                                                        : 'Not specified' %>
                                                                                </p>
                                                                            </div>
                                                                            <div>
                                                                                <p class="text-sm text-gray-500">Lead
                                                                                    Type</p>
                                                                                <p
                                                                                    class="font-medium text-gray-900 uppercase">
                                                                                    <%= lead.leadType || 'General' %>
                                                                                </p>
                                                                            </div>
                                                                            <div class="md:col-span-2">
                                                                                <p class="text-sm text-gray-500">Message
                                                                                    / Notes</p>
                                                                                <div
                                                                                    class="mt-1 p-4 bg-gray-50 rounded-lg border border-gray-100 text-gray-700 whitespace-pre-wrap">
                                                                                    <%= lead.message
                                                                                        || 'No message provided.' %>
                                                                                </div>
                                                                            </div>
                                                                            <% if (lead.assignedTo) { %>
                                                                                <div
                                                                                    class="md:col-span-2 mt-4 p-4 bg-blue-50 rounded-lg border border-blue-100">
                                                                                    <p
                                                                                        class="text-sm text-blue-500 font-semibold mb-2">
                                                                                        Assigned Employee</p>
                                                                                    <div
                                                                                        class="flex items-center gap-3">
                                                                                        <div
                                                                                            class="w-10 h-10 rounded-full bg-blue-200 flex items-center justify-center text-blue-700 font-bold">
                                                                                            <%= lead.assignedTo.name.charAt(0).toUpperCase()
                                                                                                %>
                                                                                        </div>
                                                                                        <div>
                                                                                            <p
                                                                                                class="font-medium text-blue-900">
                                                                                                <%= lead.assignedTo.name
                                                                                                    %>
                                                                                            </p>
                                                                                            <p
                                                                                                class="text-sm text-blue-700">
                                                                                                <%= lead.assignedTo.email
                                                                                                    %> | <%=
                                                                                                        lead.assignedTo.phone
                                                                                                        %>
                                                                                            </p>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                                <% } %>
                                                                        </div>
                                                                    </section>

                                                                    <!-- Images -->
                                                                    <% if (lead.clientImages && (typeof
                                                                        lead.clientImages==='string' ?
                                                                        JSON.parse(lead.clientImages).length> 0 :
                                                                        lead.clientImages.length > 0)) { %>
                                                                        <section>
                                                                            <h3
                                                                                class="text-lg font-semibold text-gray-900 mb-4 border-b pb-2">
                                                                                Attached Images</h3>
                                                                            <div
                                                                                class="grid grid-cols-2 md:grid-cols-4 gap-4">
                                                                                <% let images=[]; try { if (typeof
                                                                                    lead.clientImages==='string' ) {
                                                                                    images=JSON.parse(lead.clientImages);
                                                                                    } else if
                                                                                    (Array.isArray(lead.clientImages)) {
                                                                                    images=lead.clientImages; } }
                                                                                    catch(e) { images=[] } %>
                                                                                    <% images.forEach(img=> { %>
                                                                                        <div
                                                                                            class="relative group aspect-square">
                                                                                            <img src="<%= img.url.startsWith('http') ? img.url : process.env.BACKEND_URL + '/' + img.url %>"
                                                                                                alt="Client Image"
                                                                                                class="w-full h-full object-cover rounded-lg border border-gray-200 shadow-sm transition-transform duration-300 hover:scale-[1.02]">
                                                                                            <a href="<%= img.url.startsWith('http') ? img.url : process.env.BACKEND_URL + '/' + img.url %>"
                                                                                                target="_blank"
                                                                                                class="absolute inset-0 bg-black bg-opacity-40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity rounded-lg">
                                                                                                <svg class="w-8 h-8 text-white drop-shadow-lg"
                                                                                                    fill="none"
                                                                                                    stroke="currentColor"
                                                                                                    viewBox="0 0 24 24">
                                                                                                    <path
                                                                                                        stroke-linecap="round"
                                                                                                        stroke-linejoin="round"
                                                                                                        stroke-width="2"
                                                                                                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z">
                                                                                                    </path>
                                                                                                    <path
                                                                                                        stroke-linecap="round"
                                                                                                        stroke-linejoin="round"
                                                                                                        stroke-width="2"
                                                                                                        d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z">
                                                                                                    </path>
                                                                                                </svg>
                                                                                            </a>
                                                                                        </div>
                                                                                        <% }); %>
                                                                            </div>
                                                                        </section>
                                                                        <% } %>

                                                                            <!-- Employee Work Details -->
                                                                            <% if (lead.status==='completed' ||
                                                                                lead.status==='in_progress' ||
                                                                                lead.employeeNotes ||
                                                                                (lead.completionImages && (typeof
                                                                                lead.completionImages==='string' ?
                                                                                JSON.parse(lead.completionImages).length>
                                                                                0 : lead.completionImages.length > 0)))
                                                                                { %>
                                                                                <section
                                                                                    class="pt-6 border-t border-gray-100">
                                                                                    <h3
                                                                                        class="text-lg font-semibold text-gray-900 mb-4 pb-2 border-b">
                                                                                        Work Completion Details</h3>
                                                                                    <div
                                                                                        class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                                                                        <% if (lead.inTime ||
                                                                                            lead.outTime ||
                                                                                            lead.employeeStartTime ||
                                                                                            lead.employeeEndTime) { %>
                                                                                            <div>
                                                                                                <p
                                                                                                    class="text-sm text-gray-500">
                                                                                                    Work Hours</p>
                                                                                                <div
                                                                                                    class="flex flex-col gap-2 mt-1">
                                                                                                    <% if (lead.inTime)
                                                                                                        { %>
                                                                                                        <span
                                                                                                            class="px-2 py-1 bg-green-50 text-green-700 rounded text-sm font-medium border border-green-100 w-fit">
                                                                                                            Start: <%=
                                                                                                                new
                                                                                                                Date(lead.inTime).toLocaleString('en-US',
                                                                                                                {
                                                                                                                month: 'short'
                                                                                                                ,
                                                                                                                day: 'numeric'
                                                                                                                ,
                                                                                                                year: 'numeric'
                                                                                                                ,
                                                                                                                hour: 'numeric'
                                                                                                                ,
                                                                                                                minute: 'numeric'
                                                                                                                ,
                                                                                                                hour12:
                                                                                                                true })
                                                                                                                %>
                                                                                                        </span>
                                                                                                        <% } else if
                                                                                                            (lead.employeeStartTime)
                                                                                                            { %>
                                                                                                            <span
                                                                                                                class="px-2 py-1 bg-green-50 text-green-700 rounded text-sm font-medium border border-green-100 w-fit">
                                                                                                                Start:
                                                                                                                <%= lead.employeeStartTime
                                                                                                                    %>
                                                                                                            </span>
                                                                                                            <% } %>

                                                                                                                <% if
                                                                                                                    (lead.outTime)
                                                                                                                    { %>
                                                                                                                    <span
                                                                                                                        class="px-2 py-1 bg-blue-50 text-blue-700 rounded text-sm font-medium border border-blue-100 w-fit">
                                                                                                                        End:
                                                                                                                        <%= new
                                                                                                                            Date(lead.outTime).toLocaleString('en-US',
                                                                                                                            {
                                                                                                                            month: 'short'
                                                                                                                            ,
                                                                                                                            day: 'numeric'
                                                                                                                            ,
                                                                                                                            year: 'numeric'
                                                                                                                            ,
                                                                                                                            hour: 'numeric'
                                                                                                                            ,
