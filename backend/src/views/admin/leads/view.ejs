                            <!-- Assignment F -->


                            <script src="/js/toast.js"></script>
                            <script>
                                const modal = document.getElementById('assignModal');
                                const closeBtn = document.getElementById('closeModalBtn');
                                const closeBtnFooter = document.getElementById('closeModalBtnFooter');
                                const dateInput = document.getElementById('assignDate');
                                const slotInput = document.getElementById('assignSlot');
                                const employeeGrid = document.getElementById('employeeGrid');
                                const form = document.getElementById('assignForm');
                                const loadingMsg = document.getElementById('loadingEmployees');
                                const selectedEmployeeInput = document.getElementById('selectedEmployeeId');
                                const submitBtn = document.getElementById('assignSubmitBtn');

                                // Set min date to today
                                const today = new Date().toISOString().split('T')[0];
                                dateInput.min = today;

                                function openAssignModal(leadId, leadName) {
                                    document.getElementById('assignLeadId').value = leadId;
                                    document.getElementById('leadNameSpan').innerText = leadName;
                                    // Reset form
                                    dateInput.value = '';
                                    slotInput.value = '';
                                    selectedEmployeeInput.value = '';
                                    submitBtn.disabled = true;
                                    employeeGrid.innerHTML = '<div class="col-span-full text-center py-8 text-gray-400 bg-gray-50 rounded-lg border border-dashed border-gray-300">Select a date and time slot to view available employees</div>';
                                    modal.classList.remove('hidden');
                                }

                                function closeModal() {
                                    modal.classList.add('hidden');
                                }

                                closeBtn.onclick = closeModal;
                                closeBtnFooter.onclick = closeModal;

                                window.onclick = function (event) {
                                    if (event.target == modal) {
                                        closeModal();
                                    }
                                }

                                function selectEmployee(id, name) {
                                    // Deselect all
                                    document.querySelectorAll('.employee-card').forEach(card => {
                                        card.classList.remove('ring-2', 'ring-blue-500', 'bg-blue-50');
                                        card.classList.add('bg-white', 'hover:bg-gray-50');
                                    });

                                    // Select clicked
                                    const selectedCard = document.getElementById(`emp-card-${id}`);
                                    if (selectedCard) {
                                        selectedCard.classList.remove('bg-white', 'hover:bg-gray-50');
                                        selectedCard.classList.add('ring-2', 'ring-blue-500', 'bg-blue-50');

                                        selectedEmployeeInput.value = id;
                                        submitBtn.disabled = false;
                                        submitBtn.textContent = `Assign to ${name}`;
                                    }
                                }

                                async function fetchAvailableEmployees() {
                                    const date = dateInput.value;
                                    const slot = slotInput.value;

                                    if (!date || !slot) return;

                                    loadingMsg.classList.remove('hidden');
                                    employeeGrid.innerHTML = '<div class="col-span-full py-8 flex justify-center"><svg class="animate-spin h-6 w-6 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg></div>';

                                    // Reset selection
                                    selectedEmployeeInput.value = '';
                                    submitBtn.disabled = true;
                                    submitBtn.textContent = 'Assign & Approve';

                                    try {
                                        const response = await fetch(`/admin/available-employees?date=${date}&slot=${slot}`);
                                        const data = await response.json();

                                        if (data.success && data.items.length > 0) {
                                            employeeGrid.innerHTML = '';
                                            data.items.forEach(emp => {
                                                const isAvailable = emp.isAvailable;
                                                const initial = emp.name.charAt(0).toUpperCase();

                                                const card = document.createElement('div');
                                                card.id = `emp-card-${emp.id}`;
                                                card.className = `employee-card p-3 rounded-lg border border-gray-200 cursor-pointer transition-all duration-200 ${isAvailable ? 'bg-white hover:bg-gray-50 hover:shadow-sm' : 'bg-gray-50 opacity-60 cursor-not-allowed'}`;

                                                if (isAvailable) {
                                                    card.onclick = () => selectEmployee(emp.id, emp.name);
                                                }

                                                card.innerHTML = `
                                                <div class="md:flex sm:display-grid  items-center gap-3">
                                                    <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-white shrink-0 ${isAvailable ? 'bg-blue-600' : 'bg-gray-400'}">
                                                        ${initial}
                                                    </div>
                                                    <div class="flex-1 min-w-0">
                                                        <p class="text-sm font-medium text-gray-900 truncate">${emp.name}</p>
                                                        <p class="text-xs text-gray-500 truncate">
                                                            ${emp.email}
                                                            </p>
                                                    </div>
                                                    <div class="shrink-0">
                                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium ${isAvailable ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">
                                                            ${isAvailable ? 'Available' : 'Busy'}
                                                        </span>
                                                    </div>
                                                </div>
                                            `;
                                                employeeGrid.appendChild(card);
                                            });
                                        } else {
                                            employeeGrid.innerHTML = '<div class="col-span-full text-center py-8 text-gray-500">No employees found.</div>';
                                        }
                                    } catch (error) {
                                        console.error('Error fetching employees:', error);
                                        employeeGrid.innerHTML = '<div class="col-span-full text-center py-8 text-red-500">Error loading employees. Please try again.</div>';
                                    } finally {
                                        loadingMsg.classList.add('hidden');
                                    }
                                }

                                dateInput.addEventListener('change', fetchAvailableEmployees);
                                slotInput.addEventListener('change', fetchAvailableEmployees);

                                form.addEventListener('submit', async (e) => {
                                    e.preventDefault();
                                    const leadId = document.getElementById('assignLeadId').value;
                                    const employeeId = selectedEmployeeInput.value;
                                    const date = dateInput.value;
                                    const timeSlot = slotInput.value;

                                    let hour = 9;
                                    if (timeSlot === 'afternoon') hour = 13;
                                    if (timeSlot === 'evening') hour = 18;

                                    const scheduledDate = new Date(date); 
                                    scheduledDate.setHours(hour, 0, 0, 0); 
                                    if (!employeeId) {
                                        showToast('Please select an employee', 'error');
                                        return;
                                    }

                                    try {
                                        const response = await fetch(`/admin/leads/${leadId}/assign`, {
                                            method: 'POST',
                                            headers: {
                                                'Content-Type': 'application/json'
                                            },
                                            body: JSON.stringify({
                                                employeeId,
                                                status: 'assigned',
                                                scheduledDate: scheduledDate.toISOString(),
                                                timeSlot,
                                            })
                                        });

                                        const result = await response.json();

                                        if (result.success) {
                                            showToast('Lead assigned successfully', 'success');
                                            setTimeout(() => window.location.reload(), 1500);
                                        } else {
                                            showToast(result.message || 'Assignment failed', 'error');
                                        }
                                    } catch (error) {
                                        console.error('Assignment error:', error);
                                        showToast('An error occurred', 'error');
                                    }
                                });
                            </script>


