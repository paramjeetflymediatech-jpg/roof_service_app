<% if (leads.length === 0) { %>
    <div class="text-center py-8 bg-white rounded-lg border border-gray-200 text-gray-500">
        <div class="flex flex-col items-center">
            <svg class="w-12 h-12 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2z"></path>
            </svg>
            <p class="text-lg font-medium">No leads found</p>
        </div>
    </div>
<% } else { %>
    <% leads.forEach(lead => { %>
        <div class="bg-white rounded-lg shadow border border-gray-200 p-4">
            <div class="flex justify-between items-start mb-3">
                <div>
                    <h3 class="font-semibold text-gray-900 truncate" title="<%= lead.name %>"><%= lead.name %></h3>
                    <div class="text-sm text-gray-500 mt-0.5"><%= lead.email %></div>
                    <div class="text-xs text-gray-400"><%= lead.phone %></div>
                </div>
                <span class="badge badge-<%= lead.status %> text-xs px-2 py-0.5 rounded-full">
                    <%= lead.status.replace('_', ' ').toUpperCase() %>
                </span>
            </div>

            <div class="flex items-center justify-between text-sm text-gray-500 mb-4 bg-gray-50 p-2 rounded">
                <span class="badge badge-type text-xs px-2 py-1 rounded">
                    <%= lead.leadType %>
                </span>
                <span class="text-xs">
                    <%= new Date(lead.createdAt).toLocaleDateString("en-GB") %>
                </span>
            </div>

            <div class="flex gap-2 pt-2 border-t border-gray-100">
                <a href="/admin/leads/<%= lead.id %>/edit" class="flex-1 text-center py-2 bg-indigo-50 text-indigo-700 rounded hover:bg-indigo-100 transition text-sm font-medium flex items-center justify-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                    Edit
                </a>
                <a href="/admin/leads/<%= lead.id %>" class="flex-1 text-center py-2 bg-blue-50 text-blue-700 rounded hover:bg-blue-100 transition text-sm font-medium flex items-center justify-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    View
                </a>
                <form action="/admin/leads/<%= lead.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this lead?');" class="flex-1">
                    <button type="submit" class="w-full py-2 bg-red-50 text-red-700 rounded hover:bg-red-100 transition text-sm font-medium flex items-center justify-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                        Delete
                    </button>
                </form>
            </div>
        </div>
    <% }) %>
<% } %>
