<% if (categories && categories.length > 0) { %>
    <% categories.forEach(category => { %>
        <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100">
            <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center text-blue-600">
                        <i class="fas <%= category.icon || 'fa-folder' %>"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-gray-900"><%= category.name %></h3>
                        <p class="text-xs text-gray-500"><%= category.slug %></p>
                    </div>
                </div>
                <div class="flex gap-2">
                    <a href="/admin/categories/<%= category.id %>/edit" class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg transition" title="Edit">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-5M18.364 5.636l-3.536 3.536m0 0l-1.06-1.06m1.06 1.06l3.536-3.536a2.121 2.121 0 013 3l-3.536 3.536m-5.656-5.656l1.06 1.06m0 0L15.536 12"></path></svg>
                    </a>
                    <form action="/admin/categories/<%= category.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this category?')">
                        <button type="submit" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition" title="Delete">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        </button>
                    </form>
                </div>
            </div>
            <div class="flex gap-4 text-sm text-gray-600">
                <div>
                    <span class="text-gray-400">Services:</span> <span class="font-medium"><%= category.services ? category.services.length : 0 %></span>
                </div>
            </div>
        </div>
    <% }) %>
<% } else { %>
    <div class="col-span-full py-12 text-center bg-white rounded-xl border border-dashed border-gray-300">
        <p class="text-gray-500">No categories found matching your criteria.</p>
    </div>
<% } %>
