<!-- Lightbox Modal -->
<div id="lightboxModal" class="fixed inset-0 z-[9999] hidden flex items-center justify-center bg-black bg-opacity-90 transition-opacity duration-300">
    <button id="closeLightbox" class="absolute top-6 right-6 text-white text-4xl hover:text-gray-300 transition-colors focus:outline-none">
        &times;
    </button>
    <div class="max-w-[90vw] max-h-[90vh] flex items-center justify-center p-4">
        <img id="lightboxImage" src="" alt="Full size" class="max-w-full max-h-[85vh] object-contain rounded-lg shadow-2xl scale-95 transition-transform duration-300">
    </div>
</div>

<style>
    #lightboxModal.active {
        display: flex;
    }
    #lightboxModal.active #lightboxImage {
        transform: scale(1);
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const modal = document.getElementById('lightboxModal');
        const lightboxImg = document.getElementById('lightboxImage');
        const closeBtn = document.getElementById('closeLightbox');

        window.openLightbox = function(url) {
            if (!url) return;
            lightboxImg.src = url;
            modal.classList.remove('hidden');
            setTimeout(() => modal.classList.add('active'), 10);
            document.body.style.overflow = 'hidden';
        };

        function closeLightbox() {
            modal.classList.remove('active');
            setTimeout(() => {
                modal.classList.add('hidden');
                lightboxImg.src = '';
            }, 300);
            document.body.style.overflow = '';
        }

        if (closeBtn) closeBtn.onclick = closeLightbox;
        
        if (modal) {
            modal.onclick = function(e) {
                if (e.target === modal) closeLightbox();
            };
        }

        // Add Escape key listener
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
                closeLightbox();
            }
        });
    });
</script>
