# Environment Configuration for Roof Service App

# Copy this file to .env and configure for your environment

# API Configuration
# For production (physical devices):
API_BASE_URL=https://api.mainstreet-roofing.ca/api
SERVER_URL=https://api.mainstreet-roofing.ca

# For local development (testing on same network):
# Find your computer's IP using 'ipconfig' (look for IPv4 Address)
# Then uncomment and update these lines:
# API_BASE_URL=http://YOUR_LOCAL_IP:5000/api
# SERVER_URL=http://YOUR_LOCAL_IP:5000

# For Android emulator (development):
# API_BASE_URL=http://10.0.2.2:5000/api
# SERVER_URL=http://10.0.2.2:5000
